# Rust
/rust/target/
**/*.rs.bk
# Kotlin / Gradle
/kotlin/.gradle/
/kotlin/build/
/kotlin/codegen/emitted/
/kotlin/*/build/
/kotlin/.gradle-home/
.gradle-home/
# Kotlin
#
# The module builds with `kotlinc` directly for now, which writes wherever it
# is told rather than into a build directory a build system would already
# ignore. 59 class files and a 4.7 MB jar reached a commit before this existed.
/kotlin/out/
/kotlin/testout/
/kotlin/testout.jar
/kotlin/build/
/kotlin/codegen/emitted/

# Swift
/swift/.build/
/swift/Package.resolved
/swift/*.xcodeproj
# Nix
.direnv/
result
result-*
# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Examples build output
/examples/rust/target/
/examples/swift-examples/.build/
/examples/swift-examples/Package.resolved

# Rendered locally by `nix run .#docs`. The published site is built by GitHub
# Pages from docs/ itself, so this directory is a preview artifact only.
/docs/_site/
.jekyll-cache/

# docs/ is GENERATED from spec/ by tools/docs and is not committed. GitHub
# Pages builds it in CI (.github/workflows/pages.yml) and publishes the
# artifact, so the repository never holds a second copy of normative text that
# someone has to remember to regenerate.
/docs/
