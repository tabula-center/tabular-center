#!/usr/bin/env bash
# The Kotlin steps of what "green" means, run directly, by the root
# tools/verify, or by this directory's flake. Runs from the repository root.
# kotlinc compiles the library, examples and fixtures; Gradle runs only the KSP,
# Compose and publication steps, against the offline Maven repository.
#
# Usage:  tabular-center-kotlin/tools/verify [step ...]   (default: every step)
#         tabular-center-kotlin/tools/verify --list
# Steps:  kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen
#         kotlin-examples kotlin-ksp kotlin-ksp-compile-fail
#         kotlin-ksp-incremental kotlin-matrix-stable kotlin-compose
#         kotlin-publication (+ kotlin-render)
#
# Steps are declared once, in the arrays below; `--list` prints them for the
# root. Each step's output is teed into one ledger, every skip is reprinted
# before the verdict, and failed steps are named again at the end. Why each
# step is built as it is: ARCHITECTURE.md 16, "The checks, step by step".
set -uo pipefail

cd "$(dirname "$0")/../.." || exit 1

fail=0
failed_steps=()

require_dir() {
    [ -d "$1" ] && return 0
    echo "missing directory: $1"
    echo
    echo "  If this is a nix build and the directory exists in your working"
    echo "  tree, it is probably untracked: nix excludes untracked files from a"
    echo "  dirty tree. Commit it, or 'git add -A', or apply patches with"
    echo "  'git am' rather than 'git apply'."
    return 1
}

RENDERINGS="grid mmd lint cov"

require_fixtures() {
    local missing="" tbl name
    for tbl in spec/conformance/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        [ -f "spec/conformance/traces/$name.trace" ] \
            || missing="$missing traces/$name.trace"
    done
    if [ -z "$(echo spec/conformance/*.tbl)" ] || [ ! -e spec/conformance/timer.tbl ]; then
        echo "spec/conformance has no fixtures; the contract has evaporated"
        return 1
    fi
    [ -z "$missing" ] && return 0

    echo "fixture(s) missing a trace:"
    for f in $missing; do echo "  $f"; done
    echo
    echo '  .tbl and .trace are authored by hand: they are the contract.'
    echo "  If they exist in your working tree, they are probably untracked --"
    echo "  nix excludes untracked files from a dirty tree, so 'git apply'"
    echo "  leaves new files out of the build. 'git add -A', or use 'git am'."
    return 1
}

offline() { [ -n "${TABULAR_CENTER_OFFLINE:-}" ]; }

TALLY="$(mktemp)"
trap 'rm -f "$TALLY"' EXIT

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    "$@" 2>&1 | tee -a "$TALLY"
    local rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] && return 0
    echo "FAILED: $name"
    failed_steps+=("$name")
    fail=1
}

KOTLINC="${KOTLINC:-kotlinc}"

kotlin_available() { command -v "$KOTLINC" >/dev/null 2>&1; }

kotlin_version_note() {
    local want have
    want="$(sed -n 's|.*kotlin("jvm") version "\([^"]*\)".*|\1|p' \
        tabular-center-kotlin/examples/06-generated/build.gradle.kts 2>/dev/null | head -1)"
    have="$("$KOTLINC" -version 2>&1 | grep -oE 'kotlinc-jvm [0-9][0-9A-Za-z.-]*' \
        | awk '{print $2}' | head -1)"
    [ -n "$want" ] && [ -n "$have" ] || return 0
    if [ "$want" != "$have" ]; then
        echo "note: kotlinc is $have; the tree is written for $want."
        echo "      Fixtures below match kotlinc's own wording, which can change"
        echo "      between releases. 'nix develop .#kotlin' has the pinned one."
    fi
}

kotlin_cp() { echo "$1/core:$1/annotations:$1/testing"; }

kotlin_artifacts() {
    local out="$1"
    "$KOTLINC" core/center/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
    [ -d "$out/core" ] || { echo "tabular-center-core failed to compile"; return 1; }

    "$KOTLINC" annotations/center/tabula/*.kt -d "$out/annotations" 2>&1 | grep -v "^info:" || true
    [ -d "$out/annotations" ] || { echo "tabular-center-annotations failed to compile"; return 1; }

    "$KOTLINC" -cp "$out/core" testing/center/tabula/testing/*.kt -d "$out/testing" 2>&1 \
        | grep -v "^info:" || true
    [ -d "$out/testing" ] || { echo "tabular-center-testing failed to compile"; return 1; }

    return 0
}

step_kotlin() {
    if ! kotlin_available; then
        echo "skip kotlin (\$KOTLINC not found; set KOTLINC= to point at one)"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        require_dir tabular-center-kotlin || exit 1
        cd tabular-center-kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        "$KOTLINC" -cp "$KCP" test/*.kt -include-runtime -d "$out/t.jar" 2>&1             | grep -v "^info:" || true
        [ -f "$out/t.jar" ] || { echo "tests failed to compile"; exit 1; }
        java -cp "$out/t.jar:$KCP" harness.MainKt
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_conformance() {
    if ! kotlin_available; then
        echo "skip kotlin-conformance (\$KOTLINC not found)"
        return 0
    fi
    require_fixtures || return 1
    local out
    out="$(mktemp -d)"
    (
        require_dir tabular-center-kotlin || exit 1
        cd tabular-center-kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        "$KOTLINC" -cp "$KCP" test/Composition.kt -d "$out/comp" 2>&1 \
            | grep -v "^info:" || true
        [ -d "$out/comp" ] || { echo "composition failed to compile"; exit 1; }
        "$KOTLINC" -cp "$KCP:$out/comp" conformance/*.kt -include-runtime \
            -d "$out/c.jar" 2>&1 | grep -v "^info:" || true
        [ -f "$out/c.jar" ] || { echo "conformance failed to compile"; exit 1; }
        java -cp "$out/c.jar:$KCP:$out/comp" conformance.MainKt ../spec/conformance
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_examples() {
    if ! kotlin_available; then
        echo "skip kotlin-examples (\$KOTLINC not found)"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        require_dir tabular-center-kotlin || exit 1
        cd tabular-center-kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        cd examples || exit 1

        "$KOTLINC" harness/Check.kt -d "$out/harness" 2>&1 | grep -v "^info:" || true
        [ -d "$out/harness" ] || { echo "the example harness failed to compile"; exit 1; }

        ex() {
            local dir="$1" main="$2" label="$3" cp="$4"
            "$KOTLINC" -cp "$cp" "$dir"/src/*.kt -d "$out/$dir" 2>&1 \
                | grep -v "^info:" || true
            [ -d "$out/$dir" ] || { echo "$label failed to compile"; return 1; }
            "$KOTLINC" -cp "$cp:$out/$dir:$out/harness" "$dir"/test/*.kt \
                -include-runtime -d "$out/$dir-test.jar" 2>&1 | grep -v "^info:" || true
            [ -f "$out/$dir-test.jar" ] || { echo "$label tests failed to compile"; return 1; }
            java -cp "$out/$dir-test.jar:$out/$dir:$out/harness:$cp" "$main" || return 1
        }

        ex 01-traffic-light TrafficLightTestKt "traffic-light" "$out/core" || exit 1
        ex 02-timer         TimerTestKt        "timer"         "$KCP"       || exit 1
        ex 03-retry         RetryTestKt        "retry"         "$KCP"       || exit 1
        ex 04-login         LoginTestKt        "login"         "$KCP"       || exit 1
        ex 05-suspend       SuspendTestKt      "suspend"       "$out/core"  || exit 1

    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_ksp_incremental() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp-incremental (\$gradle not found)"
        return 0
    fi
    if [ -z "${TABULAR_CENTER_MAVEN_REPO:-}" ] && offline; then
        echo "skip kotlin-ksp-incremental (no locked artifact set; run"
        echo "     'nix run .#gradle-lock' with network and commit it)"
        return 0
    fi
    require_dir tabular-center-kotlin/examples/06-generated || return 1

    local scratch rc bad=0 gen
    scratch="$(mktemp -d)"
    cp -r tabular-center-kotlin "$scratch/tabular-center-kotlin"
    cp VERSION "$scratch/VERSION"
    chmod -R u+w "$scratch"

    local ex="$scratch/tabular-center-kotlin/examples/06-generated"

    local first
    first="$( (cd "$ex" && gradle_run --no-daemon --console=plain build 2>&1) )"
    if [ $? -ne 0 ]; then
        echo "FAIL the first build failed, before any edit was made."
        echo "     If kotlin-ksp passed, this is about the scratch copy's"
        echo "     layout. If kotlin-ksp failed too, it is the example, and"
        echo "     that check has the better message -- read it first."
        printf '%s\n' "$first" | grep -E "^\s*(e|w): " | head -15 | sed 's/^/       /'
        printf '%s\n' "$first" | grep -iE "what went wrong" -A4 | head -8 | sed 's/^/       /'
        rm -rf "$scratch"
        return 1
    fi

    gen="$(find "$ex/build/generated" -name 'TurnstileGenerated.kt' | head -1)"
    if grep -q "since" <<<"$(cat "$gen")"; then
        echo "FAIL the first build already mentions \`since\`; the fixture is wrong"
        rm -rf "$scratch"
        return 1
    fi

    sed -i 's|    data object Locked : S|    data class Locked(val since: Long) : S|' \
        "$ex/src/Types.kt"

    local second
    second="$( (cd "$ex" && gradle_run --no-daemon --console=plain build 2>&1) )"
    rc=$?

    gen="$(find "$ex/build/generated" -name 'TurnstileGenerated.kt' | head -1)"
    if [ -z "$gen" ]; then
        echo "FAIL no generated file after the second build"
        bad=1
    elif grep -q "since" "$gen"; then
        echo "ok   a change to S reprocessed the machine"
    else
        echo "FAIL the generated file is stale: \`Locked\` gained a payload and"
        echo "     PAYLOADS does not mention it. KSP reused the first build's"
        echo "     output, so the processor is not declaring the sealed"
        echo "     hierarchy as a dependency of what it writes."
        if [ "$rc" -ne 0 ]; then
            echo "     (the second build also failed, rc=$rc)"
            printf '%s\n' "$second" | grep -E "^\s*(e|w): " | head -15 | sed 's/^/       /'
            printf '%s\n' "$second" | grep -iE "what went wrong" -A4 | head -8 | sed 's/^/       /'
        fi
        bad=1
    fi

    rm -rf "$scratch"
    return "$bad"
}

check_position() {
    local dir="$1" src="$2" expect="$3" out="$4"
    local at lineno line
    at="$(sed -n 's|^//~ AT: ||p' "$dir"/*.kt 2>/dev/null | head -1)"
    [ -n "$at" ] || return 0

    lineno="$(printf '%s\n' "$out" | grep -F -- "$expect" \
        | sed -n 's|.*\.kt:\([0-9]\{1,\}\):.*|\1|p' | head -1)"
    if [ -z "$lineno" ]; then
        echo "FAIL $(basename "$dir") -- the diagnostic carries no source position"
        echo "     expected it to point at a line containing: $at"
        echo "     the lines carrying the message were:"
        printf '%s\n' "$out" | grep -F -- "$expect" | head -3 | sed 's/^/       /'
        return 1
    fi

    line="$(sed -n "${lineno}p" "$src")"
    case "$line" in
        *"$at"*) return 0 ;;
        *)
            echo "FAIL $(basename "$dir") -- points at line $lineno:"
            echo "       $line"
            echo "     expected a line containing: $at"
            return 1
            ;;
    esac
}

step_kotlin_ksp_compile_fail() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp-compile-fail (\$gradle not found)"
        return 0
    fi
    if [ -z "${TABULAR_CENTER_MAVEN_REPO:-}" ] && offline; then
        echo "skip kotlin-ksp-compile-fail (no locked artifact set; run"
        echo "     'nix run .#gradle-lock' with network and commit it)"
        return 0
    fi
    require_dir tabular-center-kotlin/ksp/compile-fail/fixtures || return 1

    local dir name expect src out bad=0 n=0
    for dir in tabular-center-kotlin/ksp/compile-fail/fixtures/*/; do
        [ -d "$dir" ] || continue
        name="$(basename "$dir")"
        n=$((n + 1))

        local expects count
        src="$(grep -l '^//~ EXPECT: ' "$dir"/*.kt 2>/dev/null | head -1)"
        expects="$(sed -n 's|^//~ EXPECT: ||p' "$dir"/*.kt 2>/dev/null)"
        count="$(printf '%s\n' "$expects" | grep -c .)"
        if [ "$count" -eq 0 ]; then
            echo "FAIL $name -- no '//~ EXPECT:' line in any file"
            bad=1
            continue
        elif [ "$count" -gt 1 ]; then
            echo "FAIL $name -- $count '//~ EXPECT:' lines; a fixture asserts one thing"
            bad=1
            continue
        fi
        expect="$expects"

        out="$( (cd tabular-center-kotlin/ksp/compile-fail && gradle_run --no-daemon --console=plain \
            -PtabulaFixture="$name" build 2>&1) )"
        local rc=$?

        if grep -q '^//~ BUILDS' "$dir"/*.kt 2>/dev/null; then
            if [ "$rc" -ne 0 ]; then
                echo "FAIL $name -- a warning fixture, but the build failed"
                printf '%s' "$out" | grep -iE "^e:|error:" | head -3 | sed 's/^/       /'
                bad=1
            elif ! grep -qF -- "$expect" <<<"$out"; then
                echo "FAIL $name -- built, but did not warn \`$expect\`"
                bad=1
            elif ! check_position "$dir" "$src" "$expect" "$out"; then
                bad=1
            else
                echo "ok   $name ($expect, a warning, positioned)"
            fi
            continue
        fi

        if [ "$rc" -eq 0 ]; then
            echo "FAIL $name -- compiled, but was expected to fail"
            bad=1
        elif ! grep -qF -- "$expect" <<<"$out"; then
            echo "FAIL $name -- failed, but not with \`$expect\`"
            printf '%s' "$out" | grep -iE "^e:|error:" | head -3 | sed 's/^/       /'
            bad=1
        elif ! check_position "$dir" "$src" "$expect" "$out"; then
            bad=1
        elif ! grep -qF -- "$(basename "$src")" <<<"$out"; then
            echo "FAIL $name -- reported \`$expect\` with no source position"
            echo "       expected the message to name $(basename "$src");"
            echo "       KSPLogger.error was probably called without its node."
            printf '%s' "$out" | grep -iE "^e:" | head -3 | sed 's/^/       /'
            bad=1
        else
            echo "ok   $name ($expect, positioned)"
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL no fixtures in tabular-center-kotlin/ksp/compile-fail/fixtures"
        bad=1
    fi
    return "$bad"
}

step_kotlin_compose() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-compose (no gradle; see tabular-center-kotlin/examples/07-compose/README.md)"
        return 0
    fi
    require_dir tabular-center-kotlin/examples/07-compose || return 1

    local args=(--no-daemon --console=plain)

    if [ -n "${TABULAR_CENTER_MAVEN_REPO:-}" ]; then
        if [ ! -d "$TABULAR_CENTER_MAVEN_REPO/org/jetbrains/compose" ]; then
            echo "skip kotlin-compose (the locked artifact set has no Compose)"
            echo "     re-lock on a machine with network, and commit it:"
            echo "       nix run .#gradle-lock"
            return 0
        fi
        args+=(--offline "-Dmaven.repo.local=$TABULAR_CENTER_MAVEN_REPO")
        echo "note: resolving offline from $TABULAR_CENTER_MAVEN_REPO"
    elif offline; then
        echo "skip kotlin-compose (no locked artifact set: run 'nix run .#gradle-lock'"
        echo "     on a machine with network and commit tabular-center-kotlin/nix/gradle-lock.json)"
        return 0
    else
        echo "note: resolving from the network"
    fi

    (cd tabular-center-kotlin/examples/07-compose && gradle_run "${args[@]}" check) || return 1
    echo "ok   compose (bitkey-shaped, machine checked headlessly; UI compiled only)"
}

step_kotlin_ksp() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp (no gradle; see tabular-center-kotlin/ksp/README.md)"
        return 0
    fi
    require_dir tabular-center-kotlin/examples/06-generated || return 1

    local args=(--no-daemon --console=plain)

    if [ -n "${TABULAR_CENTER_MAVEN_REPO:-}" ]; then
        if [ -f tabular-center-kotlin/nix/gradle-lock.json ] && command -v jq >/dev/null 2>&1; then
            local locked_with here
            locked_with="$(jq -r '.gradle // "unknown"' tabular-center-kotlin/nix/gradle-lock.json)"
            here="$(gradle_run --version 2>/dev/null | awk '/^Gradle /{print $2; exit}')"
            if [ -n "$here" ] && [ "$locked_with" != "unknown" ] && \
               [ "$locked_with" != "$here" ]; then
                echo "note: lock was produced by gradle $locked_with, running $here"
                echo "      if resolution fails below, re-lock: nix run .#gradle-lock"
            fi
        fi

        echo "note: resolving offline from $TABULAR_CENTER_MAVEN_REPO"
    elif offline; then
        echo "skip kotlin-ksp (no locked artifact set: run 'nix run .#gradle-lock'"
        echo "     on a machine with network and commit tabular-center-kotlin/nix/gradle-lock.json)"
        return 0
    else
        echo "note: resolving from the network"
    fi

    (cd tabular-center-kotlin/examples/06-generated && gradle_run "${args[@]}" build) || return 1
    echo "ok   generated (ksp)"

    local twins gen name twin bad=0 n=0
    twins="$(mktemp -d)"
    local built
    built="$( (
        cd tabular-center-kotlin || exit 1
        kotlin_artifacts "$twins" || exit 1
        tcp="$(kotlin_cp "$twins")"
        "$KOTLINC" -cp "$tcp" codegen/*.kt -include-runtime -d "$twins/cg.jar" 2>&1 \
            | grep -v "^info:" || true
        [ -f "$twins/cg.jar" ] || { echo "the codegen check failed to compile"; exit 1; }
        java -cp "$twins/cg.jar:$tcp" center.tabula.codegen.MainKt "--emit=$twins/out"
    ) 2>&1 )" || {
        echo "FAIL could not build or run the codegen check that states the twins:"
        printf '%s\n' "$built" | tail -20 | sed 's/^/       /'
        rm -rf "$twins"
        return 1
    }

    while IFS= read -r gen; do
        [ -n "$gen" ] || continue
        name="$(basename "$gen" .kt)"
        n=$((n + 1))
        twin="$twins/out/ksp-twins/$name.kt"
        if [ ! -f "$twin" ]; then
            echo "FAIL KSP emitted $name.kt, and kspTwins in tabular-center-kotlin/codegen/Main.kt"
            echo "     states no twin for it: its extraction is unchecked"
            bad=1
        elif diff -u "$twin" "$gen"; then
            echo "ok   $name: KSP extracted what its twin states"
        else
            echo
            echo "FAIL $name: KSP's output differs from its twin (above: - twin, + KSP)."
            echo "     A diff in TABLE, PAYLOADS or member order is extraction"
            echo "     drifting. Change the twin only if the annotations changed."
            bad=1
        fi
    done < <(find tabular-center-kotlin/examples/06-generated/build/generated -name '*Generated.kt' \
        -type f 2>/dev/null | sort)

    for twin in "$twins/out/ksp-twins"/*.kt; do
        [ -e "$twin" ] || continue
        name="$(basename "$twin")"
        if [ -z "$(find tabular-center-kotlin/examples/06-generated/build/generated -name "$name" \
            -type f 2>/dev/null | head -1)" ]; then
            echo "FAIL kspTwins states $name, and KSP generated no such file."
            echo "     Look under build/generated/, or drop the twin if the"
            echo "     example no longer declares the machine."
            bad=1
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL KSP generated no *Generated.kt; this checked nothing"
        bad=1
    fi
    rm -rf "$twins"
    return "$bad"
}

KTLINT="${KTLINT:-ktlint}"

gradle_run() {
    if [ -n "${TABULAR_CENTER_JDK_HOME:-}" ]; then
        gradle -Dorg.gradle.java.home="$TABULAR_CENTER_JDK_HOME" \
            -Dorg.gradle.java.installations.paths="$TABULAR_CENTER_JDK_HOME" \
            -Dorg.gradle.java.installations.auto-detect=false "$@"
    else
        gradle "$@"
    fi
}

step_kotlin_matrix_stable() {
    if ! command -v "$KTLINT" >/dev/null 2>&1; then
        echo "skip kotlin-matrix-stable (\$KTLINT not found; nixpkgs provides it)"
        return 0
    fi
    require_dir tabular-center-kotlin || return 1

    local roots=(tabular-center-kotlin)

    local scratch bad=0 found=0 f root
    scratch="$(mktemp -d)"
    for root in "${roots[@]}"; do
        mkdir -p "$scratch/$(dirname "$root")"
        cp -r "$root" "$scratch/$root"
    done

    cp .editorconfig "$scratch/.editorconfig"

    for root in "${roots[@]}"; do
        (cd "$scratch" && "$KTLINT" --format "$root/**/*.kt" >/dev/null 2>&1) || true
    done

    local pat='@Row(\|@Machine(\|CellSpec(\|Cell\.'
    for root in "${roots[@]}"; do
        for f in $( (cd "$root" && { grep -rl "@Row(\|@Machine(" . 2>/dev/null
            find . -name '*.tb.kt' -type f; } | sort -u) ); do
            found=$((found + 1))
            if [ "${f%.tb.kt}" != "$f" ] && ! grep -q "$pat" "$root/$f"; then
                echo "FAIL $root/$f is a .tb.kt with no matrix rows in it"
                bad=1
                continue
            fi
            if ! diff -q \
                <(grep -h "$pat" "$root/$f") \
                <(grep -h "$pat" "$scratch/$root/$f") >/dev/null; then
                echo "FAIL ktlint --format changed the matrix in $root/$f"
                diff \
                    <(grep -h "$pat" "$root/$f") \
                    <(grep -h "$pat" "$scratch/$root/$f") | head -6
                bad=1
            else
                echo "ok   matrix rows survive ktlint --format: $root/$f"
            fi
        done
    done

    if [ "$found" -eq 0 ]; then
        echo "FAIL no @Machine/@Row declarations found under: ${roots[*]}"
        echo "     Either the matrices moved or the scan looks in the wrong"
        echo "     place. A check with nothing to check is not passing."
        bad=1
    fi

    rm -rf "$scratch"
    return "$bad"
}

step_kotlin_codegen() {
    if ! kotlin_available; then
        echo "skip kotlin-codegen (\$KOTLINC not found)"
        return 0
    fi
    local out gen
    out="$(mktemp -d)"
    gen="$out/emitted"
    local rc=0
    kotlin_version_note

    (
        require_dir tabular-center-kotlin || exit 1
        cd tabular-center-kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        "$KOTLINC" -cp "$KCP" codegen/*.kt -include-runtime -d "$out/cg.jar" 2>&1 \
            | grep -v "^info:" || true
        [ -f "$out/cg.jar" ] || { echo "emitter failed to compile"; exit 1; }

        java -cp "$out/cg.jar:$KCP" center.tabula.codegen.MainKt "--emit=$gen" || exit 1

        "$KOTLINC" -cp "$KCP" codegen/support/TimerTypes.kt codegen/support/ToggleTypes.kt \
            codegen/support/StopwatchTypes.kt codegen/support/TimerRenderTypes.kt \
            codegen/support/ConnectTypes.kt \
            codegen/support/RetryTypes.kt codegen/support/RetrySuspendTypes.kt \
            codegen/support/JobTypes.kt codegen/support/JobSuspendTypes.kt \
            "$gen"/*.kt -d "$out/gen" 2>&1 | grep -v "^info:" || true
        [ -d "$out/gen" ] || { echo "emitted source does not compile"; exit 1; }
        echo "ok   emitted source compiles"

        "$KOTLINC" -cp "$KCP:$out/gen" codegen/support/Complete.kt \
            codegen/support/CompleteJob.kt codegen/support/CompleteJobSuspend.kt \
            codegen/support/CompleteRender.kt codegen/support/CompleteConnect.kt \
            -d "$out/cmp" 2>&1 | grep -v "^info:" || true
        [ -d "$out/cmp" ] || { echo "a complete implementation does not compile"; exit 1; }
        echo "ok   complete implementations compile, composition in both parent colors and the rendering surface included"

        local f m extra exp err bad=0
        for f in codegen/compile_fail/*.kt; do
            m="$(basename "$f" .kt)"
            m="${m%%_*}"
            extra=""
            [ -f "$gen/refused/$m.kt" ] && extra="$gen/refused/$m.kt"
            exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
            # shellcheck disable=SC2086
            raw="$("$KOTLINC" -cp "$KCP:$out/gen" "$f" $extra -d "$out/x" 2>&1)"; rc=$?
            err="$(printf '%s\n' "$raw" | grep -v "^info:" || true)"
            if [ "$rc" -eq 0 ]; then
                echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
                bad=1
            elif grep -qF -- "$exp" <<<"$err"; then
                echo "ok   $(basename "$f")"
            else
                echo "FAIL $(basename "$f")"
                echo "     expected: $exp"
                printf '%s\n' "$err" | head -3 | sed 's/^/       /'
                bad=1
            fi
        done
        exit "$bad"
    )
    rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_compile_fail() {
    if ! kotlin_available; then
        echo "skip kotlin-compile-fail (\$KOTLINC not found)"
        return 0
    fi
    local out bad f exp err raw rc
    out="$(mktemp -d)"
    bad=0
    kotlin_version_note

    (cd tabular-center-kotlin && kotlin_artifacts "$out") || return 1
    KCP="$(kotlin_cp "$out")"
    (cd tabular-center-kotlin && "$KOTLINC" -cp "$KCP" test/ReferenceTimer.kt test/TimerSpec.tb.kt \
        test/Composition.kt -d "$out/ref" 2>&1 | grep -v "^info:") || true

    for f in tabular-center-kotlin/compile_fail/*.kt; do
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        raw="$("$KOTLINC" -cp "$KCP:$out/ref" "$f" -d "$out/x" 2>&1)"; rc=$?
        err="$(printf '%s\n' "$raw" | grep -v "^info:" || true)"
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif grep -qF -- "$exp" <<<"$err"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$out"
    return "$bad"
}

step_kotlin_render() {
    [ -n "${TABULAR_CENTER_RENDER_DIR:-}" ] || {
        echo "kotlin-render: TABULAR_CENTER_RENDER_DIR is not set; the root's renderings-agree sets it"
        return 2
    }
    require_fixtures || return 1
    if kotlin_available; then
        local out
        out="$(mktemp -d)"
        if (
            cd tabular-center-kotlin || exit 1
            kotlin_artifacts "$out" || exit 1
            KCP="$(kotlin_cp "$out")"
            "$KOTLINC" -cp "$KCP" test/Composition.kt -d "$out/comp" 2>&1 \
                | grep -v "^info:" || true
            "$KOTLINC" -cp "$KCP:$out/comp" conformance/*.kt -include-runtime \
                -d "$out/c.jar" 2>&1 | grep -v "^info:" || true
            [ -f "$out/c.jar" ] || { echo "conformance failed to compile"; exit 1; }
            java -cp "$out/c.jar:$KCP:$out/comp" conformance.MainKt \
                ../spec/conformance "--emit=$TABULAR_CENTER_RENDER_DIR"
        ) >/dev/null; then
            rm -rf "$out"
            return 0
        fi
        rm -rf "$out"
        return 1
    fi
    echo "skip renderings-agree (kotlin: \$KOTLINC not found)"
}

step_kotlin_publication() {
    local t
    for t in gradle gpg gpgv gpgconf zip unzip; do
        if ! command -v "$t" >/dev/null 2>&1; then
            echo "skip kotlin-publication (\$$t not found)"
            return 0
        fi
    done
    local scratch version bad=0
    scratch="$(mktemp -d)"
    version="$(tr -d '[:space:]' < VERSION)"

    local gh
    gh="$(mktemp -d /tmp/tcg.XXXXXX 2>/dev/null || mktemp -d)"
    chmod 700 "$gh"
    local G=(gpg --homedir "$gh" --batch --pinentry-mode loopback --passphrase '')
    "${G[@]}" --quick-gen-key 'tabular-center publication check <check@tabula.center>' \
        ed25519 cert never 2>/dev/null
    local fpr subid
    fpr="$("${G[@]}" --with-colons --list-keys check@tabula.center | awk -F: '/^fpr/{print $10; exit}')"
    "${G[@]}" --quick-add-key "$fpr" ed25519 sign never 2>/dev/null
    subid="$("${G[@]}" --with-colons --list-secret-keys check@tabula.center | awk -F: '/^ssb/{ if ($5 != "") print "0x" $5; exit }')"
    SIGNING_KEY="$("${G[@]}" --armor --export-secret-subkeys "$subid!")"
    SIGNING_KEY_PASSWORD=""
    SIGNING_KEY_ID="$subid"
    "${G[@]}" --export check@tabula.center > "$scratch/check.gpg"
    gpgconf --homedir "$gh" --kill all 2>/dev/null || true
    rm -rf "$gh"
    if [ -z "$subid" ] || [ -z "$SIGNING_KEY" ]; then
        echo "FAIL could not make this run's signing key"
        rm -rf "$scratch"
        return 1
    fi

    export SIGNING_KEY SIGNING_KEY_PASSWORD SIGNING_KEY_ID
    if ! tabular-center-kotlin/tools/central-bundle "$scratch/staging" "$scratch/bundle.zip" 2>&1 | tail -15; then
        echo "FAIL the bundle did not build"
        rm -rf "$scratch"
        return 1
    fi
    unset SIGNING_KEY SIGNING_KEY_PASSWORD SIGNING_KEY_ID

    local a base f ext tag
    for a in core annotations codegen ksp testing; do
        base="$scratch/staging/center/tabula/tabular-center-$a/$version/tabular-center-$a-$version"
        for f in "$base.jar" "$base-sources.jar" "$base-javadoc.jar" "$base.pom" "$base.module"; do
            for ext in "" .asc .md5 .sha1; do
                if [ ! -f "$f$ext" ]; then
                    echo "FAIL missing $(basename "$f$ext")"
                    bad=1
                fi
            done
            if [ -f "$f.asc" ] && ! gpgv --keyring "$scratch/check.gpg" "$f.asc" "$f" >/dev/null 2>&1; then
                echo "FAIL $(basename "$f").asc does not verify"
                bad=1
            fi
        done
        for tag in name description url licenses developers scm; do
            if [ -f "$base.pom" ] && ! grep -q "<$tag>" "$base.pom"; then
                echo "FAIL $(basename "$base.pom") has no <$tag>, which Central requires"
                bad=1
            fi
        done
    done

    local testing_pom="$scratch/staging/center/tabula/tabular-center-testing/$version/tabular-center-testing-$version.pom"
    if [ -f "$testing_pom" ] && ! grep -A3 '<artifactId>tabular-center-core</artifactId>' "$testing_pom" | grep -q '<scope>compile</scope>'; then
        echo "FAIL tabular-center-testing must depend on tabular-center-core at compile scope"
        bad=1
    fi
    if unzip -l "$scratch/bundle.zip" | grep -q 'maven-metadata'; then
        echo "FAIL the bundle carries maven-metadata, a repository's file, not a release's"
        bad=1
    fi

    rm -rf "$scratch"
    [ "$bad" -eq 0 ] || return 1
    echo "ok   five artifacts for Maven Central: signed, checksummed, POMs complete"
}

STEPS_DEFAULT=(kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen kotlin-examples kotlin-ksp kotlin-ksp-compile-fail kotlin-ksp-incremental kotlin-matrix-stable kotlin-compose kotlin-publication)
STEPS_EXTRA=(kotlin-render)

case "${1:-}" in
    --list) printf '%s\n' "${STEPS_DEFAULT[@]}"; exit 0 ;;
    --list-all) printf '%s\n' "${STEPS_DEFAULT[@]}" "${STEPS_EXTRA[@]}"; exit 0 ;;
esac

steps=("$@")
[ ${#steps[@]} -eq 0 ] && steps=("${STEPS_DEFAULT[@]}")

for s in "${steps[@]}"; do
    case "$s" in
        kotlin)                  run kotlin                  step_kotlin ;;
        kotlin-compile-fail)     run kotlin-compile-fail     step_kotlin_compile_fail ;;
        kotlin-conformance)      run kotlin-conformance      step_kotlin_conformance ;;
        kotlin-codegen)          run kotlin-codegen          step_kotlin_codegen ;;
        kotlin-publication) run kotlin-publication step_kotlin_publication ;;
        kotlin-examples)         run kotlin-examples         step_kotlin_examples ;;
        kotlin-ksp)              run kotlin-ksp              step_kotlin_ksp ;;
        kotlin-ksp-compile-fail) run kotlin-ksp-compile-fail step_kotlin_ksp_compile_fail ;;
        kotlin-ksp-incremental)  run kotlin-ksp-incremental  step_kotlin_ksp_incremental ;;
        kotlin-matrix-stable)    run kotlin-matrix-stable    step_kotlin_matrix_stable ;;
        kotlin-compose)          run kotlin-compose          step_kotlin_compose ;;
        kotlin-render)           run kotlin-render           step_kotlin_render ;;
        *) echo "unknown step: $s (Kotlin steps only; the root tools/verify knows them all)"; exit 2 ;;
    esac
done

echo

[ -n "${TABULAR_CENTER_NESTED:-}" ] && exit "$fail"

if grep -q '^[[:space:]]*skip ' "$TALLY"; then
    echo "verify: skipped ---------------------------------------------"
    grep '^[[:space:]]*skip ' "$TALLY" | sed 's/^[[:space:]]*/  /'
    echo "------------------------------------------------------------"
    echo
fi

if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED ----------------------------------------------"
    printf '  %s\n' "${failed_steps[@]}"
    echo "------------------------------------------------------------"
fi
exit "$fail"
