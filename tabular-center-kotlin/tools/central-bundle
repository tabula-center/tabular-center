#!/usr/bin/env bash
# Build the Maven Central bundle for every Kotlin artifact: the root build's
# four and the KSP processor, in one Maven-layout directory, zipped.
#
#   tabular-center-kotlin/tools/central-bundle STAGING_DIR BUNDLE_ZIP
#
# Signed when SIGNING_KEY is set (gradle/publication.gradle.kts); offline when
# TABULAR_CENTER_MAVEN_REPO points at Nix's pinned artifacts. Used by
# `nix run .#publish` and by the kotlin-publication check.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
staging="$1"
bundle="$2"

gradle_run() {
    if [ -n "${TABULAR_CENTER_JDK_HOME:-}" ]; then
        gradle -Dorg.gradle.java.home="$TABULAR_CENTER_JDK_HOME" \
            -Dorg.gradle.java.installations.paths="$TABULAR_CENTER_JDK_HOME" \
            -Dorg.gradle.java.installations.auto-detect=false "$@"
    else
        gradle "$@"
    fi
}

rm -rf "$staging" "$bundle"
mkdir -p "$staging" "$(dirname "$bundle")"
bundle="$(cd "$(dirname "$bundle")" && pwd)/$(basename "$bundle")"
export TABULAR_CENTER_STAGING="$staging"

(cd "$here" && gradle_run --no-daemon --console=plain publishAllPublicationsToStagingRepository)
(cd "$here/ksp" && gradle_run --no-daemon --console=plain publishAllPublicationsToStagingRepository)

find "$staging" -name 'maven-metadata*' -delete
(cd "$staging" && zip -qr "$bundle" .)
echo "bundle: $bundle ($(cd "$staging" && find . -type f | wc -l | tr -d ' ') files)"
