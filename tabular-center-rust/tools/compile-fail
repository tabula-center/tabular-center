#!/usr/bin/env bash
# Compile-fail harness. Every diagnostic in spec/diagnostics.md gets a fixture
# under tabular-center-rust/tabular-center/tests/compile_fail/, and each fixture must fail to compile
# with the message named in its `//~ EXPECT:` line.
#
# Deliberately not `trybuild`: it would be the crate's only dev-dependency, and
# the zero-dependency rule is worth more than the convenience.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
FIXTURES="tabular-center/tests/compile_fail"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT

# The uplifted rlib, at a stable hash-free path.
#
# This used to be `ls -t deps/libtabular_center-*.rlib | head -1`, which picks by mtime
# out of however many builds are lying around -- different feature sets,
# different RUSTFLAGS, stale artifacts. It failed once in a sequence that would
# not reproduce, which is exactly what a heuristic like that produces.
#
# Parsing `--message-format=json` was the next attempt and is worse: cargo only
# emits `filenames` when it actually rebuilds, so it returns nothing on a no-op
# build -- correct on a clean tree and silently empty on every subsequent run.
#
# cargo copies the library to target/debug/libtabular_center.rlib regardless. No mtime
# race, no JSON, no jq. The glob stays as a fallback for toolchains that do not
# uplift.
cargo build --quiet --all-features || { echo "build failed"; exit 1; }

DEPS="target/debug/deps"
RLIB="target/debug/libtabular_center.rlib"
if [ ! -f "$RLIB" ]; then
    RLIB="$(ls -t "$DEPS"/libtabular_center-*.rlib 2>/dev/null | head -1)"
fi
if [ -z "$RLIB" ] || [ ! -f "$RLIB" ]; then
    echo "no tabular-center rlib after a successful build; looked for $RLIB"
    exit 1
fi

pass=0; fail=0
for f in "$FIXTURES"/*.rs; do
    name="$(basename "$f")"
    [ "$name" = "_prelude.rs" ] && continue

    expect="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
    if [ -z "$expect" ]; then
        echo "FAIL $name -- no '//~ EXPECT:' line"
        fail=$((fail + 1)); continue
    fi

    # The exit status, not an empty stderr. A fixture that compiles but emits
    # a warning has non-empty output, so it used to fall through to the
    # message match below -- and a warning containing the EXPECT string would
    # have reported a fixture that compiled cleanly as ok. The question here
    # is whether rustc refused the file, so ask rustc.
    err="$(rustc --edition 2021 --crate-type bin --emit metadata \
        --extern tabular_center="$RLIB" -L "$DEPS" \
        -o "$OUT/$name.meta" "$f" 2>&1)"
    rc=$?

    if [ "$rc" -eq 0 ]; then
        echo "FAIL $name -- compiled, but was expected to fail"
        [ -n "$err" ] && printf '%s\n' "$err" | head -3 | sed 's/^/       /'
        fail=$((fail + 1))
    elif grep -qF -- "$expect" <<<"$err"; then
        echo "ok   $name"
        pass=$((pass + 1))
    else
        echo "FAIL $name"
        echo "     expected: $expect"
        echo "     got:"
        printf '%s\n' "$err" | grep -E '^(error|warning)' | head -3 | sed 's/^/       /'
        fail=$((fail + 1))
    fi
done

echo
echo "compile-fail: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
