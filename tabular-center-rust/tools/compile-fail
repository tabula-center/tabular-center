#!/usr/bin/env bash
# Compile-fail harness for the Rust crate. Each fixture under
# tabular-center/tests/compile_fail/ must be REFUSED by rustc, with the message
# its `//~ EXPECT:` line names.
#
#   tabular-center-rust/tools/compile-fail      (or: tools/verify compile-fail)
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
FIXTURES="tabular-center/tests/compile_fail"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT

cargo build --quiet --all-features || { echo "build failed"; exit 1; }

DEPS="target/debug/deps"
RLIB="target/debug/libtabular_center.rlib"
if [ ! -f "$RLIB" ]; then
    RLIB="$(ls -t "$DEPS"/libtabular_center-*.rlib 2>/dev/null | head -1)"
fi
if [ -z "$RLIB" ] || [ ! -f "$RLIB" ]; then
    echo "no tabular-center rlib after a successful build; looked for $RLIB"
    exit 1
fi

pass=0; fail=0
for f in "$FIXTURES"/*.rs; do
    name="$(basename "$f")"
    [ "$name" = "_prelude.rs" ] && continue

    expect="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
    if [ -z "$expect" ]; then
        echo "FAIL $name -- no '//~ EXPECT:' line"
        fail=$((fail + 1)); continue
    fi

    err="$(rustc --edition 2021 --crate-type bin --emit metadata \
        --extern tabular_center="$RLIB" -L "$DEPS" \
        -o "$OUT/$name.meta" "$f" 2>&1)"
    rc=$?

    if [ "$rc" -eq 0 ]; then
        echo "FAIL $name -- compiled, but was expected to fail"
        [ -n "$err" ] && printf '%s\n' "$err" | head -3 | sed 's/^/       /'
        fail=$((fail + 1))
    elif grep -qF -- "$expect" <<<"$err"; then
        echo "ok   $name"
        pass=$((pass + 1))
    else
        echo "FAIL $name"
        echo "     expected: $expect"
        echo "     rustc said, in full:"
        printf '%s\n' "$err" | head -60 | sed 's/^/       /'
        fail=$((fail + 1))
    fi
done

echo
echo "compile-fail: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
