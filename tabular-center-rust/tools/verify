#!/usr/bin/env bash
# The Rust steps of what "green" means, run directly, by the root
# tools/verify, or by this directory's flake. Runs from the repository root.
#
# Usage:  tabular-center-rust/tools/verify [step ...]   (default: every step)
#         tabular-center-rust/tools/verify --list
# Steps:  fmt clippy test no-std compile-fail conformance examples
#         rust-matrix-stable rust-gui package asm-identical (+ rust-render)
#
# Steps are declared once, in the arrays below; `--list` prints them for the
# root. Each step's output is teed into one ledger, every skip is reprinted
# before the verdict, and failed steps are named again at the end. Why each
# step is built as it is: ARCHITECTURE.md 16, "The checks, step by step".
set -uo pipefail

cd "$(dirname "$0")/../.." || exit 1

CARGO_FLAGS="--offline --locked"
fail=0
failed_steps=()

require_dir() {
    [ -d "$1" ] && return 0
    echo "missing directory: $1"
    echo
    echo "  If this is a nix build and the directory exists in your working"
    echo "  tree, it is probably untracked: nix excludes untracked files from a"
    echo "  dirty tree. Commit it, or 'git add -A', or apply patches with"
    echo "  'git am' rather than 'git apply'."
    return 1
}

RENDERINGS="grid mmd lint cov"

require_fixtures() {
    local missing="" tbl name
    for tbl in spec/conformance/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        [ -f "spec/conformance/traces/$name.trace" ] \
            || missing="$missing traces/$name.trace"
    done
    if [ -z "$(echo spec/conformance/*.tbl)" ] || [ ! -e spec/conformance/timer.tbl ]; then
        echo "spec/conformance has no fixtures; the contract has evaporated"
        return 1
    fi
    [ -z "$missing" ] && return 0

    echo "fixture(s) missing a trace:"
    for f in $missing; do echo "  $f"; done
    echo
    echo '  .tbl and .trace are authored by hand: they are the contract.'
    echo "  If they exist in your working tree, they are probably untracked --"
    echo "  nix excludes untracked files from a dirty tree, so 'git apply'"
    echo "  leaves new files out of the build. 'git add -A', or use 'git am'."
    return 1
}

offline() { [ -n "${TABULAR_CENTER_OFFLINE:-}" ]; }

TALLY="$(mktemp)"
trap 'rm -f "$TALLY"' EXIT

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    "$@" 2>&1 | tee -a "$TALLY"
    local rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] && return 0
    echo "FAILED: $name"
    failed_steps+=("$name")
    fail=1
}

step_fmt() {
    local ok=0
    (cd tabular-center-rust && cargo fmt --all -- --check) || ok=1
    (cd tabular-center-rust/examples && cargo fmt --all -- --check) || ok=1
    return "$ok"
}

step_clippy() {
    local ok=0
    if (cd tabular-center-rust && cargo clippy --version >/dev/null 2>&1); then
        (cd tabular-center-rust && cargo clippy --all-targets --all-features $CARGO_FLAGS -- -D warnings) || ok=1
        (cd tabular-center-rust/examples && cargo clippy --all-targets $CARGO_FLAGS -- -D warnings) || ok=1
    else
        echo "WARNING: clippy is unavailable."
        echo "  Falling back to rustc lints over the same targets."
        echo "  clippy-only lints (module_inception, needless_range_loop, ...)"
        echo "  are NOT checked here. Run 'nix flake check' before trusting green."
        (cd tabular-center-rust && RUSTFLAGS="-D warnings" cargo check --all-targets --all-features $CARGO_FLAGS) || ok=1
        (cd tabular-center-rust/examples && RUSTFLAGS="-D warnings" cargo check --all-targets $CARGO_FLAGS) || ok=1
    fi
    return "$ok"
}

step_test() { (cd tabular-center-rust && cargo test --all-features $CARGO_FLAGS); }

step_no_std() {
    local out rc
    out="$( (cd tabular-center-rust && cargo build -p tabular-center --no-default-features $CARGO_FLAGS \
        --target thumbv7em-none-eabihf) 2>&1 )"
    rc=$?
    [ "$rc" -eq 0 ] && return 0

    if grep -qE "may not be installed|not find specification for target" <<<"$out"; then
        echo "note: thumbv7em-none-eabihf unavailable; checking --no-default-features on host"
        (cd tabular-center-rust && cargo build -p tabular-center --no-default-features $CARGO_FLAGS)
        return $?
    fi

    printf '%s\n' "$out"
    return "$rc"
}

step_compile_fail() { ./tabular-center-rust/tools/compile-fail; }

step_conformance() {
    require_fixtures || return 1
    (cd tabular-center-rust && cargo run -q -p tabular-center-conformance $CARGO_FLAGS) || return 1
    (cd tabular-center-rust && cargo run -q -p tabular-center-conformance --bin table-diff $CARGO_FLAGS -- timer) \
        >/dev/null || { echo "table-diff failed on a fixture that exists"; return 1; }
    if (cd tabular-center-rust && cargo run -q -p tabular-center-conformance --bin table-diff $CARGO_FLAGS \
        -- no-such-fixture) >/dev/null 2>&1; then
        echo "table-diff exited 0 for a fixture that does not exist"
        return 1
    fi
}

step_rust_gui() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip rust-gui (\$cargo not found)"
        return 0
    fi
    require_dir tabular-center-rust/examples/05-iced || return 1
    if [ ! -f tabular-center-rust/examples/05-iced/Cargo.lock ]; then
        echo "skip rust-gui (no lock: cd tabular-center-rust/examples/05-iced && cargo generate-lockfile)"
        return 0
    fi

    # shellcheck disable=SC2086
    (cd tabular-center-rust/examples/05-iced && cargo test $CARGO_FLAGS) || return 1
    echo "ok   iced example (machine checked; the window is compiled, not opened)"
}

step_examples() {
    require_dir tabular-center-rust/examples || return 1
    (cd tabular-center-rust/examples && cargo test $CARGO_FLAGS) || return 1
    (cd tabular-center-rust/examples && cargo test -p traffic-light $CARGO_FLAGS) || return 1
    (cd tabular-center-rust/examples && cargo run -q -p retry $CARGO_FLAGS) >/dev/null || return 1
}

step_rust_matrix_stable() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip rust-matrix-stable (\$cargo not found)"
        return 0
    fi
    require_dir tabular-center-rust || return 1

    local roots=(tabular-center-rust)
    local fmt_dirs=(tabular-center-rust)
    [ -d tabular-center-rust/examples ] && fmt_dirs+=(tabular-center-rust/examples)

    local scratch bad=0 found=0 f root
    scratch="$(mktemp -d)"
    for root in "${roots[@]}"; do
        mkdir -p "$scratch/$(dirname "$root")"
        cp -r "$root" "$scratch/$root"
    done
    [ -f rustfmt.toml ] && cp rustfmt.toml "$scratch/"
    [ -f .rustfmt.toml ] && cp .rustfmt.toml "$scratch/"

    local d
    for d in "${fmt_dirs[@]}"; do
        (cd "$scratch/$d" && cargo fmt >/dev/null 2>&1) || true
    done

    for root in "${roots[@]}"; do
        for f in $(cd "$root" && grep -rl "transition_matrix!" . 2>/dev/null \
            | grep -v "/compile_fail/"); do
            grep -q "=> \[" "$root/$f" || continue
            found=$((found + 1))
            if ! diff -q \
                <(grep -h "=> \[" "$root/$f") \
                <(grep -h "=> \[" "$scratch/$root/$f") >/dev/null; then
                echo "FAIL cargo fmt changed the matrix in $root/$f"
                diff \
                    <(grep -h "=> \[" "$root/$f") \
                    <(grep -h "=> \[" "$scratch/$root/$f") | head -6
                bad=1
            fi
        done
    done

    if [ "$found" -eq 0 ]; then
        echo "FAIL no transition_matrix! rows found under: ${roots[*]}"
        echo "     Either the matrices moved or the scan looks in the wrong"
        echo "     place. A check with nothing to check is not passing."
        bad=1
    else
        echo "ok   matrix rows survive cargo fmt in $found file(s)"
    fi

    rm -rf "$scratch"
    return "$bad"
}

step_rust_render() {
    [ -n "${TABULAR_CENTER_RENDER_DIR:-}" ] || {
        echo "rust-render: TABULAR_CENTER_RENDER_DIR is not set; the root's renderings-agree sets it"
        return 2
    }
    require_fixtures || return 1
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip renderings-agree (rust: \$cargo not found)"
        return 0
    fi
    # shellcheck disable=SC2086
    (cd tabular-center-rust && cargo run -q -p tabular-center-conformance $CARGO_FLAGS -- \
        "--emit=$TABULAR_CENTER_RENDER_DIR" ../spec/conformance) >/dev/null
}

step_package() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip package (\$cargo not found)"
        return 0
    fi
    require_dir tabular-center-rust || return 1
    local list f
    # shellcheck disable=SC2086
    list="$(cd tabular-center-rust && cargo package -p tabular-center $CARGO_FLAGS --allow-dirty --list)" \
        || return 1
    while IFS= read -r f; do echo "  packaged: $f"; done <<<"$list"
    if ! grep -qx -- LICENSE <<<"$list"; then
        echo "FAIL LICENSE is not in the packaged crate"
        return 1
    fi
    # shellcheck disable=SC2086
    (cd tabular-center-rust && cargo package -p tabular-center $CARGO_FLAGS --allow-dirty)
}

step_asm_identical() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip asm-identical (\$cargo not found)"
        return 0
    fi
    require_dir tabular-center-rust || return 1
    tabular-center-rust/tools/asm-diff
}

STEPS_DEFAULT=(fmt clippy test no-std compile-fail conformance examples rust-matrix-stable rust-gui package asm-identical)
STEPS_EXTRA=(rust-render)

case "${1:-}" in
    --list) printf '%s\n' "${STEPS_DEFAULT[@]}"; exit 0 ;;
    --list-all) printf '%s\n' "${STEPS_DEFAULT[@]}" "${STEPS_EXTRA[@]}"; exit 0 ;;
esac

steps=("$@")
[ ${#steps[@]} -eq 0 ] && steps=("${STEPS_DEFAULT[@]}")

for s in "${steps[@]}"; do
    case "$s" in
        fmt)                run fmt                step_fmt ;;
        clippy)             run clippy             step_clippy ;;
        test)               run test               step_test ;;
        no-std)             run no-std             step_no_std ;;

        package)             run package             step_package ;;
        asm-identical)      run asm-identical      step_asm_identical ;;
        compile-fail)       run compile-fail       step_compile_fail ;;
        conformance)        run conformance        step_conformance ;;
        examples)           run examples           step_examples ;;
        rust-matrix-stable) run rust-matrix-stable step_rust_matrix_stable ;;
        rust-gui)           run rust-gui           step_rust_gui ;;
        rust-render)        run rust-render        step_rust_render ;;
        *) echo "unknown step: $s (Rust steps only; the root tools/verify knows them all)"; exit 2 ;;
    esac
done

echo

[ -n "${TABULAR_CENTER_NESTED:-}" ] && exit "$fail"

if grep -q '^[[:space:]]*skip ' "$TALLY"; then
    echo "verify: skipped ---------------------------------------------"
    grep '^[[:space:]]*skip ' "$TALLY" | sed 's/^[[:space:]]*/  /'
    echo "------------------------------------------------------------"
    echo
fi

if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED ----------------------------------------------"
    printf '  %s\n' "${failed_steps[@]}"
    echo "------------------------------------------------------------"
fi
exit "$fail"
