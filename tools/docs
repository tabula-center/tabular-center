#!/usr/bin/env bash
# Generate doc/ from spec/ and the code.
#
# GitHub Pages serves doc/ straight from the branch -- no workflow, no build
# artifact, no Pages setting to get right -- and diagnostic messages link into
# it. So doc/ is COMMITTED, and GENERATED: spec/ stays normative, the code
# samples stay the code, and doc/ is a rendering of both. Nobody edits it.
#
# Committed-and-generated is a copy that can go stale, which is why `--check`
# regenerates and diffs rather than trusting it: a spec edit, a moved sample
# or a changed fixture message without `./tools/docs` fails
# `tools/verify docs`, and the fix is to run this and commit what it writes.
#
# It used to be generated in CI and never committed, published by a pages.yml
# workflow. That only works with Pages' source set to GitHub Actions; with the
# source left on the branch, Pages rendered README.md and nothing else, and
# every language page was a 404.
#
#   ./tools/docs          regenerate
#   ./tools/docs --check  render into a scratch directory and require: every
#                         code sample resolves, every diagnostic code has an
#                         anchor, and the result is byte-identical to the
#                         committed doc/ (verify runs this)
#
# The language pages -- index, rust, kotlin, swift -- show real code. Every
# sample is INCLUDED from the tree at generation time, by file and line range,
# never pasted: the samples are code CI compiles and runs, so a page cannot
# show a machine that no longer builds. A range that stops matching fails the
# generator, and with it `tools/verify docs`, rather than publishing a page
# with a hole in it.
#
# To see it rendered: `nix run .#docs` serves it, `nix run .#docs -- build`
# writes HTML. Both regenerate first, so a preview cannot show something the
# repository does not contain.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# Byte order, whoever runs this. doc/ is committed and `--check` regenerates
# and diffs it, and the diagnostics page's code index is built with `sort`,
# which follows the locale: en_US.UTF-8 ignores punctuation, C compares bytes.
# Regenerated on a desktop, the index could come out in an order CI -- in C --
# calls stale. tools/gradle-lock hit exactly that.
export LC_ALL=C

# One place to change if the repository moves. spec/diagnostics.md tells every
# implementation to end a message with a link under DOCS_BASE, so it is
# deliberately not spread across three implementations.
DOCS_BASE="https://tabula-center.github.io/tabular-center/doc"
REPO_URL="https://github.com/tabula-center/tabular-center"

check=0
[ "${1:-}" = "--check" ] && check=1

out="doc"
[ "$check" -eq 1 ] && out="$(mktemp -d)"
# Regenerating starts from nothing, so a page the generator stopped writing
# does not linger in a directory that is committed.
[ "$check" -eq 0 ] && rm -rf doc
mkdir -p "$out"

# Anchors, explicitly. Jekyll and GitHub derive heading anchors by rules that
# differ between them and change between versions, and these anchors are inside
# error messages a user has already read -- a link that rots is worse than no
# link. An injected `<a id>` is stable by construction.
page() {
    local src="$1" dest="$2" title="$3"
    {
        printf -- '---\nlayout: default\ntitle: %s\n---\n\n' "$title"
        printf -- '<!-- Generated from %s by tools/docs. Do not edit. -->\n\n' "$src"
        nav
        sed -E 's|^(#{2,3}) `tabular-center::([a-z-]+)`|<a id="tabular-center-\2"></a>\n\n\1 `tabular-center::\2`|' "$src"
    } > "$out/$dest"
}


# The same line at the top of every page. Relative links: Pages serves
# `rust.md` at `rust`, so these resolve on the site and in a local preview.
nav() {
    printf -- '[Home](./) · [Rust](rust) · [Kotlin](kotlin) · [Swift](swift) · '
    printf -- '[Migrating](migrating) · [Cells](cells) · [Diagnostics](diagnostics) · [Matrix files](matrix-files) · '
    printf -- '[Source](%s)\n\n' "$REPO_URL"
}

front() { printf -- '---\nlayout: default\ntitle: %s\n---\n\n<!-- Generated by tools/docs. Do not edit. -->\n\n' "$1"; nav; }

# Literal prose. Quoted heredocs only (`prose <<'MD'`): markdown is full of
# backticks, which an unquoted heredoc would run as commands.
prose() { cat; }

include_failures=0
include_fail() {
    echo "tools/docs: $*" >&2
    include_failures=$((include_failures + 1))
    printf -- '\n> **Missing sample:** %s\n\n' "$*"
}

# A link to a file on GitHub, for "the whole file is here".
src_link() { printf -- '[`%s`](%s/blob/main/%s)' "$1" "$REPO_URL" "$1"; }

# code FILE LANG [START_RE [END_RE]]
#
# A fenced block holding FILE, or the part of it from the first line matching
# START_RE through the first line after it matching END_RE (both inclusive).
# Without END_RE, to the end of the file. The regexes are awk EREs.
code() {
    local file="$1" lang="$2" start="${3:-}" end="${4:-}" body
    if [ ! -f "$file" ]; then include_fail "$file does not exist"; return; fi
    if [ -z "$start" ]; then
        body="$(cat "$file")"
    else
        # From the first line matching START; then through the first LATER line
        # matching END. The start line itself never ends the range, so a range
        # may open and close on the same pattern (`^\}` after `^\{`, say).
        #
        # Through the environment, not `-v`: `-v` runs escape processing, so
        # `\{` would reach awk as `{`, with a warning, and not reliably literal.
        body="$(START="$start" END="$end" awk '
            BEGIN { s = ENVIRON["START"]; e = ENVIRON["END"] }
            !on { if ($0 ~ s) { on = 1; print }; next }
            { print }
            e != "" && $0 ~ e { exit }
        ' "$file")"
    fi
    if [ -z "$body" ]; then include_fail "$file has no lines matching /$start/"; return; fi
    printf -- '```%s\n%s\n```\n\n' "$lang" "$body"
    printf -- '<sub>From %s.</sub>\n\n' "$(src_link "$file")"
}

# The `//~ EXPECT:` line of a compile-fail fixture: the error the compiler is
# REQUIRED to give, checked on every run by that language's compile-fail step.
expect_of() {
    local file="$1" e
    e="$(sed -n 's|^//~ EXPECT: ||p' "$file" 2>/dev/null | head -1)"
    if [ -z "$e" ]; then include_fail "$file has no //~ EXPECT: line"; return; fi
    printf -- '```text\nerror: %s\n```\n\n' "$e"
}

page spec/diagnostics.md diagnostics.md "Diagnostics"

# Not every code has a section of its own -- the lints are described as a group
# and in tables, which reads better than ten near-identical headings would.
# They still need somewhere to land, because a message links to an anchor by
# name and a link that resolves to nothing drops the reader at the top of a
# long page with no idea why.
#
# So: an index at the end, carrying an anchor for every code that did not get
# one inline. Only for the ones that are missing, since duplicate ids are
# invalid HTML and the first would win anyway.
{
    printf -- '\n---\n\n## All codes\n\n'
    printf -- 'Every code, including the ones described as a group above.\n\n'
    for code in $(grep -oE 'tabular-center::[a-z-]+' spec/diagnostics.md | sort -u); do
        anchor="tabular-center-${code#tabular-center::}"
        if grep -q "id=\"$anchor\"" "$out/diagnostics.md"; then
            printf -- '- [`%s`](#%s)\n' "$code" "$anchor"
        else
            printf -- '- <a id="%s"></a>`%s`\n' "$anchor" "$code"
        fi
    done
} >> "$out/diagnostics.md"
page spec/cells.md       cells.md       "Cells"
page spec/matrix-files.md matrix-files.md "Matrix files"
page spec/tabular-center-fmt.md   tabular-center-fmt.md   "tabular-center-fmt"


