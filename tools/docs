#!/usr/bin/env bash
# Generate docs/ from spec/.
#
# GitHub Pages serves docs/, and diagnostic messages link into it. The pages are
# GENERATED and NOT COMMITTED: spec/ is normative, and a second copy of
# normative text in the tree is a copy someone has to remember to regenerate.
# .github/workflows/pages.yml runs this and publishes the result as an
# artifact. Same rule that keeps generated dispatchers out of the examples.
#
#   ./tools/docs          regenerate
#   ./tools/docs --check  render, and verify every diagnostic code has an
#                         anchor for its messages to link to (verify runs this)
#
# To see it rendered: `nix run .#docs` serves it, `nix run .#docs -- build`
# writes HTML. Both regenerate first, so a preview cannot show something the
# repository does not contain.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# One place to change if the repository moves. Diagnostic messages embed this,
# so it is deliberately not spread across three implementations.
DOCS_BASE="https://anthropic-tabula.github.io/tabula"

check=0
[ "${1:-}" = "--check" ] && check=1

out="docs"
[ "$check" -eq 1 ] && out="$(mktemp -d)"
mkdir -p "$out"

# Anchors, explicitly. Jekyll and GitHub derive heading anchors by rules that
# differ between them and change between versions, and these anchors are inside
# error messages a user has already read -- a link that rots is worse than no
# link. An injected `<a id>` is stable by construction.
page() {
    local src="$1" dest="$2" title="$3"
    {
        printf -- '---\nlayout: default\ntitle: %s\n---\n\n' "$title"
        printf -- '<!-- Generated from %s by tools/docs. Do not edit. -->\n\n' "$src"
        sed -E 's|^(#{2,3}) `tabula::([a-z-]+)`|<a id="tabula-\2"></a>\n\n\1 `tabula::\2`|' "$src"
    } > "$out/$dest"
}

page spec/diagnostics.md diagnostics.md "Diagnostics"

# Not every code has a section of its own -- the lints are described as a group
# and in tables, which reads better than ten near-identical headings would.
# They still need somewhere to land, because a message links to an anchor by
# name and a link that resolves to nothing drops the reader at the top of a
# long page with no idea why.
#
# So: an index at the end, carrying an anchor for every code that did not get
# one inline. Only for the ones that are missing, since duplicate ids are
# invalid HTML and the first would win anyway.
{
    printf -- '\n---\n\n## All codes\n\n'
    printf -- 'Every code, including the ones described as a group above.\n\n'
    for code in $(grep -oE 'tabula::[a-z-]+' spec/diagnostics.md | sort -u); do
        anchor="tabula-${code#tabula::}"
        if grep -q "id=\"$anchor\"" "$out/diagnostics.md"; then
            printf -- '- [`%s`](#%s)\n' "$code" "$anchor"
        else
            printf -- '- <a id="%s"></a>`%s`\n' "$anchor" "$code"
        fi
    done
} >> "$out/diagnostics.md"
page spec/cells.md       cells.md       "Cells"
page spec/matrix-files.md matrix-files.md "Matrix files"

cat > "$out/index.md" <<EOF
---
layout: default
title: tabula
---

<!-- Generated by tools/docs. Do not edit. -->

# tabula

State machines as a matrix the compiler checks and a reviewer can read.

- [Diagnostics]($DOCS_BASE/diagnostics) — every error code, its message, and why
  it exists. Linked from the messages themselves.
- [Cells]($DOCS_BASE/cells) — the normative semantics of the six cell kinds.
- [Matrix files]($DOCS_BASE/matrix-files) — the \`*.tb.\` convention and how to
  stop general-purpose formatters from flattening a matrix.

Everything here is generated from \`spec/\` in the repository. The spec is
normative; these pages are a rendering of it.
EOF

cat > "$out/_config.yml" <<'EOF'
# Minimal, and deliberately so. A theme with its own build step would be a
# second thing that can fail between a commit and a published page.
theme: jekyll-theme-primer
title: tabula
description: State machines as a matrix the compiler checks and a reviewer can read.
EOF

if [ "$check" -eq 1 ]; then
    # Not a staleness check any more: docs/ is generated in CI and is not in
    # the repository, so there is nothing committed to be stale against. This
    # checks the thing that can actually break.
    #
    # Every code in spec/diagnostics.md must have an anchor in the rendered
    # page, because diagnostic messages link to those anchors by name. A code
    # that gains a section without an anchor produces a link that silently
    # lands at the top of the page -- from an error the reader is already stuck
    # on, which is where a bad link costs most.
    rc=0
    codes="$(grep -oE 'tabula::[a-z-]+' spec/diagnostics.md | sort -u)"
    for code in $codes; do
        anchor="tabula-${code#tabula::}"
        if ! grep -q "id=\"$anchor\"" "$out/diagnostics.md"; then
            echo "no anchor for $code (expected id=\"$anchor\")"
            rc=1
        fi
    done
    n="$(printf '%s\n' "$codes" | grep -c .)"
    rm -rf "$out"
    if [ "$rc" -eq 0 ]; then
        echo "ok   docs render, $n diagnostic anchors present"
    else
        echo "FAILED: docs"
    fi
    exit "$rc"
fi

echo "wrote docs/ from spec/"
