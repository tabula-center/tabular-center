#!/usr/bin/env bash
# Generate docs/ from spec/.
#
# GitHub Pages serves docs/, and diagnostic messages link into it. The pages are
# GENERATED and NOT COMMITTED: spec/ is normative, and a second copy of
# normative text in the tree is a copy someone has to remember to regenerate.
# .github/workflows/pages.yml runs this and publishes the result as an
# artifact. Same rule that keeps generated dispatchers out of the examples.
#
#   ./tools/docs          regenerate
#   ./tools/docs --check  render, and verify every diagnostic code has an
#                         anchor for its messages to link to, and every code
#                         sample below still resolves (verify runs this)
#
# The language pages -- index, rust, kotlin, swift -- show real code. Every
# sample is INCLUDED from the tree at generation time, by file and line range,
# never pasted: the samples are code CI compiles and runs, so a page cannot
# show a machine that no longer builds. A range that stops matching fails the
# generator, and with it `tools/verify docs`, rather than publishing a page
# with a hole in it.
#
# To see it rendered: `nix run .#docs` serves it, `nix run .#docs -- build`
# writes HTML. Both regenerate first, so a preview cannot show something the
# repository does not contain.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# One place to change if the repository moves. spec/diagnostics.md tells every
# implementation to end a message with a link under DOCS_BASE, so it is
# deliberately not spread across three implementations.
DOCS_BASE="https://tabula-center.github.io/tabular-center"
REPO_URL="https://github.com/tabula-center/tabular-center"

check=0
[ "${1:-}" = "--check" ] && check=1

out="docs"
[ "$check" -eq 1 ] && out="$(mktemp -d)"
mkdir -p "$out"

# Anchors, explicitly. Jekyll and GitHub derive heading anchors by rules that
# differ between them and change between versions, and these anchors are inside
# error messages a user has already read -- a link that rots is worse than no
# link. An injected `<a id>` is stable by construction.
page() {
    local src="$1" dest="$2" title="$3"
    {
        printf -- '---\nlayout: default\ntitle: %s\n---\n\n' "$title"
        printf -- '<!-- Generated from %s by tools/docs. Do not edit. -->\n\n' "$src"
        nav
        sed -E 's|^(#{2,3}) `tabula::([a-z-]+)`|<a id="tabula-\2"></a>\n\n\1 `tabula::\2`|' "$src"
    } > "$out/$dest"
}


# The same line at the top of every page. Relative links: Pages serves
# `rust.md` at `rust`, so these resolve on the site and in a local preview.
nav() {
    printf -- '[Home](./) · [Rust](rust) · [Kotlin](kotlin) · [Swift](swift) · '
    printf -- '[Cells](cells) · [Diagnostics](diagnostics) · [Matrix files](matrix-files) · '
    printf -- '[Source](%s)\n\n' "$REPO_URL"
}

front() { printf -- '---\nlayout: default\ntitle: %s\n---\n\n<!-- Generated by tools/docs. Do not edit. -->\n\n' "$1"; nav; }

# Literal prose. Quoted heredocs only (`prose <<'MD'`): markdown is full of
# backticks, which an unquoted heredoc would run as commands.
prose() { cat; }

include_failures=0
include_fail() {
    echo "tools/docs: $*" >&2
    include_failures=$((include_failures + 1))
    printf -- '\n> **Missing sample:** %s\n\n' "$*"
}

# A link to a file on GitHub, for "the whole file is here".
src_link() { printf -- '[`%s`](%s/blob/main/%s)' "$1" "$REPO_URL" "$1"; }

# code FILE LANG [START_RE [END_RE]]
#
# A fenced block holding FILE, or the part of it from the first line matching
# START_RE through the first line after it matching END_RE (both inclusive).
# Without END_RE, to the end of the file. The regexes are awk EREs.
code() {
    local file="$1" lang="$2" start="${3:-}" end="${4:-}" body
    if [ ! -f "$file" ]; then include_fail "$file does not exist"; return; fi
    if [ -z "$start" ]; then
        body="$(cat "$file")"
    else
        # From the first line matching START; then through the first LATER line
        # matching END. The start line itself never ends the range, so a range
        # may open and close on the same pattern (`^\}` after `^\{`, say).
        #
        # Through the environment, not `-v`: `-v` runs escape processing, so
        # `\{` would reach awk as `{`, with a warning, and not reliably literal.
        body="$(START="$start" END="$end" awk '
            BEGIN { s = ENVIRON["START"]; e = ENVIRON["END"] }
            !on { if ($0 ~ s) { on = 1; print }; next }
            { print }
            e != "" && $0 ~ e { exit }
        ' "$file")"
    fi
    if [ -z "$body" ]; then include_fail "$file has no lines matching /$start/"; return; fi
    printf -- '```%s\n%s\n```\n\n' "$lang" "$body"
    printf -- '<sub>From %s.</sub>\n\n' "$(src_link "$file")"
}

# The `//~ EXPECT:` line of a compile-fail fixture: the error the compiler is
# REQUIRED to give, checked on every run by that language's compile-fail step.
expect_of() {
    local file="$1" e
    e="$(sed -n 's|^//~ EXPECT: ||p' "$file" 2>/dev/null | head -1)"
    if [ -z "$e" ]; then include_fail "$file has no //~ EXPECT: line"; return; fi
    printf -- '```text\nerror: %s\n```\n\n' "$e"
}

page spec/diagnostics.md diagnostics.md "Diagnostics"

# Not every code has a section of its own -- the lints are described as a group
# and in tables, which reads better than ten near-identical headings would.
# They still need somewhere to land, because a message links to an anchor by
# name and a link that resolves to nothing drops the reader at the top of a
# long page with no idea why.
#
# So: an index at the end, carrying an anchor for every code that did not get
# one inline. Only for the ones that are missing, since duplicate ids are
# invalid HTML and the first would win anyway.
{
    printf -- '\n---\n\n## All codes\n\n'
    printf -- 'Every code, including the ones described as a group above.\n\n'
    for code in $(grep -oE 'tabula::[a-z-]+' spec/diagnostics.md | sort -u); do
        anchor="tabula-${code#tabula::}"
        if grep -q "id=\"$anchor\"" "$out/diagnostics.md"; then
            printf -- '- [`%s`](#%s)\n' "$code" "$anchor"
        else
            printf -- '- <a id="%s"></a>`%s`\n' "$anchor" "$code"
        fi
    done
} >> "$out/diagnostics.md"
page spec/cells.md       cells.md       "Cells"
page spec/matrix-files.md matrix-files.md "Matrix files"
page spec/tabula-fmt.md   tabula-fmt.md   "tabula-fmt"


# ---------------------------------------------------------------------------
# The front page and one page per language.
# ---------------------------------------------------------------------------

R=tabular-center-rust
K=tabular-center-kotlin
S=tabular-center-swift

{
front "tabular-center"
prose <<'MD'
# tabular-center

**State machines whose declaration *is* the transition matrix** -- for Rust,
Kotlin and Swift, held to one behaviour by a shared conformance suite.

You write the matrix. Every cell is one word, or a call to code you write. The
compiler refuses a machine with a hole in it.

MD
code $R/examples/02-timer/src/machine.tb.rs rust 'transition_matrix! \{' '^\}'
prose <<'MD'
That is the whole behaviour of a three-state timer. Five of its nine cells are
decided right there -- `IGNORE`, or `GO!` to a state with an effect -- and cost
nothing more. Two are `HANDLE`: those, and only those, become methods you
implement, each receiving its state and action already narrowed to concrete
types. Forget one and the build fails naming it.

## The one guarantee

> Every cell of the state × action matrix is a required member.
> **An incomplete machine does not compile.**

Not pattern-match exhaustiveness, which `else`, `default:` and `_` defeat.
Not purity, which Kotlin and Swift cannot enforce. The oldest mechanism in all
three languages: *you declared a required member and did not implement it.*
States, actions **and effects** are generated sum types, so adding an effect
breaks every handler's build the same way adding a state breaks every matrix.

## Concise at the size that matters

The Timer is small on purpose. Here is a real order lifecycle, 8 states by 12
actions:

MD
code $R/tabula/tests/scale.rs rust 'transition_matrix! \{' '^\}'
prose <<'MD'
| | |
|---|---|
| cells | 96 |
| `IGNORE` | 75 (78%) |
| `GO!` | 12 |
| **methods you write** | **9** |

Measured, not estimated: `ninety_six_cells_cost_nine_implementations` in that
file asserts the 9. Eight lines declare 96 transitions, the grid stays
reviewable as a grid, and the 75 cells that do nothing cost one word each --
which is the only reason a machine this size is pleasant to write at all.

## Composition, checked by the same mechanism

A parent hands cells to a child written knowing nothing about it:

MD
code $R/examples/04-login/src/session.tb.rs rust '//  +Credentials' '^    Banned'
prose <<'MD'
The parent's cell surface requires the child's, so a hole in the child is a
build error in the parent -- the same error as a hole in the parent itself.
No registration, no runtime check. It holds in all three languages, each with
a compile-fail fixture proving it, and through colors: a plain child composes
into an `async` or `suspend` parent; the reverse does not compile.

## Three languages, one behaviour

| | [Rust](rust) | [Kotlin](kotlin) | [Swift](swift) |
|---|---|---|---|
| Generator | `macro_rules!` -- no build step, no dependencies | KSP, from annotations | `TabulaCodegen` today; the `@Machine` macro is designed and pending |
| Runtime dependencies | none, `no_std` capable | none | none |
| Colors | `async` | `suspend`, receivers, any modifier | `async`, `throws`, attributes |
| Driver | blocking, non-reentrant mailbox | blocking and `suspend` | sync and `async`, `ObservableStore` |
| Introspection | `TABLE`, grid, Mermaid, DOT, lints, coverage | the same | the same |

The same fixtures in `spec/conformance/` are replayed by all three, and each
renders every fixture's grid, diagram, lints and coverage; a check diffs the
three and fails on a single differing byte. A semantic difference between the
languages is a red build, not a bug report.

## Read on

- **[Rust](rust)**, **[Kotlin](kotlin)**, **[Swift](swift)** -- the same Timer
  in each, the code you write around it, what the compiler says when a cell is
  missing, composition and colors.
- **[Cells](cells)** -- the normative semantics of the six cell kinds.
- **[Diagnostics](diagnostics)** -- every error code, its message and why it
  exists. Error messages link here.
- **[Matrix files](matrix-files)** -- the `*.tb.*` convention that keeps
  formatters from flattening a matrix.

Every sample on these pages is included from the repository when the site is
built, so each one is code that CI compiles and runs.
MD
} > "$out/index.md"

# --- Rust -------------------------------------------------------------------
{
front "Rust"
prose <<'MD'
# Rust

`transition_matrix!` is a `macro_rules!` macro. No proc-macro crate, no build
script, no dependencies at all -- the library's `[dependencies]` table is
empty, and it builds `#![no_std]` with `default-features = false`. MSRV 1.75.

Not on crates.io yet. Until then, depend on the repository:

```toml
[dependencies]
tabula = { git = "https://github.com/tabula-center/tabular-center" }
```

## The matrix

Examples keep the matrix in a file of its own, named `*.tb.rs`
([why](matrix-files)):

MD
code $R/examples/02-timer/src/machine.tb.rs rust 'transition_matrix! \{' '^\}'
prose <<'MD'
The header names the generated types: `State` and `Action` are enums of the
listed variants, and each variant with a payload is also its own struct --
`Running { since }`, `Tick { now }`. `effects` declares the effect enum the
same way. Each row is a state, each column an action, and each cell one of
six kinds ([Cells](cells)):

| | |
|---|---|
| `HANDLE` | you implement it |
| `IGNORE` | the action means nothing in this state |
| `GO!(Target, Effect...)` | a static transition, emitting effects |
| `EMIT(Effect...)` | stay, emitting effects |
| `DELEGATE!(child)` | hand the cell to a child machine |
| `UNREACHABLE` | a trap, counted by `Table::coverage` |

## The code you write

One `Handle` impl per `HANDLE` cell and one `Perform` impl per effect. Each is
narrowed: the dispatcher has already matched, so `s.since` and `a.now` are
plain fields.

MD
code $R/examples/02-timer/src/lib.rs rust '^impl Handle<Timer, Idle, Start>'
prose <<'MD'
That is the entire implementation. `step(&mut Impl, &mut ctx, state, action)`
dispatches; `Driver` runs a mailbox over it, so an effect handler that returns
a follow-up action queues it instead of re-entering `step`.

## When a cell is missing

Delete the `Handle<Timer, Running, Tick>` impl and the build stops:

MD
expect_of $R/tabula/tests/compile_fail/missing_handle_impl.rs
prose <<'MD'
That is rustc's own message -- the `step` it generated carries one trait bound
per `HANDLE` cell -- so it names the exact hole and survives even if the
macro is bypassed. It is a fixture: `compile-fail` requires it on every run,
along with one fixture per diagnostic the macro itself emits
([Diagnostics](diagnostics)), such as a row with too few cells.

## Composition

`DELEGATE!(auth)` hands cells to a child machine. The parent's state carries
the child's, and one type implements both:

MD
code $R/examples/04-login/src/session.tb.rs rust 'transition_matrix! \{' '^\}'
prose <<'MD'
## Colors

`prototype async fn handle;` after `context` makes the machine async: `step`
becomes an `async fn`, and the cells implement `AsyncHandle` / `AsyncPerform`.
A plain child composes into an async parent; an async child under a plain
parent is refused by rustc.

## Introspection

Every machine has a `TABLE` const describing its matrix, from which the
library renders a diffable grid, Mermaid and DOT diagrams, a coverage report,
and lints -- a column nothing handles, a field repeated across every state that
belongs in the context, a machine that is mostly `IGNORE` (the order lifecycle
on the [front page](./) trips that one, fairly). `table-diff` prints the grid:
`nix run .#table-diff -- timer`.

## Examples

MD
printf -- 'In %s, each its own crate:\n\n' "$(src_link $R/examples)"
prose <<'MD'
| | | adds |
|---|---|---|
| 1 | `traffic-light` | the minimum; `#![no_std]`, `default-features = false` |
| 2 | `timer` | payloads, effects, narrowed handlers -- the machine above |
| 3 | `retry` | a binary: effects feeding actions back through the driver |
| 4 | `login` | composition, parent and child |
| 5 | `iced` | a GUI: the same machine driving iced, which knows nothing about it |
MD
} > "$out/rust.md"

# --- Kotlin -----------------------------------------------------------------
{
front "Kotlin"
prose <<'MD'
# Kotlin

The matrix is declared in annotations and KSP generates the dispatcher, the
`Cells` interface with one member per `HANDLE` cell and effect, and the
effect-handler surface. The generated code is never committed; the runtime,
`tabula-core`, compiles against an empty classpath -- no dependencies, not
even coroutines.

## The matrix

`@Machine` names the types; each `@Row` is a state; each `CellSpec` a cell. The
annotated interface's single `handle` is the **prototype**: every generated
member copies its modifiers, receiver and visibility.

MD
code $K/examples/06-generated/src/Stopwatch.tb.kt kotlin '^@Machine\(' '^\}'
prose <<'MD'
The types it names are ordinary sealed hierarchies:

MD
code $K/examples/06-generated/src/StopwatchTypes.kt kotlin '^internal sealed interface S' '^\}'
prose <<'MD'
## The code you write

KSP turns the two `HANDLE` cells and the one effect into three abstract members.
Because the prototype is `fun Clock.handle(...)`, every one of them is an
extension on `Clock` -- a cell calls `now()` without being handed a clock, and
nothing can dispatch without one in scope:

MD
code $K/examples/06-generated/src/StopwatchImpl.kt kotlin '^internal class StopwatchImpl'
prose <<'MD'
Receivers, `suspend`, `internal`, `@Composable` -- whatever the prototype
carries, the generated surface carries. Nothing in the generator enumerates
them.

## What KSP generates

A dispatcher that is an exhaustive `when` over state then action, calling your
members for `HANDLE` cells and building the static ones inline. For the Timer,
the shape is exactly this (hand-written in the kotlinc-only example, so it
can be read without running Gradle). An interface with one member per
`HANDLE` cell and per effect, then a `when` with no `else`:

MD
code $K/examples/02-timer/src/Timer.kt kotlin '^interface Cells \{' '^\}'
code $K/examples/02-timer/src/Timer.kt kotlin '^fun step\(' '^\}'
prose <<'MD'
The `when` is in generated code only. Your file has no `when` to put an `else`
in, which is what turns Kotlin's weakest guarantee -- exhaustiveness that one
`else` defeats -- into one as strong as Rust's.

## When a cell is missing

MD
expect_of $K/compile_fail/missing_cell.kt
prose <<'MD'
kotlinc's own message, required by a fixture on every run. Declaration
mistakes -- an unknown state in a `@Row`, a row with the wrong number of cells
-- are refused by the processor with a `tabula::` code and a pointer at the
annotation ([Diagnostics](diagnostics)).

## Composition and suspend

`Kind.DELEGATE` names the child's annotated interface; the parent requires the
child's whole surface:

MD
code $K/examples/06-generated/src/Job.tb.kt kotlin '^@Machine\(' '^\}'
prose <<'MD'
Make the prototype `suspend fun handle(...)` and `step`, `perform` and every
member suspend; `SuspendDriver` runs it with no coroutine library, from
`tabula-core` alone. A suspending child under a plain parent does not compile.

## Setting it up

Not on Maven Central yet. The examples consume the repository the way you can
today: the runtime as sources, the processor as an included build.

MD
code $K/examples/06-generated/build.gradle.kts kotlin '^plugins \{' '^\}'
code $K/examples/06-generated/build.gradle.kts kotlin '^sourceSets\["main"\]\.kotlin\.srcDir\("src"\)' 'srcDir\("\.\./\.\./annotations"\)'
code $K/examples/06-generated/build.gradle.kts kotlin '^dependencies \{' '^\}'
code $K/examples/06-generated/settings.gradle.kts kotlin '^includeBuild\(' '^\}'
prose <<'MD'
The planned artifacts are `tabula-core` (runtime), `tabula-annotations`
(compile-only), `tabula-ksp` (the processor) and `tabula-testing` (a `.tbl`
fixture harness), so a production build carries the runtime and nothing else.

## Examples

MD
printf -- 'In %s:\n\n' "$(src_link $K/examples)"
prose <<'MD'
| | | adds |
|---|---|---|
| 1-4 | `traffic-light`, `timer`, `retry`, `login` | the four core machines, compiled by kotlinc against `core` alone where they can be |
| 5 | `suspend` | a suspending machine and `SuspendDriver`, with no coroutine library |
| 6 | `generated` | the annotation surface above, through KSP |
| 7 | `compose` | a Compose Desktop app driven by a machine |
MD
} > "$out/kotlin.md"

