#!/usr/bin/env bash
# The single source of truth for what "green" means.
#
# `nix flake check` runs each step below in its own sandboxed derivation, by
# calling this script. CI runs `nix flake check`. A developer without nix runs
# `./tools/verify`. All three therefore execute the *same commands* -- which is
# the point: three lint escapes reached CI because the local loop and the flake
# checked different things.
#
# Usage:  tools/verify [step ...]      (default: all)
# Steps:  fmt clippy test no-std compile-fail conformance examples
#         kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen
#         kotlin-examples
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

CARGO_FLAGS="--offline --locked"
fail=0

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    if "$@"; then
        return 0
    fi
    echo "FAILED: $name"
    fail=1
}

step_fmt() { (cd rust && cargo fmt --all -- --check); }

step_clippy() {
    # clippy is not always installable (it is absent from Ubuntu's archive, for
    # one), and its absence must not silently mean "no lint pass". Fall back to
    # rustc's own lints over the same targets and say so out loud.
    #
    # --all-targets matters more than it looks: `cargo build` does not compile
    # test targets, so an unused import in a test file passes a plain build and
    # then fails clippy in CI. That exact gap escaped three times.
    if (cd rust && cargo clippy --version >/dev/null 2>&1); then
        (cd rust && cargo clippy --all-targets --all-features $CARGO_FLAGS -- -D warnings)
    else
        echo "note: clippy unavailable; falling back to rustc lints over the same targets"
        (cd rust && RUSTFLAGS="-D warnings" cargo check --all-targets --all-features $CARGO_FLAGS)
    fi
}

step_test() { (cd rust && cargo test --all-features $CARGO_FLAGS); }

step_no_std() {
    # Phase 1 exit criterion: the core must build without std.
    (cd rust && cargo build -p tabula --no-default-features $CARGO_FLAGS \
        --target thumbv7em-none-eabihf 2>/dev/null) && return 0
    echo "note: thumbv7em-none-eabihf target unavailable; checking --no-default-features on host"
    (cd rust && cargo build -p tabula --no-default-features $CARGO_FLAGS)
}

step_compile_fail() { ./tools/compile-fail; }

step_conformance() { (cd rust && cargo run -q -p tabula-conformance $CARGO_FLAGS); }

# Kotlin builds with `kotlinc` directly -- no Gradle, no Maven.
#
# Not a preference. Gradle needs Maven Central for the stdlib, which this
# environment cannot reach, and shipping an unrunnable build file would repeat
# the mistake of shipping unverified code. kotlinc alone is enough to prove the
# thing that matters (required-member enforcement), so that is what runs.
KOTLINC="${KOTLINC:-kotlinc}"

kotlin_available() { command -v "$KOTLINC" >/dev/null 2>&1; }

step_kotlin() {
    if ! kotlin_available; then
        echo "note: $KOTLINC not found; skipping (set KOTLINC= to point at one)"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        cd kotlin || exit 1
        "$KOTLINC" src/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        "$KOTLINC" -cp "$out/core" test/*.kt -include-runtime -d "$out/t.jar" 2>&1             | grep -v "^info:" || true
        [ -f "$out/t.jar" ] || { echo "tests failed to compile"; exit 1; }
        java -cp "$out/t.jar:$out/core" harness.MainKt
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_conformance() {
    if ! kotlin_available; then
        echo "note: $KOTLINC not found; skipping"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        cd kotlin || exit 1
        "$KOTLINC" src/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        # The fixture machines live in test/Composition.kt: they are KSP's
        # specification first and conformance fixtures second.
        "$KOTLINC" -cp "$out/core" test/Composition.kt -d "$out/comp" 2>&1 \
            | grep -v "^info:" || true
        [ -d "$out/comp" ] || { echo "composition failed to compile"; exit 1; }
        "$KOTLINC" -cp "$out/core:$out/comp" conformance/*.kt -include-runtime \
            -d "$out/c.jar" 2>&1 | grep -v "^info:" || true
        [ -f "$out/c.jar" ] || { echo "conformance failed to compile"; exit 1; }
        java -cp "$out/c.jar:$out/core:$out/comp" conformance.MainKt ../spec/conformance
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

# Proves the generator emits valid Kotlin that still enforces the guarantee.
#
# Four stages, and the last two are the point. A golden diff only proves the
# emitter is deterministic; compiling its output, then compiling a complete
# implementation and an incomplete one against that output, proves the emitted
# code still does what the design promises.
# The examples depend on tabula the way a user would -- by path, from outside
# the workspace -- so they are a separate cargo invocation, not another
# workspace member. That separation is the point: it is the only place the
# public API is exercised from outside.
step_examples() { (cd examples/rust && cargo test $CARGO_FLAGS); }

step_kotlin_examples() {
    if ! kotlin_available; then
        echo "note: $KOTLINC not found; skipping"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        cd kotlin || exit 1
        "$KOTLINC" src/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        cd ../examples/kotlin || exit 1
        "$KOTLINC" -cp "$out/core" ./*.kt -include-runtime -d "$out/ex.jar" 2>&1 \
            | grep -v "^info:" || true
        [ -f "$out/ex.jar" ] || { echo "examples failed to compile"; exit 1; }
        java -cp "$out/ex.jar:$out/core" examples.MainKt
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_codegen() {
    if ! kotlin_available; then
        echo "note: $KOTLINC not found; skipping"
        return 0
    fi
    local out gen
    out="$(mktemp -d)"
    gen="$out/emitted"
    local rc=0

    (
        cd kotlin || exit 1
        "$KOTLINC" src/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
        "$KOTLINC" -cp "$out/core" codegen/*.kt -include-runtime -d "$out/cg.jar" 2>&1 \
            | grep -v "^info:" || true
        [ -f "$out/cg.jar" ] || { echo "emitter failed to compile"; exit 1; }

        # 1. emit, and diff against the committed golden source
        java -cp "$out/cg.jar:$out/core" codegen.MainKt codegen/golden "--emit=$gen" || exit 1

        # 2. the emitted source must compile
        "$KOTLINC" -cp "$out/core" codegen/support/TimerTypes.kt codegen/support/ToggleTypes.kt \
            "$gen"/*.kt -d "$out/gen" 2>&1 | grep -v "^info:" || true
        [ -d "$out/gen" ] || { echo "emitted source does not compile"; exit 1; }
        echo "ok   emitted source compiles"

        # 3. a complete implementation must satisfy it
        "$KOTLINC" -cp "$out/core:$out/gen" codegen/support/Complete.kt -d "$out/cmp" 2>&1 \
            | grep -v "^info:" || true
        [ -d "$out/cmp" ] || { echo "a complete implementation does not compile"; exit 1; }
        echo "ok   complete implementation compiles"

        # 4. an incomplete one must not -- the guarantee, after generation
        local f exp err bad=0
        for f in codegen/compile_fail/*.kt; do
            exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
            err="$("$KOTLINC" -cp "$out/core:$out/gen" "$f" -d "$out/x" 2>&1 | grep -v "^info:")"
            if [ -z "$err" ]; then
                echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
                bad=1
            elif printf '%s' "$err" | grep -qF -- "$exp"; then
                echo "ok   $(basename "$f")"
            else
                echo "FAIL $(basename "$f")"
                echo "     expected: $exp"
                printf '%s\n' "$err" | head -3 | sed 's/^/       /'
                bad=1
            fi
        done
        exit "$bad"
    )
    rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_compile_fail() {
    if ! kotlin_available; then
        echo "note: $KOTLINC not found; skipping"
        return 0
    fi
    local out bad f exp err
    out="$(mktemp -d)"
    bad=0

    (cd kotlin && "$KOTLINC" src/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:") || true
    (cd kotlin && "$KOTLINC" -cp "$out/core" test/ReferenceTimer.kt test/Composition.kt \
        -d "$out/ref" 2>&1 | grep -v "^info:") || true

    for f in kotlin/compile_fail/*.kt; do
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        err="$("$KOTLINC" -cp "$out/core:$out/ref" "$f" -d "$out/x" 2>&1 | grep -v "^info:")"
        if [ -z "$err" ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif printf '%s' "$err" | grep -qF -- "$exp"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$out"
    return "$bad"
}

steps=("$@")
[ ${#steps[@]} -eq 0 ] && \
    steps=(fmt clippy test no-std compile-fail conformance examples \
           kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen \
           kotlin-examples)

for s in "${steps[@]}"; do
    case "$s" in
        fmt)          run fmt          step_fmt ;;
        clippy)       run clippy       step_clippy ;;
        test)         run test         step_test ;;
        no-std)       run no-std       step_no_std ;;
        compile-fail) run compile-fail step_compile_fail ;;
        conformance)  run conformance  step_conformance ;;
        examples)     run examples     step_examples ;;
        kotlin)              run kotlin              step_kotlin ;;
        kotlin-compile-fail) run kotlin-compile-fail step_kotlin_compile_fail ;;
        kotlin-conformance)  run kotlin-conformance  step_kotlin_conformance ;;
        kotlin-codegen)      run kotlin-codegen      step_kotlin_codegen ;;
        kotlin-examples)     run kotlin-examples     step_kotlin_examples ;;
        *) echo "unknown step: $s"; exit 2 ;;
    esac
done

echo
if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED"
fi
exit "$fail"
