#!/usr/bin/env bash
# The single source of truth for what "green" means.
#
# `nix flake check` runs each step below in its own sandboxed derivation, by
# calling this script. CI runs `nix flake check`. A developer without nix runs
# `./tools/verify`. All three therefore execute the *same commands* -- which is
# the point: three lint escapes reached CI because the local loop and the flake
# checked different things.
#
# Four files, one definition. This script owns the steps that read more than
# one implementation. Every other step belongs to the language that runs it,
# in tabular-center-{rust,kotlin,swift}/tools/verify, and is handed over from
# here by name -- so `./tools/verify test` still runs the Rust tests, and a
# bare `./tools/verify` still runs everything. Each language script declares
# its own steps (`--list`); nothing here repeats that list.
#
# Usage:  tools/verify [step ...]      (default: all, every language)
#         tools/verify --list          (every step, with its owner)
# Steps:  version docs matrix-covered diagnostics-coverage fixtures-complete
#         no-bless no-generated diagnostics-tested renderings-agree tb-aligned
#         + every step listed by tabular-center-*/tools/verify --list
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

fail=0
# The steps that failed, by name, for the verdict. A failure prints
# `FAILED: <step>` where it happens, and in a long run that line scrolls away
# -- the verdict names them again, as the ledger does for skips.
failed_steps=()

# A missing directory here is almost never a missing directory.
#
# `nix flake check` builds from the git tree, and on a DIRTY tree nix includes
# tracked files that were modified but EXCLUDES files that are untracked. So a
# patch applied with `git apply` rather than `git am` shows up as: the modified
# scripts are there, and every newly added directory is not.
#
# That produces `cd: examples/swift: No such file or directory` from inside a
# nix build while the directory sits plainly in the working tree, which is a
# confusing enough five minutes to be worth six lines.
require_dir() {
    [ -d "$1" ] && return 0
    echo "missing directory: $1"
    echo
    echo "  If this is a nix build and the directory exists in your working"
    echo "  tree, it is probably untracked: nix excludes untracked files from a"
    echo "  dirty tree. Commit it, or 'git add -A', or apply patches with"
    echo "  'git am' rather than 'git apply'."
    return 1
}

# The same trap as require_dir, one level down.
#
# require_dir catches a whole new directory going missing. It does not catch a
# new *file* landing in a directory that already exists -- which is what a new
# golden is. That cost a nix-build round trip: the harness reported "no golden
# cov, run with --bless" for all four fixtures while the four files sat in the
# working tree, untracked, and therefore absent from the source nix copied in.
#
# "run --bless" is the wrong advice in that situation and blessing would have
# regenerated files that already existed. Check the set up front instead, and
# say the thing that is actually true.
#
# It earns its keep twice: it also catches adding a .tbl fixture and forgetting
# to bless it, which produces the same misleading message.
RENDERINGS="grid mmd lint cov"   # produced at check time, never committed

require_fixtures() {
    local missing="" tbl name
    for tbl in spec/conformance/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        [ -f "spec/conformance/traces/$name.trace" ] \
            || missing="$missing traces/$name.trace"
    done
    if [ -z "$(echo spec/conformance/*.tbl)" ] || [ ! -e spec/conformance/timer.tbl ]; then
        echo "spec/conformance has no fixtures; the contract has evaporated"
        return 1
    fi
    [ -z "$missing" ] && return 0

    echo "fixture(s) missing a trace:"
    for f in $missing; do echo "  $f"; done
    echo
    echo '  .tbl and .trace are authored by hand: they are the contract.'
    echo "  If they exist in your working tree, they are probably untracked --"
    echo "  nix excludes untracked files from a dirty tree, so 'git apply'"
    echo "  leaves new files out of the build. 'git add -A', or use 'git am'."
    return 1
}

# Whether this run has network access.
#
# Set by the flakes' mkCheck (nix/context.nix at the root and in each
# tabular-center-*/), and by nothing else. The sandbox cannot
# reach Maven, so the one step that needs it must report `skip` with its reason
# -- ARCHITECTURE section 13 and PLAN 0a both say so, and until now the guard
# for it was `command -v gradle`, which is present IN the sandbox because
# kotlinInputs ships it. The guard tested for the wrong thing and the step
# would have failed on a missing network while claiming a missing tool.
#
# Declared rather than probed. nix knows; the script would be guessing, and the
# same reasoning already governs swiftLibraryPath and NIX_CC.
offline() { [ -n "${TABULAR_CENTER_OFFLINE:-}" ]; }

# Every skip, collected.
#
# A skip is the most dangerous line this script prints. It is not an error, so
# nothing counts it; it scrolls past in a green run; and the summary at the end
# says "all green" either way. Two separate things were skipped for months
# behind that -- the whole Kotlin suite, and the KSP example -- and in both
# cases the output looked correct.
#
# So every step's output goes through `tee` into one file, and the end of the
# run reprints whatever said `skip`. Nothing is required of the step functions,
# which is the point: a ledger that only sees the sites someone remembered to
# instrument is a ledger that lies by omission.
TALLY="$(mktemp)"
trap 'rm -f "$TALLY"' EXIT

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    # Piped, so the ledger sees the output, and PIPESTATUS because with a pipe
    # `$?` belongs to tee. Streaming is preserved -- a five-minute cargo build
    # still prints as it goes, which capture-then-print would have cost.
    "$@" 2>&1 | tee -a "$TALLY"
    local rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] && return 0
    echo "FAILED: $name"
    failed_steps+=("$name")
    fail=1
}

# VERSION is the single source of truth and every manifest is derived from it.
#
# Runs first, and checks EVERY derived copy, because the derived copies fail in
# unhelpful ways. A stale lockfile reports
#
#   error: the lock file ... needs to be updated but --locked was passed
#
# which names the lockfile and says nothing about the version bump that staled
# it. Worse, `tabular-center-rust/examples/Cargo.lock` records tabular-center's version too, so a bump
# that refreshes only the main workspace leaves exactly one step failing --
# which reads like a problem with the examples rather than with the release.
# doc/ is generated from spec/ and the code: build output, deployed by
# .github/workflows/pages.yml, never committed. What is checked is that it CAN
# be generated faithfully -- every included sample resolves and every
# diagnostic code has an anchor -- because the pages are what diagnostic
# messages link to, and a broken anchor drops a developer who followed a link
# from an error at the top of a long page.
step_docs() { ./tools/docs --check; }

step_version() {
    local want got bad=0
    want="$(cat VERSION)"

    got="$(sed -n 's/^version = "\(.*\)"$/\1/p' tabular-center-rust/Cargo.toml | head -1)"
    if [ "$want" != "$got" ]; then
        echo "VERSION says $want but tabular-center-rust/Cargo.toml says $got"
        bad=1
    fi

    # Every lockfile records tabular-center's version: the workspace's own, the
    # examples', and the GUI example's -- its own package and lock, outside the
    # examples workspace -- because they depend on it by path. The third was
    # once missed: a bump would have left it behind, and rust-gui's --locked
    # build would have failed on the next release.
    local lock
    for lock in tabular-center-rust/Cargo.lock tabular-center-rust/examples/Cargo.lock \
        tabular-center-rust/examples/05-iced/Cargo.lock; do
        [ -f "$lock" ] || continue
        if ! grep -A1 '^name = "tabular-center"$' "$lock" | grep -q "^version = \"$want\"$"; then
            echo "$lock does not record tabular-center $want"
            bad=1
        fi
    done

    if [ "$bad" -ne 0 ]; then
        echo
        echo "  to resync after a version change:"
        echo "    (cd tabular-center-rust && cargo update --workspace --offline)"
        echo "    (cd tabular-center-rust/examples && cargo update --workspace --offline)"
        echo "  and in tabular-center-rust/examples/05-iced/Cargo.lock, the version line"
        echo "  under name = \"tabular-center\" (nix run .#release does all three)"
        echo "  or to abandon it:  git checkout -- ."
        return 1
    fi
    echo "version $want, consistent across VERSION and all three Cargo.lock files"
}

# The renderings the three implementations must agree on.
#
# `.tbl` and `.trace` are the contract, authored by hand. The renderings of a
# fixture -- `.grid`, `.mmd`, `.lint`, `.cov` -- are OUTPUT, and were committed
# until September 2026: Rust blessed them and the other two compared against
# them. That made one implementation's output the expectation for the other
# two and had to be re-blessed whenever any renderer changed a character.
#
# So each implementation renders into its own directory here, and the
# directories are diffed. Nothing is committed and nothing is blessed; what is
# asserted is exactly the property the goldens were standing in for, that three
# implementations produce the same bytes.
#
# It needs at least two of them: one implementation agreeing with itself is not
# a comparison, so a run that finds only one FAILS rather than passing. That is
# also why this is one step rather than three -- no single-toolchain check can
# make this assertion at all.
step_renderings_agree() {
    require_fixtures || return 1
    local scratch present=() bad=0
    scratch="$(mktemp -d)"

    # Each implementation renders through its own tools/verify, into its own
    # directory. Which toolchains exist is each script's business; a script
    # with no toolchain prints `skip` and writes nothing, and the count below
    # is what turns "too few" into a failure.
    local lang sc
    for lang in rust kotlin swift; do
        sc="tabular-center-$lang/tools/verify"
        if [ ! -x "$sc" ]; then
            echo "skip renderings-agree ($lang: $sc not found)"
            continue
        fi
        mkdir -p "$scratch/$lang"
        if TABULAR_CENTER_NESTED=1 TABULAR_CENTER_RENDER_DIR="$scratch/$lang" "$sc" "$lang-render"; then
            if [ -n "$(ls -A "$scratch/$lang")" ]; then
                present+=("$lang")
            fi
        else
            echo "FAIL $lang could not render"
            bad=1
        fi
    done

    if [ "${#present[@]}" -lt 2 ]; then
        echo "FAIL renderings-agree needs two implementations to compare and found ${#present[@]}."
        echo "     One implementation agreeing with itself asserts nothing, so"
        echo "     this fails rather than passing on a machine with one toolchain."
        rm -rf "$scratch"
        return 1
    fi

    # Pairwise against the first present implementation: agreement is
    # transitive, and naming a reference makes the diff readable.
    local ref="${present[0]}" other f n=0
    for other in "${present[@]:1}"; do
        for f in "$scratch/$ref"/*; do
            [ -e "$f" ] || continue
            n=$((n + 1))
            if ! diff -q "$f" "$scratch/$other/$(basename "$f")" >/dev/null 2>&1; then
                echo "FAIL $(basename "$f"): $ref and $other disagree"
                diff "$scratch/$ref/$(basename "$f")" "$scratch/$other/$(basename "$f")" \
                    | head -8 | sed 's/^/       /'
                bad=1
            fi
        done
    done

    # The fixtures table in spec/diagnostics-coverage.md, checked against the
    # lints that were just rendered. It lived in `diagnostics-coverage`, which
    # read the committed `.lint` goldens; that step is text-only and stays so.
    local code langs fixtures actual
    while read -r code langs; do
        [ -n "$code" ] || continue
        actual="$(grep -l "$code" "$scratch/$ref"/*.lint 2>/dev/null \
            | sed 's|.*/||; s|\.lint$||' | sort | tr '\n' ' ')"
        actual="$(echo $actual)"
        [ -z "$actual" ] && actual="-"
        fixtures="$(echo $langs)"
        if [ "$actual" != "$fixtures" ]; then
            echo "FAIL $code: spec/diagnostics-coverage.md says fixtures [$fixtures], $ref renders [$actual]"
            bad=1
        fi
    done < <(sed -n '/^```fixtures$/,/^```$/p' spec/diagnostics-coverage.md | sed '1d;$d')

    [ "$bad" -eq 0 ] && echo "ok   ${#present[@]} implementations agree on $n renderings (${present[*]})"
    rm -rf "$scratch"
    return "$bad"
}

# This script never blesses.
#
# It is the single definition of green, and a definition of green that can
# rewrite what it compares against is not one: a step run with a bless flag
# passes by construction. The one golden set left -- spec/conformance/, the
# cross-language contract -- is authored by hand: `.tbl` and `.trace` are
# written by a person, and the renderings of them are produced by every
# implementation at check time and diffed (`renderings-agree`). Nothing in
# this repository is blessed any more; see also step_no_generated.
#
# Not hypothetical: swift-codegen briefly took a TABULA_BLESS variable. So
# this fails on any COMMAND in tools/verify or nix/ that mentions a bless flag
# or variable. Comments and printed advice ("run with --bless") are allowed;
# that is how the other steps tell a person what to do.
#
# The patterns are split so this function does not match itself.
step_no_bless() {
    local flag='--bl''ess' var='BL''ESS' hits
    hits="$(grep -nE -- "$flag|$var" tools/verify nix/*.nix \
            tabular-center-*/tools/verify tabular-center-*/nix/*.nix \
        | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' \
        | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(echo|printf)[[:space:]]')"
    if [ -n "$hits" ]; then
        echo "FAIL a check can bless -- tools/verify must only compare:"
        printf '%s\n' "$hits" | sed 's/^/       /'
        echo "     bless by calling the tool directly; see the note above step_no_bless"
        return 1
    fi
    echo "ok   no check blesses; every golden is compared, never written"
}

# Every diagnostic is tested, and tested in the right shape.
#
# The habit in CONTRIBUTING says each one gets a fixture. A habit is a promise
# nothing keeps: `unsupported-color` was documented and fixtured in the same
# patch because the author happened to remember, and nothing would have said so
# otherwise.
#
# Two kinds, from spec/diagnostics-coverage.md:
#
#   - A RUNTIME LINT is reported by a renderer, so it is tested by a
#     conformance fixture that trips it. Those are listed in the `fixtures`
#     block, and `renderings-agree` checks the list against the rendered lints;
#     here we check the fixtures named there exist at all.
#   - Every other code is a DECLARATION diagnostic: a generator refuses
#     something, so it is tested by a compile-fail fixture whose `//~ EXPECT:`
#     names the code.
#
# A code emitted by nobody (`-`) is exempt, and required to stay that way: if
# a fixture ever expects it, the `-` is a lie and this says so.
step_diagnostics_tested() {
    local dirs="tabular-center-rust/tabular-center/tests/compile_fail tabular-center-kotlin/ksp/compile-fail/fixtures"
    dirs="$dirs tabular-center-kotlin/codegen/compile_fail tabular-center-kotlin/compile_fail tabular-center-swift/macros/fixtures"
    dirs="$dirs tabular-center-swift/compile_fail tabular-center-swift/codegen-support/compile_fail"
    local doc=spec/diagnostics-coverage.md
    local code langs lint hits missing bad=0 n=0

    # shellcheck disable=SC2086
    while read -r code langs; do
        [ -n "$code" ] || continue
        n=$((n + 1))
        hits="$(grep -rh '^//~ EXPECT' $dirs 2>/dev/null | grep -c -- "$code")"
        lint="$(sed -n '/^```fixtures$/,/^```$/p' "$doc" | sed -n "s|^$code  *||p")"

        if [ "$langs" = "-" ]; then
            if [ "$hits" -ne 0 ]; then
                echo "FAIL $code is listed as emitted by nobody, and $hits fixture(s) expect it"
                bad=1
            fi
            continue
        fi

        if [ -n "$lint" ]; then
            missing=""
            for f in $lint; do
                [ -f "spec/conformance/$f.tbl" ] || missing="$missing $f"
            done
            if [ -n "$missing" ]; then
                echo "FAIL $code names conformance fixture(s) that do not exist:$missing"
                bad=1
            fi
        elif [ "$hits" -eq 0 ]; then
            echo "FAIL $code is documented and emitted, and no fixture expects it."
            echo "     A declaration diagnostic is tested by a compile-fail fixture"
            echo "     whose '//~ EXPECT:' names it. See CONTRIBUTING."
            bad=1
        fi
    done < <(sed -n '/^```coverage$/,/^```$/p' "$doc" | sed '1d;$d')

    if [ "$n" -eq 0 ]; then
        echo "FAIL the coverage block in $doc is empty; this checked nothing"
        bad=1
    elif [ "$bad" -eq 0 ]; then
        echo "ok   $n diagnostic codes, each tested by a fixture or a lint fixture"
    fi
    return "$bad"
}

# Generated code is not committed.
#
# Not as source, and not as a golden. A committed golden of emitted source is
# a second copy of the generator's output that has to be re-blessed on every
# emitter change, and it proves only that the characters did not move. What
# the emitted source must satisfy is checked from source instead: it compiles
# (kotlin-codegen, swift-codegen), a complete implementation satisfies it, an
# incomplete one is refused, emission is deterministic, and KSP's extraction
# matches hand-stated twins (kotlin-ksp).
#
# spec/conformance/ is deliberately outside this: `.grid`, `.mmd`, `.lint`
# and `.cov` are the cross-language contract, rendered data every
# implementation is held to, not code any build consumes.
#
# Build and dependency directories are skipped; nix never copies them in.
step_no_generated() {
    local hits
    hits="$(find . \( -name .git -o -name build -o -name .build -o -name target \
            -o -name .gradle -o -name node_modules \) -prune -o \
        -type f \( -name '*.golden' -o -name '*Generated.kt' -o -name '*.emitted.swift' \) \
        -print 2>/dev/null | sort)"
    if [ -n "$hits" ]; then
        echo "FAIL generated code is committed -- verify from source, not from output:"
        printf '%s\n' "$hits" | sed 's/^/       /'
        echo "     see the note above step_no_generated for what replaces a golden"
        return 1
    fi
    echo "ok   no generated code in the tree"
}

# Every fixture is complete: a table and a trace.
#
# It used to ask for the four renderings too, when those were committed. They
# are produced at check time now (`renderings-agree`), so what is left to
# check here is the pair a human authors -- and a fixture with no trace is
# still a fixture that checks a table and no behaviour.
step_fixtures_complete() {
    local d=spec/conformance
    require_dir "$d" || return 1

    local tbl name ext bad=0 n=0 missing
    for tbl in "$d"/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        n=$((n + 1))
        missing=""
        [ -f "$d/traces/$name.trace" ] || missing="$missing trace"
        # A rendering that IS committed is a golden nobody asked for.
        for ext in $RENDERINGS; do
            [ -f "$d/$name.$ext" ] && missing="$missing (committed $ext)"
        done

        if [ -n "$missing" ]; then
            echo "FAIL $name is missing:$missing"
            bad=1
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL no fixtures found in $d"
        bad=1
    elif [ "$bad" -eq 0 ]; then
        echo "ok   $n fixtures, each with a table and a trace"
    else
        echo "     A fixture is a .tbl and a .trace, both authored. The"
        echo "     renderings ($RENDERINGS) are produced at check time by"
        echo "     every implementation and diffed -- see renderings-agree."
    fi
    return "$bad"
}

# Every diagnostic code, in every implementation, matches what is written down.
#
# Nothing compared the three until this existed, and the thing nothing compared
# had already diverged: Rust emits twelve of the sixteen codes; Kotlin and
# Swift emit all sixteen. The four it omits are the language doing the work --
# `GO!(Typo)` is a path that does not resolve, and rustc's message about the
# user's own token beats a `compile_error!` about the same thing -- so the gap
# is right. It had just never been stated, and an unstated gap is one a
# refactor closes or widens without anybody deciding to.
#
# `spec/diagnostics-coverage.md` states it. This check holds the source to it
# in both directions: a code emitted but not listed, and a code listed but not
# emitted, are both failures. One-directional would have missed the case that
# matters most -- an implementation quietly losing a diagnostic.
step_diagnostics_coverage() {
    local doc="spec/diagnostics-coverage.md"
    [ -f "$doc" ] || { echo "FAILED: $doc is missing"; return 1; }

    local bad=0 code langs lang actual expected n=0

    # Quoted matches only. An unquoted `tabular_center::lint::report` is a module path,
    # not a diagnostic, and counting it would report three codes Rust does not
    # have.
    emitted() { grep -rhoE "\"tabular-center::[a-z-]+" "$1/" 2>/dev/null | tr -d '"' | sort -u; }

    local rust_codes kotlin_codes swift_codes
    rust_codes="$(emitted tabular-center-rust)"
    kotlin_codes="$(emitted tabular-center-kotlin)"
    swift_codes="$(emitted tabular-center-swift)"

    while read -r code langs; do
        [ -n "$code" ] || continue
        n=$((n + 1))
        for lang in rust kotlin swift; do
            case "$lang" in
                rust) actual="$rust_codes" ;;
                kotlin) actual="$kotlin_codes" ;;
                swift) actual="$swift_codes" ;;
            esac
            expected=no
            case " $langs " in *" $lang "*) expected=yes ;; esac
            if grep -qx "$code" <<<"$actual"; then
                if [ "$expected" = no ]; then
                    echo "FAIL $lang emits $code but $doc does not list it"
                    echo "     A new diagnostic needs a row here and a section"
                    echo "     in spec/diagnostics.md, or readers meet a code"
                    echo "     with no page behind it."
                    bad=1
                fi
            elif [ "$expected" = yes ]; then
                echo "FAIL $doc lists $code for $lang, which does not emit it"
                echo "     Either the diagnostic was lost or the table is"
                echo "     stale. Both are worth stopping for."
                bad=1
            fi
        done
    done < <(sed -n '/^```coverage$/,/^```$/p' "$doc" | sed '1d;$d')

    if [ "$n" -eq 0 ]; then
        echo "FAIL $doc has no \`\`\`coverage block, so this checked nothing"
        bad=1
    fi

    # And the table must cover spec/diagnostics.md exactly: a code documented
    # for readers but absent from the table would slip past the loop above,
    # since the loop only walks rows that exist.
    local documented
    documented="$(grep -oE 'tabular-center::[a-z-]+' spec/diagnostics.md | sort -u)"
    for code in $documented; do
        if ! sed -n '/^```coverage$/,/^```$/p' "$doc" | grep -q "^$code "; then
            echo "FAIL spec/diagnostics.md documents $code; $doc has no row for it"
            bad=1
        fi
    done

    # And the fixture table: which runtime lints a `.lint` golden trips.
    #
    # Recorded rather than required: when this was written five of seven were
    # `-`, and a check that fails on a known gap is a check people learn to
    # ignore. None are `-` now, and the check is kept for what it catches. What
    # it catches is movement in either direction: a fixture that stops tripping
    # a lint it used to, and a lint that gains coverage without the table
    # noticing. Closing a gap is then a diff here, which is the point.
    # The fixtures block of that file is checked by `renderings-agree`, which
    # has the rendered lints in hand. This step stays text-only: it needs no
    # toolchain, and a check that needs one cannot run everywhere this does.

    [ "$bad" -eq 0 ] && echo "ok   $n diagnostic codes agree across three implementations"
    return "$bad"
}

# Every `.tb.` file is covered by one of the matrix checks.
#
# The check above the other two, and the one they cannot make about
# themselves. `kotlin-matrix-stable` and `rust-matrix-stable` each scan roots
# they name, so a matrix in a directory neither names is outside both -- and
# silently so, because each scan finds what it finds and reports on that.
#
# That is not hypothetical. `kotlin-matrix-stable` scanned `tabular-center-kotlin/` alone for
# as long as it existed, and
# tabular-center-kotlin/examples/06-generated/src/Machine.tb.kt sat outside it the whole time
# while both checks were green.
#
# So this enumerates the `.tb.` files that exist and asks which scan reaches
# each one, rather than asking each scan what it found.
step_matrix_covered() {
    local f bad=0 total=0 covered=0
    local uncovered=""

    while IFS= read -r f; do
        total=$((total + 1))
        case "$f" in
            # Roots that `kotlin-matrix-stable` copies and ktlints.
            ./tabular-center-kotlin/*.tb.kt)
                covered=$((covered + 1))
                echo "ok   $f (kotlin-matrix-stable)"
                ;;
            # Roots that `rust-matrix-stable` copies and cargo-fmts.
            ./tabular-center-rust/*.tb.rs)
                covered=$((covered + 1))
                echo "ok   $f (rust-matrix-stable)"
                ;;
            *.tb.swift)
                # Covered twice, as of swift-format arriving from the same
                # nixpkgs pin as swift itself: `swift-matrix-stable` runs the
                # formatter over each of these and requires the file back
                # unchanged, and `swift-format-config` requires the
                # `// swift-format-ignore-file` that makes that true -- the
                # whole of swift-format's exemption mechanism. The second
                # holds where no toolchain exists and the first skips.
                covered=$((covered + 1))
                ;;
            *)
                uncovered="$uncovered  $f"$'\n'
                bad=1
                ;;
        esac
    done < <(find . -name '*.tb.*' \
        -not -path './.git/*' \
        -not -path '*/build/*' \
        -not -path '*/.build/*' \
        -not -path '*/target/*' | sort)

    if [ -n "$uncovered" ]; then
        echo "FAIL these matrix files are scanned by no check:"
        printf '%s' "$uncovered"
        echo "     Either move them under a root one of the matrix checks"
        echo "     names, or widen that check. A matrix no formatter check"
        echo "     reaches is one collapse away from being a list."
    fi

    if [ "$total" -eq 0 ]; then
        echo "FAIL no .tb. files found at all; the convention has evaporated"
        echo "     or this scan is looking in the wrong place."
        bad=1
    fi

    echo "matrix files: $total found, $covered covered"
    return "$bad"
}

# Every `.tb.` matrix is aligned: exactly what `tabular-center-fmt` would leave.
#
# A root step, like renderings-agree, because it reads every language's
# matrices. It compares and never writes (--check), and a file the formatter
# refuses to read fails it too: a file the tool cannot read is a file nobody
# is checking (spec/tabular-center-fmt.md). The fix for a failure is
# `nix run .#tb-fmt`, then commit what it changed.
step_tb_aligned() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip tb-aligned (\$cargo not found)"
        return 0
    fi
    require_dir tabular-center-fmt || return 1
    cargo run -q --release --offline --locked \
        --manifest-path tabular-center-fmt/Cargo.toml -- --check .
}

# The three implementations, and the `.tb.` formatter: every component with a
# tools/verify of its own, by directory suffix.
LANGS=(rust kotlin swift fmt)
ROOT_STEPS=(version docs matrix-covered diagnostics-coverage fixtures-complete no-bless no-generated diagnostics-tested renderings-agree tb-aligned)

lang_script() { echo "tabular-center-$1/tools/verify"; }

# The language script that owns a step, or nothing.
owner_of() {
    local l sc
    for l in "${LANGS[@]}"; do
        sc="$(lang_script "$l")"
        [ -x "$sc" ] || continue
        if "$sc" --list-all | grep -qx -- "$1"; then
            echo "$sc"
            return 0
        fi
    done
    return 1
}

# One step, run by the script that owns it. Its output goes through the same
# tee as every local step, so the ledger below sees its `skip` lines; it runs
# nested, so it prints no ledger or verdict of its own.
delegate() {
    local sc="$1" s="$2"
    TABULAR_CENTER_NESTED=1 "$sc" "$s" 2>&1 | tee -a "$TALLY"
    [ "${PIPESTATUS[0]}" -eq 0 ] || fail=1
}

if [ "${1:-}" = "--list" ]; then
    for s in "${ROOT_STEPS[@]}"; do printf '%-26s %s\n' "$s" tools/verify; done
    for l in "${LANGS[@]}"; do
        sc="$(lang_script "$l")"
        [ -x "$sc" ] || continue
        "$sc" --list-all | while read -r s; do printf '%-26s %s\n' "$s" "$sc"; done
    done
    exit 0
fi

steps=("$@")
if [ ${#steps[@]} -eq 0 ]; then
    steps=("${ROOT_STEPS[@]}")
    for l in "${LANGS[@]}"; do
        sc="$(lang_script "$l")"
        # A language directory without its script is a broken tree, not a
        # language that is absent: all four are always here. Failing loudly
        # is the only honest answer; see require_dir for the usual cause.
        if [ ! -x "$sc" ]; then
            require_dir "tabular-center-$l/tools" | tee -a "$TALLY"
            echo "FAILED: $sc is missing or not executable"
            fail=1
            continue
        fi
        while read -r s; do steps+=("$s"); done < <("$sc" --list)
    done
fi

for s in "${steps[@]}"; do
    case "$s" in
        version)              run version              step_version ;;
        docs)                 run docs                 step_docs ;;
        matrix-covered)       run matrix-covered       step_matrix_covered ;;
        diagnostics-coverage) run diagnostics-coverage step_diagnostics_coverage ;;
        fixtures-complete)    run fixtures-complete    step_fixtures_complete ;;
        no-bless)             run no-bless             step_no_bless ;;
        no-generated)         run no-generated         step_no_generated ;;
        diagnostics-tested)   run diagnostics-tested   step_diagnostics_tested ;;
        renderings-agree)     run renderings-agree     step_renderings_agree ;;
        tb-aligned)           run tb-aligned           step_tb_aligned ;;
        *)
            if sc="$(owner_of "$s")"; then
                delegate "$sc" "$s"
            else
                echo "unknown step: $s (tools/verify --list shows them all)"
                exit 2
            fi
            ;;
    esac
done

echo

# The ledger, before the verdict, because "all green" read on its own is what
# made two missing suites invisible. Anything listed here did not run, and a
# run with no list is the only one that means what it says.
# POSIX classes, not \s. BSD grep and sed do not understand \s, and
# this script runs without nix too, and on macOS that means BSD tools -- where
# the ledger would have silently matched nothing, which is the exact failure
# it exists to stop.
if grep -q '^[[:space:]]*skip ' "$TALLY"; then
    echo "verify: skipped ---------------------------------------------"
    grep '^[[:space:]]*skip ' "$TALLY" | sed 's/^[[:space:]]*/  /'
    echo "------------------------------------------------------------"
    echo
fi

if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED ----------------------------------------------"
    printf '  %s\n' "${failed_steps[@]}"
    echo "------------------------------------------------------------"
fi
exit "$fail"
