#!/usr/bin/env bash
# The single source of truth for what "green" means.
#
# `nix flake check` runs each step below in its own sandboxed derivation, by
# calling this script. CI runs `nix flake check`. A developer without nix runs
# `./tools/verify`. All three therefore execute the *same commands* -- which is
# the point: three lint escapes reached CI because the local loop and the flake
# checked different things.
#
# Usage:  tools/verify [step ...]      (default: all)
# Steps:  version docs fmt clippy test no-std compile-fail conformance examples
#         kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen
#         kotlin-examples kotlin-ksp kotlin-ksp-compile-fail
#         kotlin-ksp-incremental kotlin-matrix-stable rust-matrix-stable
#         matrix-covered swift-format-config diagnostics-coverage fixtures-complete
#         no-bless
#         swift swift-compile-fail swift-conformance swift-macros
#         swift-macro-support swift-examples swift-codegen
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

CARGO_FLAGS="--offline --locked"
fail=0

# A missing directory here is almost never a missing directory.
#
# `nix flake check` builds from the git tree, and on a DIRTY tree nix includes
# tracked files that were modified but EXCLUDES files that are untracked. So a
# patch applied with `git apply` rather than `git am` shows up as: the modified
# scripts are there, and every newly added directory is not.
#
# That produces `cd: examples/swift: No such file or directory` from inside a
# nix build while the directory sits plainly in the working tree, which is a
# confusing enough five minutes to be worth six lines.
require_dir() {
    [ -d "$1" ] && return 0
    echo "missing directory: $1"
    echo
    echo "  If this is a nix build and the directory exists in your working"
    echo "  tree, it is probably untracked: nix excludes untracked files from a"
    echo "  dirty tree. Commit it, or 'git add -A', or apply patches with"
    echo "  'git am' rather than 'git apply'."
    return 1
}

# The same trap as require_dir, one level down.
#
# require_dir catches a whole new directory going missing. It does not catch a
# new *file* landing in a directory that already exists -- which is what a new
# golden is. That cost a nix-build round trip: the harness reported "no golden
# cov, run with --bless" for all four fixtures while the four files sat in the
# working tree, untracked, and therefore absent from the source nix copied in.
#
# "run --bless" is the wrong advice in that situation and blessing would have
# regenerated files that already existed. Check the set up front instead, and
# say the thing that is actually true.
#
# It earns its keep twice: it also catches adding a .tbl fixture and forgetting
# to bless it, which produces the same misleading message.
GOLDEN_EXTS="grid mmd lint cov"

require_goldens() {
    local missing="" tbl name ext
    for tbl in spec/conformance/*.tbl; do
        [ -e "$tbl" ] || continue
        name="${tbl%.tbl}"
        for ext in $GOLDEN_EXTS; do
            [ -f "$name.$ext" ] || missing="$missing $name.$ext"
        done
    done
    [ -z "$missing" ] && return 0

    echo "missing golden file(s):"
    for f in $missing; do echo "  $f"; done
    echo
    echo "  If these exist in your working tree, they are probably untracked:"
    echo "  nix excludes untracked files from a dirty tree, so a patch applied"
    echo "  with 'git apply' leaves new files out of the build. Commit them, or"
    echo "  'git add -A', or apply patches with 'git am'."
    echo
    echo "  If they genuinely do not exist, the fixture has never been blessed:"
    echo "  cd rust && cargo run -p tabula-conformance -- --bless"
    return 1
}

# Whether this run has network access.
#
# Set by nix/context.nix's mkCheck, and by nothing else. The sandbox cannot
# reach Maven, so the one step that needs it must report `skip` with its reason
# -- ARCHITECTURE section 13 and PLAN 0a both say so, and until now the guard
# for it was `command -v gradle`, which is present IN the sandbox because
# kotlinInputs ships it. The guard tested for the wrong thing and the step
# would have failed on a missing network while claiming a missing tool.
#
# Declared rather than probed. nix knows; the script would be guessing, and the
# same reasoning already governs swiftLibraryPath and NIX_CC.
offline() { [ -n "${TABULA_OFFLINE:-}" ]; }

# Every skip, collected.
#
# A skip is the most dangerous line this script prints. It is not an error, so
# nothing counts it; it scrolls past in a green run; and the summary at the end
# says "all green" either way. Two separate things were skipped for months
# behind that -- the whole Kotlin suite, and the KSP example -- and in both
# cases the output looked correct.
#
# So every step's output goes through `tee` into one file, and the end of the
# run reprints whatever said `skip`. Nothing is required of the step functions,
# which is the point: a ledger that only sees the sites someone remembered to
# instrument is a ledger that lies by omission.
TALLY="$(mktemp)"
trap 'rm -f "$TALLY"' EXIT

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    # Piped, so the ledger sees the output, and PIPESTATUS because with a pipe
    # `$?` belongs to tee. Streaming is preserved -- a five-minute cargo build
    # still prints as it goes, which capture-then-print would have cost.
    "$@" 2>&1 | tee -a "$TALLY"
    local rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] && return 0
    echo "FAILED: $name"
    fail=1
}

# Both cargo workspaces. The examples sit outside the main one on purpose, and
# for a while that meant neither fmt nor clippy saw them -- which is how a line
# of trailing whitespace reached a patch that `cargo fmt --check` had passed.
step_fmt() {
    local ok=0
    (cd rust && cargo fmt --all -- --check) || ok=1
    (cd examples/rust && cargo fmt --all -- --check) || ok=1
    return "$ok"
}

# VERSION is the single source of truth and every manifest is derived from it.
#
# Runs first, and checks EVERY derived copy, because the derived copies fail in
# unhelpful ways. A stale lockfile reports
#
#   error: the lock file ... needs to be updated but --locked was passed
#
# which names the lockfile and says nothing about the version bump that staled
# it. Worse, `examples/rust/Cargo.lock` records tabula's version too, so a bump
# that refreshes only the main workspace leaves exactly one step failing --
# which reads like a problem with the examples rather than with the release.
# docs/ is generated from spec/ and GitHub Pages serves it. Checked rather than
# trusted: the pages are what diagnostic messages link to, so a stale tree means
# a developer following a link from an error reads a description of a different
# error. Same reason the conformance goldens are checked rather than blessed on
# every run.
step_docs() { ./tools/docs --check; }

step_version() {
    local want got bad=0
    want="$(cat VERSION)"

    got="$(sed -n 's/^version = "\(.*\)"$/\1/p' rust/Cargo.toml | head -1)"
    if [ "$want" != "$got" ]; then
        echo "VERSION says $want but rust/Cargo.toml says $got"
        bad=1
    fi

    # Both lockfiles record tabula's version: the workspace's own, and the
    # examples' because they depend on it by path.
    local lock
    for lock in rust/Cargo.lock examples/rust/Cargo.lock; do
        [ -f "$lock" ] || continue
        if ! grep -A1 '^name = "tabula"$' "$lock" | grep -q "^version = \"$want\"$"; then
            echo "$lock does not record tabula $want"
            bad=1
        fi
    done

    if [ "$bad" -ne 0 ]; then
        echo
        echo "  to resync after a version change:"
        echo "    (cd rust && cargo update --workspace --offline)"
        echo "    (cd examples/rust && cargo update --workspace --offline)"
        echo "  or to abandon it:  git checkout -- ."
        return 1
    fi
    echo "version $want, consistent across VERSION and both Cargo.lock files"
}

step_clippy() {
    # clippy is not always installable (it is absent from Ubuntu's archive, for
    # one), and its absence must not silently mean "no lint pass". Fall back to
    # rustc's own lints over the same targets and say so out loud.
    #
    # --all-targets matters more than it looks: `cargo build` does not compile
    # test targets, so an unused import in a test file passes a plain build and
    # then fails clippy in CI. That exact gap escaped three times.
    #
    # Both cargo workspaces, not just the main one. The examples deliberately
    # sit outside the workspace, so `cd rust && cargo clippy` never saw them --
    # and five warnings sat there until someone ran `cargo check` by hand.
    local ok=0
    if (cd rust && cargo clippy --version >/dev/null 2>&1); then
        (cd rust && cargo clippy --all-targets --all-features $CARGO_FLAGS -- -D warnings) || ok=1
        (cd examples/rust && cargo clippy --all-targets $CARGO_FLAGS -- -D warnings) || ok=1
    else
        # The fallback covers rustc's own lints (unused imports, dead code)
        # but NOT clippy-only ones. `module_inception` reached CI this way.
        # Say so loudly rather than reporting a green that means less than it
        # looks: a check whose coverage is invisible is how gaps survive.
        echo "WARNING: clippy is unavailable."
        echo "  Falling back to rustc lints over the same targets."
        echo "  clippy-only lints (module_inception, needless_range_loop, ...)"
        echo "  are NOT checked here. Run 'nix flake check' before trusting green."
        (cd rust && RUSTFLAGS="-D warnings" cargo check --all-targets --all-features $CARGO_FLAGS) || ok=1
        (cd examples/rust && RUSTFLAGS="-D warnings" cargo check --all-targets $CARGO_FLAGS) || ok=1
    fi
    return "$ok"
}

step_test() { (cd rust && cargo test --all-features $CARGO_FLAGS); }

step_no_std() {
    # Phase 1 exit criterion: the core must build without std.
    #
    # Scope worth knowing: this builds the *library* without features. It says
    # nothing about what `transition_matrix!` emits, because no machine is
    # compiled here -- and the macro emitted `$crate::lint::Payloads` for every
    # machine while `lint` is gated on `alloc`, so no machine built without
    # features for as long as PAYLOADS has existed. `step_examples` builds
    # `examples/rust/01-traffic-light` alone for exactly that reason; a
    # consumer of the macro is the only thing that can check the macro.
    #
    # The fallback is only for a genuinely missing cross target. An earlier
    # version swallowed stderr and fell back on ANY failure, which reported a
    # stale-lockfile error as "target unavailable" and sent a real bug looking
    # in the wrong place for an afternoon.
    local out rc
    out="$( (cd rust && cargo build -p tabula --no-default-features $CARGO_FLAGS \
        --target thumbv7em-none-eabihf) 2>&1 )"
    rc=$?
    [ "$rc" -eq 0 ] && return 0

    if printf '%s' "$out" | grep -qE "may not be installed|not find specification for target"; then
        echo "note: thumbv7em-none-eabihf unavailable; checking --no-default-features on host"
        (cd rust && cargo build -p tabula --no-default-features $CARGO_FLAGS)
        return $?
    fi

    printf '%s\n' "$out"
    return "$rc"
}

# A compile-fail fixture passes only if the compiler REFUSED it.
#
# Every one of these loops used to infer that from empty stderr, which is not
# the same thing. A fixture that compiles but emits a warning has non-empty
# stderr, so it fell through to the message match -- and if the warning
# happened to contain the EXPECT string, a fixture that compiled cleanly was
# reported ok. Kotlin warns about unused parameters by default and the EXPECT
# lines name members, so the two are not far apart.
#
# The exit status is the question being asked, so ask it.
step_compile_fail() { ./tools/compile-fail; }

step_conformance() {
    require_goldens || return 1
    (cd rust && cargo run -q -p tabula-conformance $CARGO_FLAGS) || return 1
    # Smoke-run table-diff. It is a documented tool with a `just` recipe and a
    # `nix run` app, and until now nothing ever executed it -- `cargo clippy
    # --all-targets` compiled it and stopped there. Its rendering is unit
    # tested; this covers the argument handling and the exit codes, which are
    # the rest of it.
    (cd rust && cargo run -q -p tabula-conformance --bin table-diff $CARGO_FLAGS -- timer) \
        >/dev/null || { echo "table-diff failed on a fixture that exists"; return 1; }
    if (cd rust && cargo run -q -p tabula-conformance --bin table-diff $CARGO_FLAGS \
        -- no-such-fixture) >/dev/null 2>&1; then
        echo "table-diff exited 0 for a fixture that does not exist"
        return 1
    fi
}

# Kotlin builds with `kotlinc` directly -- no Gradle, no Maven.
#
# Not a preference. Gradle needs Maven Central for the stdlib, which this
# environment cannot reach, and shipping an unrunnable build file would repeat
# the mistake of shipping unverified code. kotlinc alone is enough to prove the
# thing that matters (required-member enforcement), so that is what runs.
KOTLINC="${KOTLINC:-kotlinc}"

kotlin_available() { command -v "$KOTLINC" >/dev/null 2>&1; }

# Say so when kotlinc is not the version the rest of the tree is written for.
#
# The compile-fail steps match kotlinc's OWN message text, which a compiler
# release is free to reword. The flake pins kotlinc to the version the Gradle
# builds name (nix/context.nix, `kotlinVersion`), so under nix this is silent;
# a developer with a different kotlinc on PATH gets told why a fixture that
# matched in CI does not match for them, instead of reading a FAIL that looks
# like a regression. A note, not a failure: the same call `kotlin-ksp` makes
# for a Gradle that differs from the one the lock was produced with.
kotlin_version_note() {
    local want have
    want="$(sed -n 's|.*kotlin("jvm") version "\([^"]*\)".*|\1|p' \
        examples/kotlin/06-generated/build.gradle.kts 2>/dev/null | head -1)"
    have="$("$KOTLINC" -version 2>&1 | grep -oE 'kotlinc-jvm [0-9][0-9A-Za-z.-]*' \
        | awk '{print $2}' | head -1)"
    [ -n "$want" ] && [ -n "$have" ] || return 0
    if [ "$want" != "$have" ]; then
        echo "note: kotlinc is $have; the tree is written for $want."
        echo "      Fixtures below match kotlinc's own wording, which can change"
        echo "      between releases. 'nix develop .#kotlin' has the pinned one."
    fi
}

# Compile each published artifact against ONLY its declared dependencies.
#
# This is the boundary check, not just a build. `tabula-core` compiled with an
# empty classpath proves it needs nothing -- no annotations, no codegen, no
# coroutines -- which is the zero-runtime-dependency rule enforced by
# construction rather than by a dependency report. `tabula-annotations` is
# compile-time only and must not reach for the runtime. `tabula-testing` may
# use core and nothing else.
#
# Run from the `kotlin/` directory.
# The classpath the artifacts compile to. Derived rather than exported,
# because `kotlin_artifacts` is sometimes called inside a subshell and a
# variable set there does not survive.
kotlin_cp() { echo "$1/core:$1/annotations:$1/testing"; }

kotlin_artifacts() {
    local out="$1"
    "$KOTLINC" core/dev/tabula/*.kt -d "$out/core" 2>&1 | grep -v "^info:" || true
    [ -d "$out/core" ] || { echo "tabula-core failed to compile"; return 1; }

    "$KOTLINC" annotations/dev/tabula/*.kt -d "$out/annotations" 2>&1 | grep -v "^info:" || true
    [ -d "$out/annotations" ] || { echo "tabula-annotations failed to compile"; return 1; }

    "$KOTLINC" -cp "$out/core" testing/dev/tabula/testing/*.kt -d "$out/testing" 2>&1 \
        | grep -v "^info:" || true
    [ -d "$out/testing" ] || { echo "tabula-testing failed to compile"; return 1; }

    # A classpath, not a merged directory. Each module writes its own
    # META-INF/main.kotlin_module, so copying them into one place silently
    # clobbers the metadata that top-level functions live in -- `report` then
    # resolves at compile time and vanishes at use.
    return 0
}

step_kotlin() {
    if ! kotlin_available; then
        echo "skip kotlin (\$KOTLINC not found; set KOTLINC= to point at one)"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        require_dir kotlin || exit 1
        cd kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        "$KOTLINC" -cp "$KCP" test/*.kt -include-runtime -d "$out/t.jar" 2>&1             | grep -v "^info:" || true
        [ -f "$out/t.jar" ] || { echo "tests failed to compile"; exit 1; }
        java -cp "$out/t.jar:$KCP" harness.MainKt
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_conformance() {
    if ! kotlin_available; then
        echo "skip kotlin-conformance (\$KOTLINC not found)"
        return 0
    fi
    require_goldens || return 1
    local out
    out="$(mktemp -d)"
    (
        require_dir kotlin || exit 1
        cd kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        # The fixture machines live in test/Composition.kt: they are KSP's
        # specification first and conformance fixtures second.
        "$KOTLINC" -cp "$KCP" test/Composition.kt -d "$out/comp" 2>&1 \
            | grep -v "^info:" || true
        [ -d "$out/comp" ] || { echo "composition failed to compile"; exit 1; }
        "$KOTLINC" -cp "$KCP:$out/comp" conformance/*.kt -include-runtime \
            -d "$out/c.jar" 2>&1 | grep -v "^info:" || true
        [ -f "$out/c.jar" ] || { echo "conformance failed to compile"; exit 1; }
        java -cp "$out/c.jar:$KCP:$out/comp" conformance.MainKt ../spec/conformance
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

# Proves the generator emits valid Kotlin that still enforces the guarantee.
#
# Four stages, and the last two are the point. A golden diff only proves the
# emitter is deterministic; compiling its output, then compiling a complete
# implementation and an incomplete one against that output, proves the emitted
# code still does what the design promises.
# The examples depend on tabula the way a user would -- by path, from outside
# the workspace -- so they are a separate cargo invocation, not another
# workspace member. That separation is the point: it is the only place the
# public API is exercised from outside.
step_examples() {
    require_dir examples/rust || return 1
    # A workspace of four member crates now, not one crate of four modules.
    # `cargo test` covers every member, including the tests/ directories the
    # split moved them into.
    (cd examples/rust && cargo test $CARGO_FLAGS) || return 1
    # 01-traffic-light takes tabula with no features at all. Building it under
    # the workspace does not prove that: cargo unifies features across members,
    # so 02's `alloc` would be enabled for everyone. Built alone, it is the
    # only place `--no-default-features` is checked through the macro rather
    # than through the library's own surface.
    (cd examples/rust && cargo test -p traffic-light $CARGO_FLAGS) || return 1
    # And run the one example that has something to show. A driver is a loop;
    # a loop nobody has watched is a loop nobody has watched.
    (cd examples/rust && cargo run -q -p retry $CARGO_FLAGS) >/dev/null || return 1
}

step_kotlin_examples() {
    if ! kotlin_available; then
        echo "skip kotlin-examples (\$KOTLINC not found)"
        return 0
    fi
    local out
    out="$(mktemp -d)"
    (
        require_dir kotlin || exit 1
        cd kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        [ -d "$out/core" ] || { echo "core failed to compile"; exit 1; }
        cd ../examples/kotlin || exit 1

        # The harness once, shared by every example's tests.
        "$KOTLINC" harness/Check.kt -d "$out/harness" 2>&1 | grep -v "^info:" || true
        [ -d "$out/harness" ] || { echo "the example harness failed to compile"; exit 1; }

        # Each example is compiled on its own, and its tests are compiled
        # afterwards against its output rather than alongside it. That is what
        # `tests/` buys in cargo and what a `mod tests` at the bottom of a file
        # gives away: a test that compiles in the same unit can reach anything,
        # so it never demonstrates that the example's public surface is usable.
        #
        # The fourth column is the classpath, and it is the configuration axis.
        # 01 is built against `core` ALONE -- no annotations, no testing module
        # -- because the minimum a machine needs is a claim worth checking, and
        # a shared classpath checks it for nobody. The Rust half of this
        # restructure found a real bug the same way.
        ex() {
            local dir="$1" main="$2" label="$3" cp="$4"
            "$KOTLINC" -cp "$cp" "$dir"/src/*.kt -d "$out/$dir" 2>&1 \
                | grep -v "^info:" || true
            [ -d "$out/$dir" ] || { echo "$label failed to compile"; return 1; }
            # The test unit is a jar with `-include-runtime`, which is where
            # the Kotlin stdlib comes from. There is no KOTLIN_HOME to point
            # `java` at here, and the previous single-jar build got the stdlib
            # the same way without it being obvious.
            "$KOTLINC" -cp "$cp:$out/$dir:$out/harness" "$dir"/test/*.kt \
                -include-runtime -d "$out/$dir-test.jar" 2>&1 | grep -v "^info:" || true
            [ -f "$out/$dir-test.jar" ] || { echo "$label tests failed to compile"; return 1; }
            java -cp "$out/$dir-test.jar:$out/$dir:$out/harness:$cp" "$main" || return 1
        }

        ex 01-traffic-light TrafficLightTestKt "traffic-light" "$out/core" || exit 1
        ex 02-timer         TimerTestKt        "timer"         "$KCP"       || exit 1
        ex 03-retry         RetryTestKt        "retry"         "$KCP"       || exit 1
        ex 04-login         LoginTestKt        "login"         "$KCP"       || exit 1
        # The suspending driver, built against `core` alone -- which is the
        # zero-dependency claim demonstrated rather than asserted. If
        # SuspendDriver needed kotlinx.coroutines, this line would fail.
        ex 05-suspend       SuspendTestKt      "suspend"       "$out/core"  || exit 1

        # 06-generated is not built here. It is the only Kotlin example that
        # needs Gradle and an artifact set, so it has its own step --
        # `kotlin-ksp` below -- and a failure there reads as the processor
        # being broken rather than as an example being broken.
    )
    local rc=$?
    rm -rf "$out"
    return "$rc"
}

# Does this SwiftPM ship `CompilerPluginSupport`?
#
# The single fact that decides how much of the macro package can exist. With
# it, `Package.swift` declares a `.macro` target, `pending/Machine.swift` goes
# back, and `swift-macro-testing` becomes available -- which is the only way to
# check that a diagnostic reaches the user attached to a source position, the
# one property Swift's fixtures cannot reach today.
#
# A four-line probe package rather than looking for a file in the store,
# because the store path is a nixpkgs implementation detail and the question is
# "will a manifest importing this compile". Ask the toolchain, not the
# filesystem.
#
# Reported, never failed. The answer is a property of the toolchain and no
# commit can change it, so a red check here would be permanent noise on the
# platforms that have Swift at all -- the same reasoning as `swift-unavailable`
# in nix/checks.nix.
step_swift_macro_support() {
    if ! command -v "$SWIFT" >/dev/null 2>&1; then
        echo "skip swift-macro-support (\$SWIFT not found)"
        return 0
    fi

    local probe
    probe="$(mktemp -d)"
    mkdir -p "$probe/Sources/probe"
    : > "$probe/Sources/probe/probe.swift"
    cat > "$probe/Package.swift" <<'PROBE'
// swift-tools-version: 5.9
import CompilerPluginSupport
import PackageDescription

let package = Package(
    name: "probe",
    targets: [.target(name: "probe")]
)
PROBE

    local out
    out="$( (cd "$probe" && "$SWIFT" package dump-package 2>&1) )"
    local rc=$?
    rm -rf "$probe"

    # WHICH ManifestAPI, before anything else.
    #
    # `swiftPkgs` carries the augmented SwiftPM, which puts its `bin` on PATH
    # and does not change where `swift build` looks for the manifest API. The
    # loader names that directory on every failure, so it is worth naming on
    # success too -- the alternative is reading `ok` and assuming, which is
    # what happened: this check reported green against the ORIGINAL SwiftPM for
    # two rounds, because a skip passes.
    local api
    api="$(printf '%s' "$out" | sed -n 's|.*"-I", "\([^"]*ManifestAPI\)".*|\1|p' | head -1)"
    [ -n "$api" ] && echo "note: manifest API: $api"

    if [ "$rc" -eq 0 ]; then
        echo "ok   CompilerPluginSupport is available"
        echo "     The .macro target can be restored: see swift/macros/Package.swift"
        echo "     and pending/Machine.swift. PLAN 0e covers what that unblocks."
        return 0
    fi

    case "$out" in
        *"macros are not supported in this compiler"*)
            # A deeper blocker than the manifest one, and a different layer.
            # `CompilerPluginSupport` was SwiftPM: it decides whether a
            # `.macro` TARGET can be declared. This is swiftc itself, built
            # without macro support, so `macro Machine() = #externalMacro(...)`
            # cannot be declared at all -- no manifest change reaches it.
            #
            # Everything up to here now works: the manifest loads, the `.macro`
            # target resolves, `MachineMacro.swift` compiles and `TabulaMacros`
            # links. The declaration is the only thing that cannot.
            echo "skip swift-macros (this swiftc is built without macro support:"
            echo "     'macros are not supported in this compiler'. SwiftPM can"
            echo "     now declare a .macro target -- see"
            echo "     nix/swiftpm-plugin-support.nix -- but the compiler cannot"
            echo "     compile a macro declaration. pending/ holds both files.)"
            return 0
            ;;
        *"no such module 'CompilerPluginSupport'"*)
            case "$api" in
                *plugin-support*)
                    # The augmented SwiftPM is in use and the module is STILL
                    # missing. A broken derivation, not a toolchain without the
                    # feature, and the two must not report alike.
                    echo "FAIL the augmented SwiftPM is in use and the module is"
                    echo "     still missing: $api"
                    echo "     nix build .#swiftpm-plugin-support, then check"
                    echo "     result/lib/swift/pm/ManifestAPI"
                    return 1
                    ;;
            esac
            echo "skip swift-macro-support (this SwiftPM does not ship"
            echo "     CompilerPluginSupport, so no .macro target can be declared."
            echo "     $("$SWIFT" --version 2>/dev/null | head -1))"
            return 0
            ;;
    esac

    # Anything else is the probe itself being wrong, which is worth knowing:
    # a probe that fails for an unrelated reason would answer "no" forever.
    echo "FAIL swift-macro-support -- the probe failed for an unexpected reason"
    printf '%s\n' "$out" | head -5 | sed 's/^/       /'
    return 1
}

# A change to `S` reprocesses the machines that depend on it.
#
# PLAN's last open KSP item, and the one that cannot be checked by building
# once. KSP caches per-round and tracks which sources a processor read; if
# `TabulaProcessor` does not declare the sealed hierarchy as a dependency of
# what it writes, a second build after editing `Types.kt` reuses the first
# build's output. The dispatcher then describes a machine that no longer
# exists, and nothing says so -- the build is green and the generated file is
# stale.
#
# The edit is made to `Types.kt` and NOT to the annotated file, which is the
# whole point: editing the matrix obviously reprocesses it. `Locked` gains a
# payload, so `PAYLOADS` in the generated output must change from `emptyList()`
# to naming the field. A processor with correct dependency tracking emits the
# new line; one without emits the old file.
#
# In a scratch copy, because it deliberately breaks the example and the example
# has to stay buildable for `kotlin-ksp`.
step_kotlin_ksp_incremental() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp-incremental (\$gradle not found)"
        return 0
    fi
    if [ -z "${TABULA_MAVEN_REPO:-}" ] && offline; then
        echo "skip kotlin-ksp-incremental (no locked artifact set; run"
        echo "     'nix run .#gradle-lock' with network and commit it)"
        return 0
    fi
    require_dir examples/kotlin/06-generated || return 1

    local scratch rc bad=0 gen
    scratch="$(mktemp -d)"
    mkdir -p "$scratch/examples" "$scratch/kotlin"

    # `examples/kotlin` whole, for the reason `kotlin/` is copied whole one
    # line below. Copying only `06-generated` left `:compileTestKotlin`
    # failing: the example's test source set reaches `../harness/Check.kt`,
    # the assertion helper every Kotlin example shares. A relative path out of
    # the directory being copied is invisible until the copy is built, and
    # this check exists precisely to build a copy.
    cp -r examples/kotlin "$scratch/examples/kotlin"
    # The whole `kotlin/` tree, not four directories out of it.
    #
    # Naming a subset means knowing every path the example and the processor
    # reach through, and those are relative paths spread across three build
    # files. The tree is small and the copy is cheap; guessing which parts
    # matter is how the first run of this check died with nothing to say.
    rmdir "$scratch/kotlin"
    cp -r kotlin "$scratch/kotlin"
    chmod -R u+w "$scratch"

    local ex="$scratch/examples/kotlin/06-generated"

    # Output kept, not discarded.
    #
    # The first version sent both builds to /dev/null, reasoning that
    # `kotlin-ksp` already covers whether the example builds. It does -- in the
    # SOURCE TREE. Here the example is a copy at a different depth, and
    # `settings.gradle.kts` reaches its processor through
    # `includeBuild("../../../kotlin/ksp")`, so anything the layout gets wrong
    # shows up only here. Reporting "the first build failed" with no log left
    # this check unable to explain its own failure.
    local first
    first="$( (cd "$ex" && gradle --no-daemon --console=plain build 2>&1) )"
    if [ $? -ne 0 ]; then
        echo "FAIL the first build failed, before any edit was made."
        echo "     If kotlin-ksp passed, this is about the scratch copy's"
        echo "     layout. If kotlin-ksp failed too, it is the example, and"
        echo "     that check has the better message -- read it first."
        # `e:` lines first, and separately.
        #
        # Kotlin writes its diagnostics as `e: file:line:col: message` and
        # Gradle writes a summary that says only "Compilation error. See log
        # for more details". A grep for "error" matches the summary, which is
        # nearer the end, so `head` kept the useless half and dropped the
        # useful one -- this check reported a failure whose cause was in the
        # output it discarded.
        printf '%s\n' "$first" | grep -E "^\s*(e|w): " | head -15 | sed 's/^/       /'
        printf '%s\n' "$first" | grep -iE "what went wrong" -A4 | head -8 | sed 's/^/       /'
        rm -rf "$scratch"
        return 1
    fi

    gen="$(find "$ex/build/generated" -name 'TurnstileGenerated.kt' | head -1)"
    if printf '%s' "$(cat "$gen")" | grep -q "since"; then
        echo "FAIL the first build already mentions \`since\`; the fixture is wrong"
        rm -rf "$scratch"
        return 1
    fi

    # The edit. `Types.kt` only.
    sed -i 's|    data object Locked : S|    data class Locked(val since: Long) : S|' \
        "$ex/src/Types.kt"

    local second
    second="$( (cd "$ex" && gradle --no-daemon --console=plain build 2>&1) )"
    rc=$?

    gen="$(find "$ex/build/generated" -name 'TurnstileGenerated.kt' | head -1)"
    if [ -z "$gen" ]; then
        echo "FAIL no generated file after the second build"
        bad=1
    elif grep -q "since" "$gen"; then
        echo "ok   a change to S reprocessed the machine"
    else
        echo "FAIL the generated file is stale: \`Locked\` gained a payload and"
        echo "     PAYLOADS does not mention it. KSP reused the first build's"
        echo "     output, so the processor is not declaring the sealed"
        echo "     hierarchy as a dependency of what it writes."
        if [ "$rc" -ne 0 ]; then
            echo "     (the second build also failed, rc=$rc)"
            printf '%s\n' "$second" | grep -E "^\s*(e|w): " | head -15 | sed 's/^/       /'
            printf '%s\n' "$second" | grep -iE "what went wrong" -A4 | head -8 | sed 's/^/       /'
        fi
        bad=1
    fi

    rm -rf "$scratch"
    return "$bad"
}

# The annotation processor's diagnostics, as a user meets them.
#
# `codegen/Tests.kt` already drives `buildDesc` directly and asserts on every
# code. What nothing exercised is the step after: the processor catching a
# `TabulaError` and turning it into a `KSPLogger.error` that fails a real
# compilation. Those are different pieces of code and only one had a test.
#
# The Rust half of this has existed since the beginning -- `tools/compile-fail`
# with `//~ EXPECT:` lines -- and this is deliberately the same shape, down to
# the comment syntax, so a contributor who has read one has read both.
#
# No new dependency. KSP compile-testing as a library would mean an embedded
# Kotlin compiler in nix/gradle-lock.json and a re-lock; this reuses the two
# plugins the example already resolves, so the lock covers it unchanged.
step_kotlin_ksp_compile_fail() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp-compile-fail (\$gradle not found)"
        return 0
    fi
    if [ -z "${TABULA_MAVEN_REPO:-}" ] && offline; then
        echo "skip kotlin-ksp-compile-fail (no locked artifact set; run"
        echo "     'nix run .#gradle-lock' with network and commit it)"
        return 0
    fi
    require_dir kotlin/ksp/compile-fail/fixtures || return 1

    local dir name expect src out bad=0 n=0
    for dir in kotlin/ksp/compile-fail/fixtures/*/; do
        [ -d "$dir" ] || continue
        name="$(basename "$dir")"
        n=$((n + 1))

        # Across every file in the fixture, and exactly one.
        #
        # `head -1` would have worked here and been wrong tomorrow: a fixture
        # is more than one file -- the matrix lives in a `.tb.kt` and the types
        # beside it -- so which EXPECT wins would have depended on filename
        # order. Two EXPECT lines is a fixture asserting two things and
        # checking one.
        local expects count
        # The file carrying the EXPECT line is the one the diagnostic should
        # point at, so it is remembered rather than rediscovered.
        src="$(grep -l '^//~ EXPECT: ' "$dir"/*.kt 2>/dev/null | head -1)"
        expects="$(sed -n 's|^//~ EXPECT: ||p' "$dir"/*.kt 2>/dev/null)"
        count="$(printf '%s\n' "$expects" | grep -c .)"
        if [ "$count" -eq 0 ]; then
            echo "FAIL $name -- no '//~ EXPECT:' line in any file"
            bad=1
            continue
        elif [ "$count" -gt 1 ]; then
            echo "FAIL $name -- $count '//~ EXPECT:' lines; a fixture asserts one thing"
            bad=1
            continue
        fi
        expect="$expects"

        out="$( (cd kotlin/ksp/compile-fail && gradle --no-daemon --console=plain \
            -PtabulaFixture="$name" build 2>&1) )"
        local rc=$?

        # The exit status first, for the reason tools/compile-fail records: a
        # fixture that COMPILES but warns has non-empty output, and a warning
        # containing the expected text would report a passing build as ok.
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $name -- compiled, but was expected to fail"
            bad=1
        elif ! printf '%s' "$out" | grep -qF -- "$expect"; then
            echo "FAIL $name -- failed, but not with \`$expect\`"
            printf '%s' "$out" | grep -iE "^e:|error:" | head -3 | sed 's/^/       /'
            bad=1
        elif ! printf '%s' "$out" | grep -qF -- "$(basename "$src")"; then
            # The position, not just the message.
            #
            # PLAN asks for diagnostics "via KSPLogger.error with node
            # positions", and the message alone cannot tell the two apart:
            # `logger.error(msg, decl)` and `logger.error(msg)` print the same
            # text, and only the first prefixes the file and line. A user
            # reading `tabula::row-arity` with no location has to find the
            # matrix themselves, which for a generated dispatcher means
            # guessing which of several machines it came from.
            #
            # Checking for the fixture's own filename is the cheap proof that a
            # node was attached at all.
            echo "FAIL $name -- reported \`$expect\` with no source position"
            echo "       expected the message to name $(basename "$src");"
            echo "       KSPLogger.error was probably called without its node."
            printf '%s' "$out" | grep -iE "^e:" | head -3 | sed 's/^/       /'
            bad=1
        else
            echo "ok   $name ($expect, positioned)"
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL no fixtures in kotlin/ksp/compile-fail/fixtures"
        bad=1
    fi
    return "$bad"
}

# The annotation processor, running.
#
# 06-generated is the only example whose dispatcher nobody wrote: its matrix is
# declared in annotations and KSP turns them into the dispatcher, the `Cells`
# interface and the effect-handler surface, into build/generated/ksp/. Nothing
# generated is committed, which is why this cannot fall back to kotlinc the way
# every other example does -- without the processor there is no `Cells` for
# src/Impl.kt to implement.
#
# Three ways to run, and the first is the one that made this stop being a skip:
#
#   TABULA_MAVEN_REPO set -> resolve offline from that directory. nix builds it
#     from nix/gradle-lock.json and nix/checks.nix points here at it.
#   unset, online        -> the real repositories. ci.yml's check-no-nix job,
#     and a developer with network.
#   unset, offline       -> skip, with the reason.
step_kotlin_ksp() {
    if ! command -v gradle >/dev/null 2>&1; then
        echo "skip kotlin-ksp (no gradle; see kotlin/ksp/README.md)"
        return 0
    fi
    require_dir examples/kotlin/06-generated || return 1

    local args=(--no-daemon --console=plain)

    if [ -n "${TABULA_MAVEN_REPO:-}" ]; then
        # The lock records the Gradle that produced it. A different one can
        # legitimately want a different artifact set, and when it does the
        # failure is `Could not find <artifact>` against a directory that looks
        # complete -- a resolution error with no hint that the cause is a
        # version skew. Warn rather than fail: the sets usually overlap, and a
        # build that works should not be blocked by a metadata mismatch.
        if [ -f nix/gradle-lock.json ] && command -v jq >/dev/null 2>&1; then
            local locked_with here
            locked_with="$(jq -r '.gradle // "unknown"' nix/gradle-lock.json)"
            here="$(gradle --version 2>/dev/null | awk '/^Gradle /{print $2; exit}')"
            if [ -n "$here" ] && [ "$locked_with" != "unknown" ] && \
               [ "$locked_with" != "$here" ]; then
                echo "note: lock was produced by gradle $locked_with, running $here"
                echo "      if resolution fails below, re-lock: nix run .#gradle-lock"
            fi
        fi

        # No --offline, deliberately.
        #
        # It reads like the right flag and it is the wrong one: Gradle's
        # offline mode does not mean "do not use the network", it means
        # "resolve from the dependency cache and nothing else". Every external
        # repository is wrapped so it refuses, and a `maven { url = file:// }`
        # repository is an external repository -- so the flag that looks like
        # it enforces this setup is the one that breaks it, with
        # `No cached version of ... available for offline mode` against a
        # directory sitting right there holding the artifact.
        #
        # Nothing is needed in its place. The repository list has been replaced
        # by one local directory, so there is no remote left to try, and every
        # version is pinned so nothing goes looking for metadata. The sandbox
        # has no route either way, and refuses immediately rather than hanging.
        echo "note: resolving offline from $TABULA_MAVEN_REPO"
    elif offline; then
        echo "skip kotlin-ksp (no locked artifact set: run 'nix run .#gradle-lock'"
        echo "     on a machine with network and commit nix/gradle-lock.json)"
        return 0
    else
        echo "note: resolving from the network"
    fi

    (cd examples/kotlin/06-generated && gradle "${args[@]}" build) || return 1
    echo "ok   generated (ksp)"

    # Every golden in kotlin/ksp/golden/, not one named file.
    #
    # It looked for `TurnstileGenerated.kt` by name, so `Gate` -- the suspend
    # machine that exists to prove prototype modifiers are COPIED rather than
    # enumerated -- could have been added with a golden nothing compared. A
    # check that hardcodes what it checks grows stale the moment the thing it
    # checks grows a sibling.
    #
    # The build succeeding proves `Cells` has members `Impl.kt` can override
    # and that `step` type-checks. It proves nothing about the table: rows read
    # in the wrong order, an effect dropped from a GO cell, `initial` resolved
    # to the wrong state -- all compile, and `TABLE` and `PAYLOADS` are inert
    # data the example never reads.
    local golden name gen bad=0 n=0
    for golden in kotlin/ksp/golden/*.kt.golden; do
        [ -e "$golden" ] || continue
        name="$(basename "$golden" .golden)"
        n=$((n + 1))

        # Located by name rather than by path: KSP's output directory has moved
        # between versions, and a hardcoded path that stops matching would make
        # this silently check nothing.
        gen="$(find examples/kotlin/06-generated/build/generated \
            -name "$name" -type f 2>/dev/null | head -1)"

        if [ -z "$gen" ]; then
            echo "FAIL the build succeeded but no $name was emitted."
            echo "     Look under build/generated/ -- KSP wrote somewhere"
            echo "     unexpected, or the machine is no longer declared."
            bad=1
        elif diff -u "$golden" "$gen"; then
            echo "ok   $name matches golden"
        else
            echo
            echo "FAIL $name does not match $golden."
            echo "     Read the diff before re-blessing -- see that"
            echo "     directory's README for which diffs mean what."
            bad=1
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL no goldens in kotlin/ksp/golden/; this checked nothing"
        bad=1
    fi
    return "$bad"
}

# Swift builds with SwiftPM. Unlike Kotlin there is no build-system problem
# here -- nixpkgs ships a Swift toolchain for Linux, so `nix develop .#swift`
# is enough.
SWIFT="${SWIFT:-swift}"
SWIFTC="${SWIFTC:-swiftc}"

swift_available() { command -v "$SWIFT" >/dev/null 2>&1; }

# SwiftPM wants a writable HOME for its caches and fails outright without one
# in a sandbox. Shared by both swift steps: `swift-compile-fail` originally had
# its own setup, lacked this, and reported the resulting silent build failure
# as "could not locate the built Tabula module" -- a message about the symptom
# two steps downstream of the cause.
swift_home() {
    local scratch="$1"
    export HOME="${HOME:-$scratch/home}"
    [ -w "$HOME" ] || export HOME="$scratch/home"
    mkdir -p "$HOME"
}

# SwiftPM's per-user directories, which it locates from the *passwd* entry
# rather than $HOME -- in a nix sandbox that is /var/empty, and it warns twice
# per invocation about not being able to write there. These flags point it
# somewhere writable instead. Two warnings in every log is how warnings stop
# being read.
swift_paths() {
    local scratch="$1"
    printf '%s' "--scratch-path $scratch/build --cache-path $scratch/cache \
--config-path $scratch/config --security-path $scratch/security"
}

step_swift() {
    if ! swift_available; then
        echo "skip swift (\$SWIFT not found; nix develop .#swift provides it)"
        return 0
    fi
    require_dir swift || return 1
    # Report the version. nixpkgs pins an older Swift than swift.org ships, and
    # a tools-version above the toolchain is a hard refusal -- worth seeing in
    # the log before reading a wall of compiler errors.
    # Which swiftc, not just which version. `swift-unwrapped` shadowing
    # `swift-wrapper` on PATH cost a round, and the two are indistinguishable
    # from the version string alone.
    echo "note: $(command -v "$SWIFTC")"
    "$SWIFT" --version 2>&1 | head -1 | sed 's/^/note: /'

    # SwiftPM wants a writable HOME for its caches and warns twice per run
    # without one. The sandbox has none; give it a scratch directory rather
    # than letting two warnings sit in every log until they are ignored.
    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local out rc
    # The built binary links against libdispatch and friends, and nothing puts
    # the Swift runtime where the loader will find it:
    #
    #   error while loading shared libraries: libdispatch.so
    #
    # nix supplies LD_LIBRARY_PATH -- it knows where every package in the
    # toolchain is, and the script would be guessing. `swiftc
    # -print-target-info` is appended as a fallback for a non-nix toolchain,
    # but it reports MODULE search paths and on nixpkgs does not contain
    # libdispatch at all, which is why it was not enough on its own.
    # ALL of the paths print-target-info reports, not just the first. The
    # runtime is spread across several directories and libdispatch is not
    # necessarily in the one that happens to come first.
    local info extra
    info="$("$SWIFTC" -print-target-info 2>/dev/null || true)"
    extra="$(printf '%s' "$info" | jq -r '
        [ (.paths.runtimeLibraryPaths // [])[],
          (.paths.runtimeLibraryImportPaths // [])[],
          (.paths.runtimeResourcePath // empty) ] | .[]' 2>/dev/null || true)"
    local d
    while IFS= read -r d; do
        [ -n "$d" ] && [ -d "$d" ] && \
            export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$d"
    done <<< "$extra"

    # Say up front whether the runtime is actually reachable. A missing shared
    # library is otherwise reported by the loader, after a successful build,
    # in a message that looks like the build failed.
    local found=""
    local dir
    IFS=':' read -ra __dirs <<< "${LD_LIBRARY_PATH:-}"
    for dir in "${__dirs[@]}"; do
        [ -n "$dir" ] && [ -e "$dir/libdispatch.so" ] && { found="$dir"; break; }
    done
    # Last resort: the corelibs are somewhere under the toolchain's resource
    # path even when no advertised directory lists them. Searching beats
    # failing with a message that only says what is missing.
    if [ -z "$found" ]; then
        local resource hit
        resource="$(printf '%s' "$info" | jq -r '.paths.runtimeResourcePath // empty' 2>/dev/null || true)"
        for dir in "$resource" "${resource%/*}" "${resource%/*/*}"; do
            [ -n "$dir" ] && [ -d "$dir" ] || continue
            hit="$(find "$dir" -maxdepth 4 -name libdispatch.so -print -quit 2>/dev/null || true)"
            if [ -n "$hit" ]; then
                found="$(dirname "$hit")"
                export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$found"
                break
            fi
        done
    fi

    if [ -n "$found" ]; then
        echo "note: swift runtime at $found"
    else
        echo "note: libdispatch.so is not on LD_LIBRARY_PATH, and was not found"
        echo "      under the toolchain's resource path either. On nixpkgs the"
        echo "      corelibs are separate derivations from the swift wrapper;"
        echo "      see swiftCorelibs in nix/context.nix."
    fi

    # `swift run`, not `swift test`: nixpkgs' Swift does not ship XCTest, so
    # the checks are a plain executable with their own assertion harness.
    #
    # Release, not debug: emitting debug info failed with
    # `emit-module command failed` on the same missing-glibc warning that has
    # dogged this toolchain, and release skips the AST-wrapping step that
    # needs it. The checks do not care about debug info.
    # SwiftPM's own flags go BEFORE the executable name. Everything after it is
    # passed to the program, so `swift run tabula-check --scratch-path X` hands
    # `--scratch-path` to tabula-check and leaves swiftpm using its defaults --
    # which is why the /var/empty warnings survived being "fixed".
    #
    # shellcheck disable=SC2046  # word splitting is what swift_paths is for
    out="$( (cd swift && "$SWIFT" run -c release $(swift_paths "$scratch") tabula-check) 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    rm -rf "$scratch"

    # A triple mismatch reads like a missing module. Say what it actually is,
    # because the message sends you looking for the wrong thing.
    if printf '%s' "$out" | grep -q "could not find module .* for target"; then
        echo
        echo "  This is a target-triple mismatch, not a missing module."
        echo "  See the note on swiftPkgs in nix/context.nix, and ARCHITECTURE"
        echo "  section 13 on nixpkgs' Linux Swift being best-effort."
    fi
    if printf '%s' "$out" | grep -q "cannot open shared object file"; then
        echo
        echo "  The build succeeded; only the loader failed. See the note"
        echo "  above: if libdispatch.so was not found, LD_LIBRARY_PATH is the"
        echo "  thing to fix, and inside 'nix develop .#swift' it is set for"
        echo "  you by nix/context.nix."
    fi
    return "$rc"
}

# Every diagnostic and every guarantee gets a fixture that must FAIL to
# compile. Swift's counterpart of tools/compile-fail and the Kotlin step.
#
# `swiftc -typecheck` against the built module rather than `swift build`: the
# fixtures must not be part of a target, or the package itself would stop
# building.
# The macro package, which is expected not to build almost everywhere.
#
# It exists as a step so its absence is *reported* rather than discovered. The
# alternative is what happened before this: someone runs `swift build` in
# swift/macros and gets a screenful of swiftc invocation ending in `no such
# module 'CompilerPluginSupport'`, which is accurate and explains nothing.
#
# Three outcomes, and telling them apart is the whole value:
#
#   - CompilerPluginSupport missing -> skip. This SwiftPM cannot declare a
#     macro target at all. Vendoring swift-syntax would not change it; it needs
#     a different SwiftPM, which in practice means Darwin.
#   - network unreachable -> skip. swift-syntax is a remote package and this is
#     the obstacle that was expected first.
#   - anything else -> fail, because then the package is genuinely wrong.
step_swift_macros() {
    if ! swift_available; then
        echo "skip swift-macros (\$SWIFT not found)"
        return 0
    fi
    require_dir swift/macros || return 1

    # The offline checkout set, when nix has built one from nix/swift-lock.json.
    #
    # SwiftPM believes it has already resolved when it finds two things: the
    # unpacked sources under .build/checkouts, and a workspace-state.json
    # naming their revisions. Given both, --disable-automatic-resolution never
    # contacts a remote. Given only the first it re-resolves and fails, which
    # reads like the checkouts were ignored rather than like the state file was
    # missing -- worth knowing before debugging it.
    local args=(build)
    if [ -n "${TABULA_SWIFT_DEPS:-}" ]; then
        echo "note: resolving offline from $TABULA_SWIFT_DEPS"
        rm -rf swift/macros/.build/checkouts swift/macros/.build/workspace-state.json
        mkdir -p swift/macros/.build
        cp -r "$TABULA_SWIFT_DEPS/checkouts" swift/macros/.build/checkouts
        cp "$TABULA_SWIFT_DEPS/workspace-state.json" swift/macros/.build/
        chmod -R u+w swift/macros/.build
        args+=(--disable-automatic-resolution)
    fi

    local out
    out="$( (cd swift/macros && "$SWIFT" "${args[@]}" 2>&1) )"
    if [ $? -eq 0 ]; then
        # SwiftPM probes its shared repository cache before using the
        # checkouts, and in a sandbox that probe cannot resolve a certificate:
        #
        #   warning: 'swift-syntax': skipping cache due to an error:
        #     fatal: unable to access '...': SSL certificate ... (20)
        #
        # It then builds from nix/swift-lock.json exactly as intended, which is
        # why this is noise rather than a failure -- the cache is an
        # optimisation and its absence costs nothing here. Dropped on SUCCESS
        # only: the same lines on a failing build are evidence and are printed
        # in full below.
        printf '%s\n' "$out" | grep -v "skipping cache due to an error" \
            | grep -v "Cloning into bare repository" \
            | grep -v "unable to access 'https://github.com" \
            | grep -v "^tabula-check.*Fetching https://" \
            | grep -v "is not accessible or not writable, disabling user-level cache"
        echo "ok   swift macros"
        # Building is not checking. The package compiled for a long time
        # before anything ran, and `TabulaMacroSyntaxCheck` is where the
        # traversal gets held to SURFACE.md -- so a build that succeeds and a
        # check that never runs would be the same silence this repository has
        # now removed three times.
        # From swift/macros, because the checks read SURFACE.md by relative
        # path -- the surface is documented in one place and executed from it.
        (cd swift/macros && "$SWIFT" run "${args[@]:1}" TabulaMacroSyntaxCheck) || return 1
        return 0
    fi

    case "$out" in
        *"no such module 'CompilerPluginSupport'"*)
            # The manifest imports it on purpose now, so this means the SwiftPM
            # in use is not the augmented one. Almost always a stale shell: the
            # augmented SwiftPM is a new store path, and a `nix develop` opened
            # before it was built still has the original on PATH.
            #
            # The previous message here said "reintroduced
            # CompilerPluginSupport", which was true while the `.macro` target
            # was out of the manifest and became actively misleading the moment
            # it came back -- it blamed the source for an environment.
            printf '%s\n' "$out"
            echo "FAILED: this SwiftPM does not ship CompilerPluginSupport."
            echo "        The manifest needs it for its .macro target."
            echo "        Which SwiftPM is in use:"
            printf '%s' "$out" | sed -n 's|.*"-I", "\([^"]*ManifestAPI\)".*|          \1|p' | head -1
            echo "        If that is not *-plugin-support-*, the shell predates"
            echo "        it: leave and re-enter 'nix develop'. If it is, run"
            echo "        ./tools/verify swift-macro-support for the detail."
            return 1
            ;;
        *".swift:"*"error:"*)
            # A compile error in our own source, matched BEFORE the network
            # patterns. SwiftPM's shared-cache probe puts
            # `fatal: unable to access 'https://...'` into the output of every
            # run, so the network case matches whatever the real failure was --
            # it has now reported "reached the network despite a locked
            # checkout set" for a compiler that cannot declare macros and for a
            # type error in MachineSyntax.swift.
            #
            # Ordering is the fix rather than a cleverer pattern: a line naming
            # a `.swift` file and an `error:` is a compile failure whatever else
            # is in the log.
            printf '%s\n' "$out" | grep -E "\.swift:[0-9]+:[0-9]+: error:" -A2 \
                | head -20
            echo "FAILED: swift-macros -- compile error, see above"
            return 1
            ;;
        *"Network is unreachable"*|*"Could not resolve"*|*"failed to resolve"*|*"fatal: unable to access"*)
            # Matched LAST on purpose. SwiftPM's shared-cache probe puts
            # `fatal: unable to access 'https://...'` into the output of every
            # run, so this pattern matches whatever the real failure was -- it
            # reported "reached the network despite a locked checkout set" for
            # a compiler that cannot declare macros.
            if [ -n "${TABULA_SWIFT_DEPS:-}" ]; then
                # A locked set was supplied and SwiftPM went to the network
                # anyway. That is a failure, not an environment: the state file
                # was rejected, or a dependency appeared that the lock does not
                # cover.
                printf '%s\n' "$out"
                echo "FAILED: swift-macros reached the network despite a locked"
                echo "        checkout set. Re-lock: nix run .#swift-lock"
                return 1
            fi
            echo "skip swift-macros (swift-syntax is remote, this run is offline,"
            echo "     and no locked checkout set was supplied: run"
            echo "     'nix run .#swift-lock' with network and commit"
            echo "     nix/swift-lock.json)"
            return 0
            ;;
    esac

    printf '%s\n' "$out"
    echo "FAILED: swift-macros"
    return 1
}

step_swift_examples() {
    if ! swift_available; then
        echo "skip swift-examples (\$SWIFT not found)"
        return 0
    fi
    require_dir examples/swift-examples || return 1

    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    # One executable per example now, each its own target with its own
    # dependency line. Run separately so a failure names the example rather
    # than the package.
    local out rc=0 one ex
    for ex in traffic-light timer retry login observable-counter spec-check; do
        # shellcheck disable=SC2046
        out="$( (cd examples/swift-examples && "$SWIFT" run -c release \
            $(swift_paths "$scratch") "$ex") 2>&1 )"
        one=$?
        printf '%s\n' "$out"
        [ "$one" -eq 0 ] || rc=1
    done
    rm -rf "$scratch"
    return "$rc"
}

step_swift_codegen() {
    if ! swift_available; then
        echo "skip swift-codegen (\$SWIFT not found)"
        return 0
    fi
    require_dir swift || return 1

    local scratch out rc gen
    scratch="$(mktemp -d)"
    swift_home "$scratch"
    gen="$scratch/emitted"

    # Never blesses. This script is the definition of green, and a definition
    # of green that can rewrite what it compares against is not one. Goldens
    # are blessed by calling the tool directly, as Rust's and Kotlin's are --
    # see swift/codegen-golden/README.md.

    # 1. validation, the additive test, and the golden diff -- and write the
    #    emitted source out for the stages below.
    # shellcheck disable=SC2046
    out="$( (cd swift && "$SWIFT" run -c release $(swift_paths "$scratch") \
        tabula-codegen-check codegen-golden "--emit=$gen") 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    if [ "$rc" -ne 0 ]; then rm -rf "$scratch"; return "$rc"; fi

    # The emitted source imports `Tabula`, which `swift run` of the check
    # does not build. Same module lookup as swift-compile-fail.
    local build bin modules
    # shellcheck disable=SC2046
    build="$( (cd swift && "$SWIFT" build -c release $(swift_paths "$scratch")) 2>&1 )" || {
        echo "the package failed to build:"
        printf '%s\n' "$build" | tail -20
        rm -rf "$scratch"
        return 1
    }
    # shellcheck disable=SC2046
    bin="$( (cd swift && "$SWIFT" build -c release $(swift_paths "$scratch") \
        --show-bin-path) 2>/dev/null )"
    modules="$bin/Modules"
    [ -d "$modules" ] || modules="$bin"

    # 2. The emitted source must compile, with complete implementations.
    #    A golden proves the emitter is deterministic; this proves its output
    #    is Swift. Every machine in ONE module, on purpose: the emitter
    #    namespaces what it generates, and machines that could not share a
    #    module would be a generator bug that separate compiles would hide.
    #    Emitted files are `<m>.emitted.swift` because swiftc rejects two
    #    inputs with one base name -- `complete/<m>.swift` is the other.
    local sup=swift/codegen-support m f exp err bad=0
    local emitted=( "$gen"/*.emitted.swift )
    if [ ! -e "${emitted[0]}" ]; then
        echo "FAIL the check emitted nothing to $gen"
        rm -rf "$scratch"
        return 1
    fi
    if err="$("$SWIFTC" -typecheck -I "$modules" "$sup/Types.swift" "${emitted[@]}" \
        "$sup"/complete/*.swift 2>&1)"; then
        echo "ok   ${#emitted[@]} emitted machines compile in one module, with complete implementations"
    else
        echo "FAIL the emitted machines and complete implementations do not compile together"
        printf '%s\n' "$err" | grep -E "error:" | head -8 | sed 's/^/       /'
        bad=1
    fi

    # 3. An incomplete or miscolored program must NOT compile -- the
    #    guarantee, after generation. Refused, and for the expected reason.
    #    A fixture for a machine the check marks refused also gets that
    #    machine, whose own generated code is what must be refused.
    local extra
    for f in "$sup"/compile_fail/*.swift; do
        m="$(basename "$f" .swift)"
        m="${m%%_*}"
        extra=()
        [ -f "$gen/refused/$m.emitted.swift" ] && extra=("$gen/refused/$m.emitted.swift")
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        # `${extra[@]+...}`: an empty array is "unbound" under `set -u` in the
        # bash versions macOS still ships.
        err="$("$SWIFTC" -typecheck -I "$modules" "$sup/Types.swift" "${emitted[@]}" \
            ${extra[@]+"${extra[@]}"} "$f" 2>&1)"; rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif printf '%s' "$err" | grep -qF -- "$exp"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | grep -E "error:" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$scratch"
    return "$bad"
}

step_swift_conformance() {
    if ! swift_available; then
        echo "skip swift-conformance (\$SWIFT not found)"
        return 0
    fi
    require_goldens || return 1
    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local out rc
    # shellcheck disable=SC2046
    # Flags before the executable name; arguments after it. See step_swift.
    out="$( (cd swift && "$SWIFT" run -c release $(swift_paths "$scratch") \
        tabula-conformance ../spec/conformance) 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    rm -rf "$scratch"
    return "$rc"
}

step_swift_compile_fail() {
    if ! swift_available; then
        echo "skip swift-compile-fail (\$SWIFT not found)"
        return 0
    fi

    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    # Build, and show the output if it fails. Discarding it meant a build
    # failure surfaced as a missing module, which is the wrong problem two
    # steps later.
    local build
    # shellcheck disable=SC2046
    build="$( (cd swift && "$SWIFT" build -c release $(swift_paths "$scratch")) 2>&1 )" || {
        echo "the package failed to build:"
        printf '%s\n' "$build" | tail -20
        rm -rf "$scratch"
        return 1
    }

    # `--show-bin-path` rather than searching for a .swiftmodule: SwiftPM knows
    # where it put things, and the layout under the scratch path differs
    # between versions.
    local bin modules
    # shellcheck disable=SC2046
    bin="$( (cd swift && "$SWIFT" build -c release $(swift_paths "$scratch") \
        --show-bin-path) 2>/dev/null )"
    modules="$bin/Modules"
    [ -d "$modules" ] || modules="$bin"
    if [ ! -d "$modules" ]; then
        echo "could not locate the built module directory (bin path: ${bin:-none})"
        rm -rf "$scratch"
        return 1
    fi

    local bad=0 f exp err rc
    for f in swift/compile_fail/*.swift; do
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        # No `|| true`: it discarded the one status that decides this. See the
        # note above step_compile_fail.
        err="$("$SWIFTC" -typecheck -I "$modules" "$f" 2>&1)"; rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif printf '%s' "$err" | grep -qF -- "$exp"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | grep -E "error:" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$scratch"
    return "$bad"
}

KTLINT="${KTLINT:-ktlint}"

# Does the language formatter destroy the matrix alignment?
#
# Measured rather than assumed: run ktlint's formatter over a COPY and compare
# only the matrix rows. It reformats plenty of ordinary Kotlin around them --
# that is ktlint's business and not ours -- but the rows themselves must come
# back byte-identical, because a matrix is only readable while its columns line
# up.
#
# Narrow on purpose. Adopting ktlint as a style gate would mean making the whole
# tree ktlint-clean, which is a separate decision; this guards the one property
# the library actually depends on.
# Every fixture has every golden.
#
# The conformance harness already catches a missing golden -- it is what caught
# `dead-column.mmd`. But only once an ADAPTER exists, because the harness walks
# adapters and checks the goldens each one needs. A fixture added ahead of its
# adapters, which is how every fixture here has been added, sits incomplete and
# reports nothing until three patches later.
#
# GOLDEN_EXTS is the list either way, so this asks the same question earlier
# and without a toolchain: for each `.tbl`, does every extension exist?
# This script never blesses.
#
# It is the single definition of green, and a definition of green that can
# rewrite what it compares against is not one: a step run with a bless flag
# passes by construction. Goldens are blessed by calling each tool directly --
# `cargo run -p tabula-conformance -- --bless`, `codegen/Main.kt --bless`,
# `swift run tabula-codegen-check codegen-golden --bless` -- and the result is
# read and committed by a person.
#
# Not hypothetical: swift-codegen briefly took a TABULA_BLESS variable. So
# this fails on any COMMAND in tools/verify or nix/ that mentions a bless flag
# or variable. Comments and printed advice ("run with --bless") are allowed;
# that is how the other steps tell a person what to do.
#
# The patterns are split so this function does not match itself.
step_no_bless() {
    local flag='--bl''ess' var='BL''ESS' hits
    hits="$(grep -nE -- "$flag|$var" tools/verify nix/*.nix \
        | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' \
        | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(echo|printf)[[:space:]]')"
    if [ -n "$hits" ]; then
        echo "FAIL a check can bless -- tools/verify must only compare:"
        printf '%s\n' "$hits" | sed 's/^/       /'
        echo "     bless by calling the tool directly; see the note above step_no_bless"
        return 1
    fi
    echo "ok   no check blesses; every golden is compared, never written"
}

step_fixtures_complete() {
    local d=spec/conformance
    require_dir "$d" || return 1

    local tbl name ext bad=0 n=0 missing
    for tbl in "$d"/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        n=$((n + 1))
        missing=""
        for ext in $GOLDEN_EXTS; do
            [ -f "$d/$name.$ext" ] || missing="$missing $ext"
        done
        # A trace is not in GOLDEN_EXTS -- it is an input, not an expectation --
        # and a fixture without one checks a table and no behaviour.
        [ -f "$d/traces/$name.trace" ] || missing="$missing trace"

        if [ -n "$missing" ]; then
            echo "FAIL $name is missing:$missing"
            bad=1
        fi
    done

    if [ "$n" -eq 0 ]; then
        echo "FAIL no fixtures found in $d"
        bad=1
    elif [ "$bad" -eq 0 ]; then
        echo "ok   $n fixtures, each with $GOLDEN_EXTS and a trace"
    else
        echo "     Bless what is missing, or generate it:"
        echo "       cd rust && cargo run -p tabula-conformance -- --bless"
    fi
    return "$bad"
}

# Every diagnostic code, in every implementation, matches what is written down.
#
# Nothing compared the three until this existed, and the thing nothing compared
# had already diverged: Rust emits twelve of the sixteen codes; Kotlin and
# Swift emit all sixteen. The four it omits are the language doing the work --
# `GO!(Typo)` is a path that does not resolve, and rustc's message about the
# user's own token beats a `compile_error!` about the same thing -- so the gap
# is right. It had just never been stated, and an unstated gap is one a
# refactor closes or widens without anybody deciding to.
#
# `spec/diagnostics-coverage.md` states it. This check holds the source to it
# in both directions: a code emitted but not listed, and a code listed but not
# emitted, are both failures. One-directional would have missed the case that
# matters most -- an implementation quietly losing a diagnostic.
step_diagnostics_coverage() {
    local doc="spec/diagnostics-coverage.md"
    [ -f "$doc" ] || { echo "FAILED: $doc is missing"; return 1; }

    local bad=0 code langs lang actual expected n=0

    # Quoted matches only. An unquoted `tabula::lint::report` is a module path,
    # not a diagnostic, and counting it would report three codes Rust does not
    # have.
    emitted() { grep -rhoE "\"tabula::[a-z-]+" "$1/" 2>/dev/null | tr -d '"' | sort -u; }

    local rust_codes kotlin_codes swift_codes
    rust_codes="$(emitted rust)"
    kotlin_codes="$(emitted kotlin)"
    swift_codes="$(emitted swift)"

    while read -r code langs; do
        [ -n "$code" ] || continue
        n=$((n + 1))
        for lang in rust kotlin swift; do
            case "$lang" in
                rust) actual="$rust_codes" ;;
                kotlin) actual="$kotlin_codes" ;;
                swift) actual="$swift_codes" ;;
            esac
            expected=no
            case " $langs " in *" $lang "*) expected=yes ;; esac
            if printf '%s\n' "$actual" | grep -qx "$code"; then
                if [ "$expected" = no ]; then
                    echo "FAIL $lang emits $code but $doc does not list it"
                    echo "     A new diagnostic needs a row here and a section"
                    echo "     in spec/diagnostics.md, or readers meet a code"
                    echo "     with no page behind it."
                    bad=1
                fi
            elif [ "$expected" = yes ]; then
                echo "FAIL $doc lists $code for $lang, which does not emit it"
                echo "     Either the diagnostic was lost or the table is"
                echo "     stale. Both are worth stopping for."
                bad=1
            fi
        done
    done < <(sed -n '/^```coverage$/,/^```$/p' "$doc" | sed '1d;$d')

    if [ "$n" -eq 0 ]; then
        echo "FAIL $doc has no \`\`\`coverage block, so this checked nothing"
        bad=1
    fi

    # And the table must cover spec/diagnostics.md exactly: a code documented
    # for readers but absent from the table would slip past the loop above,
    # since the loop only walks rows that exist.
    local documented
    documented="$(grep -oE 'tabula::[a-z-]+' spec/diagnostics.md | sort -u)"
    for code in $documented; do
        if ! sed -n '/^```coverage$/,/^```$/p' "$doc" | grep -q "^$code "; then
            echo "FAIL spec/diagnostics.md documents $code; $doc has no row for it"
            bad=1
        fi
    done

    # And the fixture table: which runtime lints a `.lint` golden trips.
    #
    # Recorded rather than required: when this was written five of seven were
    # `-`, and a check that fails on a known gap is a check people learn to
    # ignore. None are `-` now, and the check is kept for what it catches. What
    # it catches is movement in either direction: a fixture that stops tripping
    # a lint it used to, and a lint that gains coverage without the table
    # noticing. Closing a gap is then a diff here, which is the point.
    local fixtures actualf
    while read -r code langs; do
        [ -n "$code" ] || continue
        actualf="$(grep -l "$code" spec/conformance/*.lint 2>/dev/null \
            | sed 's|.*/||; s|\.lint$||' | sort | tr '\n' ' ')"
        actualf="$(echo $actualf)"
        [ -z "$actualf" ] && actualf="-"
        fixtures="$(echo $langs)"
        if [ "$actualf" != "$fixtures" ]; then
            echo "FAIL $code: $doc says fixtures [$fixtures], goldens say [$actualf]"
            bad=1
        fi
    done < <(sed -n '/^```fixtures$/,/^```$/p' "$doc" | sed '1d;$d')

    [ "$bad" -eq 0 ] && echo "ok   $n diagnostic codes agree across three implementations"
    return "$bad"
}

# The Swift matrix has no formatter guarding it. This guards the guard.
#
# `swift-matrix-stable` is not written, because swift-format is a remote
# SwiftPM package and adding it is a real cost with a version trap in it (see
# PLAN). So `Turnstile.tb.swift` survives for a reason worth naming precisely:
# nothing formats it. That is luck, and luck expires the day someone adds
# swift-format to the repository -- at which point it collapses the matrix on
# its first run, and `swift-fmt --check` would then demand the collapsed form
# forever after, exactly as rustfmt would.
#
# The expiry is what is checkable today with no dependency at all. If a
# swift-format configuration appears, it must already exclude `.tb.swift`. A
# config that arrives without the exemption is the moment the matrix breaks,
# and this is the check that is standing there when it does.
step_swift_format_config() {
    local cfg found=0 bad=0
    while IFS= read -r cfg; do
        found=$((found + 1))
        # swift-format reads `.swift-format` as JSON; it has no per-glob rule
        # exemptions the way .editorconfig does, so the only way to keep it off
        # a file is to keep the file out of its input. Either mechanism is
        # fine; naming the extension somewhere in the config is the evidence
        # that someone thought about it.
        if grep -q "tb.swift" "$cfg"; then
            echo "ok   $cfg mentions .tb.swift"
        else
            echo "FAIL $cfg does not mention .tb.swift"
            echo "     A swift-format config now exists, so something formats"
            echo "     Swift here. Matrix files are column-aligned on purpose"
            echo "     and must be excluded from its input -- see"
            echo "     spec/matrix-files.md -- and then swift-matrix-stable"
            echo "     needs writing to prove the exclusion holds."
            bad=1
        fi
    done < <(find . \( -name '.swift-format' -o -name '.swift-format.json' \) \
        -not -path './.git/*' -not -path '*/.build/*' | sort)

    if [ "$found" -eq 0 ]; then
        echo "ok   no swift-format config; nothing formats Swift here yet"
    fi
    return "$bad"
}

# Every `.tb.` file is covered by one of the matrix checks.
#
# The check above the other two, and the one they cannot make about
# themselves. `kotlin-matrix-stable` and `rust-matrix-stable` each scan roots
# they name, so a matrix in a directory neither names is outside both -- and
# silently so, because each scan finds what it finds and reports on that.
#
# That is not hypothetical. `kotlin-matrix-stable` scanned `kotlin/` alone for
# as long as it existed, and
# examples/kotlin/06-generated/src/Machine.tb.kt sat outside it the whole time
# while both checks were green.
#
# So this enumerates the `.tb.` files that exist and asks which scan reaches
# each one, rather than asking each scan what it found.
step_matrix_covered() {
    local f bad=0 total=0 covered=0
    local uncovered=""

    while IFS= read -r f; do
        total=$((total + 1))
        case "$f" in
            # Roots that `kotlin-matrix-stable` copies and ktlints.
            ./kotlin/*.tb.kt|./examples/kotlin/*.tb.kt)
                covered=$((covered + 1))
                echo "ok   $f (kotlin-matrix-stable)"
                ;;
            # Roots that `rust-matrix-stable` copies and cargo-fmts.
            ./rust/*.tb.rs|./examples/rust/*.tb.rs)
                covered=$((covered + 1))
                echo "ok   $f (rust-matrix-stable)"
                ;;
            *.tb.swift)
                # A known gap with a name, not an omission. swift-format is a
                # remote SwiftPM package and there is no swift-matrix-stable
                # yet; see PLAN. Reported through the ledger so it is counted
                # rather than assumed.
                echo "skip matrix-covered ($f: no swift-matrix-stable yet;"
                echo "     swift-format is a remote package -- see PLAN)"
                ;;
            *)
                uncovered="$uncovered  $f"$'\n'
                bad=1
                ;;
        esac
    done < <(find . -name '*.tb.*' \
        -not -path './.git/*' \
        -not -path '*/build/*' \
        -not -path '*/.build/*' \
        -not -path '*/target/*' | sort)

    if [ -n "$uncovered" ]; then
        echo "FAIL these matrix files are scanned by no check:"
        printf '%s' "$uncovered"
        echo "     Either move them under a root one of the matrix checks"
        echo "     names, or widen that check. A matrix no formatter check"
        echo "     reaches is one collapse away from being a list."
    fi

    if [ "$total" -eq 0 ]; then
        echo "FAIL no .tb. files found at all; the convention has evaporated"
        echo "     or this scan is looking in the wrong place."
        bad=1
    fi

    echo "matrix files: $total found, $covered covered"
    return "$bad"
}

# Matrix rows must survive `cargo fmt`, the same claim kotlin-matrix-stable
# makes about ktlint.
#
# The reasoning behind the Rust answer is different from the Kotlin one, and
# that difference is the thing worth checking. Kotlin needs an `.editorconfig`
# exemption because ktlint formats Kotlin it understands. rustfmt needs no
# exemption because `transition_matrix!` is a macro invocation whose body is
# not a Rust expression, so rustfmt bails on the whole invocation and leaves
# the alignment alone.
#
# "Bails on the whole invocation" is an implementation detail of rustfmt, not a
# promise, and the repository depends on it in 28 files. A rustfmt release that
# got better at formatting macro bodies would silently collapse every matrix in
# the tree, and `cargo fmt --check` in step_fmt would then demand the collapsed
# form forever after. So it is asserted rather than assumed.
step_rust_matrix_stable() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "skip rust-matrix-stable (\$cargo not found)"
        return 0
    fi
    require_dir rust || return 1

    local roots=(rust)
    [ -d examples/rust ] && roots+=(examples/rust)

    local scratch bad=0 found=0 f root
    scratch="$(mktemp -d)"
    for root in "${roots[@]}"; do
        mkdir -p "$scratch/$(dirname "$root")"
        cp -r "$root" "$scratch/$root"
    done
    [ -f rustfmt.toml ] && cp rustfmt.toml "$scratch/"
    [ -f .rustfmt.toml ] && cp .rustfmt.toml "$scratch/"

    for root in "${roots[@]}"; do
        (cd "$scratch/$root" && cargo fmt >/dev/null 2>&1) || true
    done

    for root in "${roots[@]}"; do
        # `tests/compile_fail/` is excluded on purpose. Those fixtures belong
        # to no cargo target -- trybuild feeds them to rustc directly -- so
        # `cargo fmt` never visits them, and comparing them would report `ok`
        # for files the formatter cannot reach. A check that passes because
        # nothing happened is the failure mode this repository keeps finding.
        for f in $(cd "$root" && grep -rl "transition_matrix!" . 2>/dev/null \
            | grep -v "/compile_fail/"); do
            grep -q "=> \[" "$root/$f" || continue
            found=$((found + 1))
            if ! diff -q \
                <(grep -h "=> \[" "$root/$f") \
                <(grep -h "=> \[" "$scratch/$root/$f") >/dev/null; then
                echo "FAIL cargo fmt changed the matrix in $root/$f"
                diff \
                    <(grep -h "=> \[" "$root/$f") \
                    <(grep -h "=> \[" "$scratch/$root/$f") | head -6
                bad=1
            fi
        done
    done

    if [ "$found" -eq 0 ]; then
        echo "FAIL no transition_matrix! rows found under: ${roots[*]}"
        echo "     Either the matrices moved or the scan looks in the wrong"
        echo "     place. A check with nothing to check is not passing."
        bad=1
    else
        echo "ok   matrix rows survive cargo fmt in $found file(s)"
    fi

    rm -rf "$scratch"
    return "$bad"
}

step_kotlin_matrix_stable() {
    if ! command -v "$KTLINT" >/dev/null 2>&1; then
        echo "skip kotlin-matrix-stable (\$KTLINT not found; nixpkgs provides it)"
        return 0
    fi
    require_dir kotlin || return 1

    # BOTH trees, not just the library's.
    #
    # This scanned `kotlin/` alone, which reached exactly one file --
    # kotlin/test/TimerSpec.tb.kt -- and missed
    # examples/kotlin/06-generated/src/Machine.tb.kt entirely. The example is
    # the matrix a user copies, so it was the more important of the two and the
    # one nothing checked. `.editorconfig`'s `[*.tb.kt]` already covered it;
    # only the scan did not.
    local roots=(kotlin)
    [ -d examples/kotlin ] && roots+=(examples/kotlin)

    local scratch bad=0 found=0 f root
    scratch="$(mktemp -d)"
    for root in "${roots[@]}"; do
        mkdir -p "$scratch/$(dirname "$root")"
        cp -r "$root" "$scratch/$root"
    done

    # The .editorconfig comes too, and it is the point of the test.
    #
    # Without it ktlint applies `no-multi-spaces` and collapses
    #
    #   @Row(S.Idle::class,    [CellSpec(Kind.HANDLE),  CellSpec(Kind.IGNORE), ...
    #
    # to single spaces, destroying the alignment outright. The exemptions in
    # .editorconfig are load-bearing, and this check exists to prove they still
    # are rather than to assume it.
    cp .editorconfig "$scratch/.editorconfig"

    # ktlint exits non-zero for rules it cannot auto-correct (line length,
    # wildcard imports). Those are style opinions we have not adopted; the
    # formatting pass still runs, which is all this needs.
    for root in "${roots[@]}"; do
        (cd "$scratch" && "$KTLINT" --format "$root/**/*.kt" >/dev/null 2>&1) || true
    done

    for root in "${roots[@]}"; do
        for f in $(cd "$root" && grep -rl "@Row(\|@Machine(" . 2>/dev/null); do
            found=$((found + 1))
            if ! diff -q \
                <(grep -h "@Row(\|@Machine(\|CellSpec(" "$root/$f") \
                <(grep -h "@Row(\|@Machine(\|CellSpec(" "$scratch/$root/$f") >/dev/null; then
                echo "FAIL ktlint --format changed the matrix in $root/$f"
                diff \
                    <(grep -h "@Row(\|@Machine(\|CellSpec(" "$root/$f") \
                    <(grep -h "@Row(\|@Machine(\|CellSpec(" "$scratch/$root/$f") | head -6
                bad=1
            else
                echo "ok   matrix rows survive ktlint --format: $root/$f"
            fi
        done
    done

    # A scan that matches nothing passes silently, which is how this check
    # would have reported success after a rename moved every matrix out from
    # under it -- and it nearly did: TimerSpec.tb.kt only exists because the
    # gate that hid this whole check got fixed first.
    if [ "$found" -eq 0 ]; then
        echo "FAIL no @Machine/@Row declarations found under: ${roots[*]}"
        echo "     Either the matrices moved or the scan looks in the wrong"
        echo "     place. A check with nothing to check is not passing."
        bad=1
    fi

    rm -rf "$scratch"
    return "$bad"
}

step_kotlin_codegen() {
    if ! kotlin_available; then
        echo "skip kotlin-codegen (\$KOTLINC not found)"
        return 0
    fi
    local out gen
    out="$(mktemp -d)"
    gen="$out/emitted"
    local rc=0
    kotlin_version_note

    (
        require_dir kotlin || exit 1
        cd kotlin || exit 1
        kotlin_artifacts "$out" || exit 1
        KCP="$(kotlin_cp "$out")"
        "$KOTLINC" -cp "$KCP" codegen/*.kt -include-runtime -d "$out/cg.jar" 2>&1 \
            | grep -v "^info:" || true
        [ -f "$out/cg.jar" ] || { echo "emitter failed to compile"; exit 1; }

        # 1. emit, and diff against the committed golden source
        java -cp "$out/cg.jar:$KCP" codegen.MainKt codegen/golden "--emit=$gen" || exit 1

        # 2. the emitted source must compile
        # StopwatchTypes.kt carries its own implementation: that machine is
        # `internal`, so it has to be implemented in the same compilation.
        "$KOTLINC" -cp "$KCP" codegen/support/TimerTypes.kt codegen/support/ToggleTypes.kt \
            codegen/support/StopwatchTypes.kt \
            "$gen"/*.kt -d "$out/gen" 2>&1 | grep -v "^info:" || true
        [ -d "$out/gen" ] || { echo "emitted source does not compile"; exit 1; }
        echo "ok   emitted source compiles"

        # 3. a complete implementation must satisfy it
        "$KOTLINC" -cp "$KCP:$out/gen" codegen/support/Complete.kt -d "$out/cmp" 2>&1 \
            | grep -v "^info:" || true
        [ -d "$out/cmp" ] || { echo "a complete implementation does not compile"; exit 1; }
        echo "ok   complete implementation compiles"

        # 4. an incomplete one must not -- the guarantee, after generation
        local f exp err bad=0
        for f in codegen/compile_fail/*.kt; do
            exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
            # Status of kotlinc, not of the grep that filters its notes -- a
            # pipeline reports the last command, and `grep -v` exits 1 when it
            # filters everything away.
            raw="$("$KOTLINC" -cp "$KCP:$out/gen" "$f" -d "$out/x" 2>&1)"; rc=$?
            err="$(printf '%s\n' "$raw" | grep -v "^info:" || true)"
            if [ "$rc" -eq 0 ]; then
                echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
                bad=1
            elif printf '%s' "$err" | grep -qF -- "$exp"; then
                echo "ok   $(basename "$f")"
            else
                echo "FAIL $(basename "$f")"
                echo "     expected: $exp"
                printf '%s\n' "$err" | head -3 | sed 's/^/       /'
                bad=1
            fi
        done
        exit "$bad"
    )
    rc=$?
    rm -rf "$out"
    return "$rc"
}

step_kotlin_compile_fail() {
    if ! kotlin_available; then
        echo "skip kotlin-compile-fail (\$KOTLINC not found)"
        return 0
    fi
    local out bad f exp err raw rc
    out="$(mktemp -d)"
    bad=0
    kotlin_version_note

    (cd kotlin && kotlin_artifacts "$out") || return 1
    KCP="$(kotlin_cp "$out")"
    # TimerSpec.tb.kt carries the matrix; see spec/matrix-files.md. Listed
    # explicitly rather than globbed so this step keeps compiling exactly the
    # two machines the fixtures need and not the harness around them.
    (cd kotlin && "$KOTLINC" -cp "$KCP" test/ReferenceTimer.kt test/TimerSpec.tb.kt \
        test/Composition.kt -d "$out/ref" 2>&1 | grep -v "^info:") || true

    for f in kotlin/compile_fail/*.kt; do
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        # See the note above step_compile_fail: kotlinc's status, not the
        # filtering grep's.
        raw="$("$KOTLINC" -cp "$KCP:$out/ref" "$f" -d "$out/x" 2>&1)"; rc=$?
        err="$(printf '%s\n' "$raw" | grep -v "^info:" || true)"
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif printf '%s' "$err" | grep -qF -- "$exp"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$out"
    return "$bad"
}

steps=("$@")
# `docs` was in nix/checks.nix but not here, so `./tools/verify` and
# `nix flake check` disagreed about what green means -- the one thing the
# header above says this file exists to prevent.
[ ${#steps[@]} -eq 0 ] && \
    steps=(version docs fmt clippy test no-std compile-fail conformance examples \
           kotlin kotlin-compile-fail kotlin-conformance kotlin-codegen \
           swift-macro-support \
           kotlin-examples kotlin-ksp kotlin-ksp-compile-fail kotlin-ksp-incremental \
           kotlin-matrix-stable rust-matrix-stable \
           matrix-covered swift-format-config diagnostics-coverage \
           fixtures-complete no-bless \
           swift swift-compile-fail swift-conformance swift-examples \
           swift-codegen swift-macros)

for s in "${steps[@]}"; do
    case "$s" in
        version)      run version      step_version ;;
        docs)         run docs         step_docs ;;
        fmt)          run fmt          step_fmt ;;
        clippy)       run clippy       step_clippy ;;
        test)         run test         step_test ;;
        no-std)       run no-std       step_no_std ;;
        compile-fail) run compile-fail step_compile_fail ;;
        conformance)  run conformance  step_conformance ;;
        examples)     run examples     step_examples ;;
        kotlin)              run kotlin              step_kotlin ;;
        kotlin-compile-fail) run kotlin-compile-fail step_kotlin_compile_fail ;;
        kotlin-conformance)  run kotlin-conformance  step_kotlin_conformance ;;
        kotlin-codegen)      run kotlin-codegen      step_kotlin_codegen ;;
        kotlin-examples)     run kotlin-examples     step_kotlin_examples ;;
        kotlin-ksp)          run kotlin-ksp          step_kotlin_ksp ;;
        kotlin-ksp-compile-fail) run kotlin-ksp-compile-fail step_kotlin_ksp_compile_fail ;;
        kotlin-ksp-incremental) run kotlin-ksp-incremental step_kotlin_ksp_incremental ;;
        kotlin-matrix-stable) run kotlin-matrix-stable step_kotlin_matrix_stable ;;
        rust-matrix-stable)  run rust-matrix-stable  step_rust_matrix_stable ;;
        matrix-covered)      run matrix-covered      step_matrix_covered ;;
        swift-format-config) run swift-format-config step_swift_format_config ;;
        diagnostics-coverage) run diagnostics-coverage step_diagnostics_coverage ;;
        fixtures-complete)   run fixtures-complete   step_fixtures_complete ;;
        no-bless)            run no-bless            step_no_bless ;;
        swift)               run swift               step_swift ;;
        swift-compile-fail)  run swift-compile-fail  step_swift_compile_fail ;;
        swift-conformance)   run swift-conformance   step_swift_conformance ;;
        swift-examples)      run swift-examples      step_swift_examples ;;
        swift-codegen)       run swift-codegen       step_swift_codegen ;;
        swift-macros)        run swift-macros        step_swift_macros ;;
        swift-macro-support) run swift-macro-support step_swift_macro_support ;;
        *) echo "unknown step: $s"; exit 2 ;;
    esac
done

echo

# The ledger, before the verdict, because "all green" read on its own is what
# made two missing suites invisible. Anything listed here did not run, and a
# run with no list is the only one that means what it says.
# POSIX classes, not \s. BSD grep and sed do not understand \s, and
# ci.yml's check-no-nix job runs this on macos-14 -- where the ledger would
# have silently matched nothing, which is the exact failure it exists to stop.
if grep -q '^[[:space:]]*skip ' "$TALLY"; then
    echo "verify: skipped ---------------------------------------------"
    grep '^[[:space:]]*skip ' "$TALLY" | sed 's/^[[:space:]]*/  /'
    echo "------------------------------------------------------------"
    echo
fi

if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED"
fi
exit "$fail"
