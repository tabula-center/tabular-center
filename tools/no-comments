#!/usr/bin/env bash
# The Cleanness rule (ARCHITECTURE 15), enforced over the file types already
# migrated, listed in clean_patterns.
#
# A comment is allowed in three places: the header block at the top of a file,
# before its first line of code; a block attached to a type declaration --
# trait, struct, enum, class, interface, object, protocol, actor, type alias,
# macro_rules! -- directly or through attribute and annotation lines; and the
# directives a tool reads. Anything else is reported with its file and line.
# String literals, Kotlin and Swift triple-quoted strings and shell heredocs
# are skipped, so text a program writes is never taken for a comment.
#
#   tools/no-comments     exit 0 clean, 1 with every finding listed
set -euo pipefail
cd "$(dirname "$0")/.."

clean_patterns=(
    '*.toml'
    '*.yml'
    '*.yaml'
    '*.nix'
    '*.rs'
)

clean_paths=()

documented_paths=(
    'tabular-center-rust/tabular-center/src/*.rs'
)

clean_files=(
    .editorconfig
    .gitignore
    justfile
    tools/docs
    tools/no-comments
    tools/verify
    tabular-center-fmt/tools/verify
    tabular-center-kotlin/tools/central-bundle
    tabular-center-kotlin/tools/gradle-lock
    tabular-center-kotlin/tools/verify
    tabular-center-rust/tools/asm-diff
    tabular-center-rust/tools/compile-fail
    tabular-center-rust/tools/verify
    tabular-center-swift/tools/swift-lock
    tabular-center-swift/tools/verify
)

skipped_directories=(.git target .build build .gradle .gradle-home .kotlin doc result node_modules)

prune_expression=(-false)
for d in "${skipped_directories[@]}"; do
    prune_expression+=(-o -name "$d")
done

name_expression=(-false)
for p in "${clean_patterns[@]}"; do
    name_expression+=(-o -name "$p")
done
for p in "${clean_paths[@]+"${clean_paths[@]}"}"; do
    name_expression+=(-o -path "./$p")
done

files=()
while IFS= read -r f; do
    files+=("$f")
done < <(find . \( "${prune_expression[@]}" \) -prune -o -type f \( "${name_expression[@]}" \) -print | sed 's|^\./||' | LC_ALL=C sort)

for f in "${clean_files[@]}"; do
    if [ ! -f "$f" ]; then
        echo "FAIL no-comments: $f is listed in clean_files but does not exist"
        exit 1
    fi
    files+=("$f")
done

if [ "${#files[@]}" -eq 0 ]; then
    echo "FAIL no-comments found no files matching ${clean_patterns[*]}; it checked nothing"
    exit 1
fi

comment_style() {
    case "$1" in
        *.rs | *.kt | *.kts | *.swift) echo slash ;;
        *) echo hash ;;
    esac
}

find_comments() {
    STYLE="$1" FILE="$2" awk '
        BEGIN { held_labels_only = 1 }
        function without_strings(s) {
            gsub(/"([^"\\]|\\.)*"/, "\"\"", s)
            if (ENVIRON["STYLE"] == "hash") gsub(/'"'"'[^'"'"']*'"'"'/, "", s)
            return s
        }
        function is_directive(line) {
            if (FNR == 1 && line ~ /^#!/) return 1
            if (line ~ /^[[:space:]]*\/\/~ (EXPECT|AT|BUILDS)/) return 1
            if (line ~ /^[[:space:]]*\/\/ swift-format-ignore-file[[:space:]]*$/) return 1
            if (line ~ /^\/\/ swift-tools-version:/) return 1
            if (line ~ /^[[:space:]]*# shellcheck (disable|source|shell)=/) return 1
            if (line ~ /@[0-9a-f]{40}[[:space:]]+# v[0-9][0-9A-Za-z.\-]*[[:space:]]*$/) return 1
            if (ENVIRON["FILE"] ~ /\.tb\./ && is_column_labels(line)) return 1
            return 0
        }
        function is_type_declaration(code) {
            return code ~ /^[[:space:]]*(((pub(\([^)]*\))?|public|private|internal|protected|fileprivate|open|final|abstract|sealed|data|enum|annotation|inline|value|fun|indirect|companion|expect|actual|unsafe|@[A-Za-z_][A-Za-z0-9_.]*)[[:space:]]+)*(struct|enum|trait|union|type|class|interface|object|protocol|actor|typealias)[[:space:]]|macro_rules![[:space:]])/
        }
        function is_just_recipe(code) {
            return ENVIRON["FILE"] ~ /(^|\/)justfile$/ && code !~ /:=/ && code ~ /^@?[A-Za-z_][A-Za-z0-9_-]*([[:space:]].*)?:/
        }
        function is_attribute(code) {
            return code ~ /^[[:space:]]*(#!?\[|@[A-Za-z_])/
        }
        function hold(line) { held[++held_count] = sprintf("%s:%d: %s", ENVIRON["FILE"], FNR, line) }
        function report_held(   i) { for (i = 1; i <= held_count; i++) print held[i]; held_count = 0; held_labels_only = 1 }
        function comment_line(line) { if (seen_code) hold(line) }
        function trailing(line) { printf "%s:%d: %s\n", ENVIRON["FILE"], FNR, line }

        function scan(line,   i, n, c, out, p, m) {
            out = ""; n = length(line); i = 1; comment_at = 0
            while (i <= n) {
                if (raw_end != "") {
                    p = index(substr(line, i), raw_end)
                    if (p == 0) return out
                    i += p - 1 + length(raw_end); raw_end = ""; out = out "\"\""; continue
                }
                if (in_string) {
                    while (i <= n) {
                        c = substr(line, i, 1)
                        if (c == "\\") { i += 2; continue }
                        i++
                        if (c == "\"") { in_string = 0; break }
                    }
                    if (!in_string) out = out "\"\""
                    continue
                }
                if (in_block_comment) {
                    p = index(substr(line, i), "*/")
                    if (p == 0) return out
                    i += p + 1; in_block_comment = 0; continue
                }
                c = substr(line, i, 1)
                if (substr(line, i, 2) == "//") { comment_at = i; return out }
                if (substr(line, i, 2) == "/*") { comment_at = i; in_block_comment = 1; i += 2; continue }
                if (ENVIRON["FILE"] !~ /\.rs$/ && substr(line, i, 3) == "\"\"\"") { raw_end = "\"\"\""; i += 3; continue }
                if (ENVIRON["FILE"] ~ /\.rs$/ && (i == 1 || substr(line, i - 1, 1) !~ /[A-Za-z0-9_]/) && match(substr(line, i), /^b?r#*"/)) {
                    m = substr(line, i, RLENGTH); sub(/^b?r/, "", m); sub(/"$/, "", m)
                    raw_end = "\"" m; i += RLENGTH; continue
                }
                if (c == "\"") { in_string = 1; i++; continue }
                if (c == "'"'"'" && match(substr(line, i), /^'"'"'(\\.|[^'"'"'\\])'"'"'/)) { i += RLENGTH; continue }
                out = out c; i++
            }
            return out
        }
        function is_column_labels(line) {
            return line ~ /^[[:space:]]*\/\/([[:space:]]+[A-Za-z_][A-Za-z0-9_.]*){2,}[[:space:]]*$/
        }
        function is_matrix_row(code) {
            return code ~ /^[[:space:]]*[A-Z][A-Za-z0-9_]*[[:space:]]*=>[[:space:]]*\[/
        }

        heredoc_end != "" {
            check = $0
            sub(/^[[:space:]]+/, "", check)
            sub(/[[:space:]]+$/, "", check)
            if (check == heredoc_end) heredoc_end = ""
            next
        }
        ENVIRON["STYLE"] == "slash" {
            started_inside = (raw_end != "" || in_string)
            started_in_comment = in_block_comment
            code = scan($0)
            if (started_inside && code ~ /^[[:space:]]*$/ && comment_at == 0) next
            if (is_directive($0)) next
            if (code ~ /^[[:space:]]*$/ && (comment_at > 0 || started_in_comment)) {
                if (seen_code) {
                    hold($0)
                    if (!is_column_labels($0)) held_labels_only = 0
                }
                next
            }
            if (code ~ /^[[:space:]]*$/) {
                if (seen_code) report_held()
                held_labels_only = 1
                next
            }
            if (comment_at > 0) trailing($0)
            seen_code = 1
            if (held_count > 0 && held_labels_only && is_matrix_row(code)) held_count = 0
            if (is_type_declaration(code)) held_count = 0
            if (is_attribute(code)) next
            report_held()
            held_labels_only = 1
            next
        }
        /^[[:space:]]*$/ {
            if (seen_code) report_held()
            next
        }
        is_directive($0) { next }
        {
            code = without_strings($0)
            if (code ~ /^[[:space:]]*#/) { comment_line($0); next }
            if (code ~ /[[:space:]]#/) trailing($0)
            if (is_just_recipe(code)) held_count = 0
            report_held()
            seen_code = 1
            if ($0 !~ /<<</ && match($0, /<<-?[[:space:]]*["'"'"']?[A-Za-z_][A-Za-z0-9_]*["'"'"']?/)) {
                marker = substr($0, RSTART, RLENGTH)
                gsub(/^<<-?[[:space:]]*["'"'"']?|["'"'"']$/, "", marker)
                heredoc_end = marker
            }
        }
        END { report_held() }
    ' "$2"
}

find_undocumented() {
    FILE="$1" awk '
        BEGIN { last = "start" }
        /^[[:space:]]*$/ { if (last != "start") last = "blank"; next }
        last == "start" && $0 !~ /^[[:space:]]*\/\// {
            printf "%s:%d: no file header\n", ENVIRON["FILE"], FNR
            last = "code"
        }
        /^[[:space:]]*\/\// { last = "comment"; next }
        /^[[:space:]]*#!?\[/ { next }
        {
            if ($0 ~ /^[[:space:]]*pub[[:space:]]+(struct|enum|trait|union|type)[[:space:]]+[A-Za-z_]/ || $0 ~ /^[[:space:]]*macro_rules![[:space:]]+[A-Za-z][A-Za-z0-9_]*/) {
                if (last != "comment") printf "%s:%d: public type without a comment: %s\n", ENVIRON["FILE"], FNR, $0
            }
            last = "code"
        }
    ' "$1"
}

documented=()
while IFS= read -r f; do
    documented+=("$f")
done < <(for p in "${documented_paths[@]}"; do find . -path "./$p" -type f; done | sed 's|^\./||' | LC_ALL=C sort)

undocumented="$(for f in "${documented[@]+"${documented[@]}"}"; do find_undocumented "$f"; done)"
if [ -n "$undocumented" ]; then
    echo "FAIL every published file needs a header and every public type a comment (ARCHITECTURE 15):"
    while IFS= read -r line; do echo "  $line"; done <<<"$undocumented"
    exit 1
fi

findings="$(for f in "${files[@]}"; do find_comments "$(comment_style "$f")" "$f"; done)"

if [ -n "$findings" ]; then
    count="$(wc -l <<<"$findings" | tr -d ' ')"
    echo "FAIL $count comment line(s) outside a file header or a type's documentation (ARCHITECTURE 15):"
    head -40 <<<"$findings" | sed 's/^/  /'
    [ "$count" -gt 40 ] && echo "  ... and $((count - 40)) more"
    echo "  Move what a reader needs to the file header, the type's comment, ARCHITECTURE.md or PLAN.md."
    exit 1
fi

echo "ok   no comments in ${#files[@]} files (${clean_patterns[*]}, ${#clean_files[@]} named files); ${#documented[@]} published files documented"
