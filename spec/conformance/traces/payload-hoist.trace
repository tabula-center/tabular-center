trace connect-succeeds
  ctx  max_attempts=3
  from Connecting
  Open => go Live
  Open => ignored
  Fail => go Reconnecting
  Open => go Live

trace backoff-advances-the-counter
  # `backoffTimeout` is the only cell that can advance `attempt`: the GO cells
  # into Backoff are static, and a static cell cannot read the state it is
  # leaving, so every one of them restarts the count at 0. That is not a
  # shortcut in the fixture -- it is what GO means, and it is half of why this
  # machine wants the field in Context instead.
  ctx  max_attempts=3
  from Backoff attempt=1
  Timeout => go Reconnecting attempt=2
  Fail    => go Backoff attempt=0
  Timeout => go Reconnecting attempt=1

trace backoff-exhausts
  # At the limit the cell stays put rather than transitioning. `stay` and
  # `ignored` are different outcomes and a machine returning the wrong one
  # fails here -- see timer.trace's `stay-is-not-ignored`.
  ctx  max_attempts=3
  from Backoff attempt=3
  Timeout => stay
  Open    => ignored
  Fail    => ignored
  Timeout => stay
