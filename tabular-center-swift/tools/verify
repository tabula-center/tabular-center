#!/usr/bin/env bash
# The Swift steps of what "green" means, run directly, by the root
# tools/verify, or by this directory's flake. Runs from the repository root;
# every step skips, saying so, where there is no Swift toolchain.
#
# Usage:  tabular-center-swift/tools/verify [step ...]   (default: every step)
#         tabular-center-swift/tools/verify --list
# Steps:  swift-format-config swift-macro-support swift-matrix-stable swift
#         swift-compile-fail swift-conformance swift-examples swift-codegen
#         swift-macros swift-standalone (+ swift-render)
#
# Steps are declared once, in the arrays below; `--list` prints them for the
# root. Each step's output is teed into one ledger, every skip is reprinted
# before the verdict, and failed steps are named again at the end. Why each
# step is built as it is: ARCHITECTURE.md 16, "The checks, step by step".
set -uo pipefail

cd "$(dirname "$0")/../.." || exit 1

fail=0
failed_steps=()

require_dir() {
    [ -d "$1" ] && return 0
    echo "missing directory: $1"
    echo
    echo "  If this is a nix build and the directory exists in your working"
    echo "  tree, it is probably untracked: nix excludes untracked files from a"
    echo "  dirty tree. Commit it, or 'git add -A', or apply patches with"
    echo "  'git am' rather than 'git apply'."
    return 1
}

RENDERINGS="grid mmd lint cov"

require_fixtures() {
    local missing="" tbl name
    for tbl in spec/conformance/*.tbl; do
        [ -e "$tbl" ] || continue
        name="$(basename "$tbl" .tbl)"
        [ -f "spec/conformance/traces/$name.trace" ] \
            || missing="$missing traces/$name.trace"
    done
    if [ -z "$(echo spec/conformance/*.tbl)" ] || [ ! -e spec/conformance/timer.tbl ]; then
        echo "spec/conformance has no fixtures; the contract has evaporated"
        return 1
    fi
    [ -z "$missing" ] && return 0

    echo "fixture(s) missing a trace:"
    for f in $missing; do echo "  $f"; done
    echo
    echo '  .tbl and .trace are authored by hand: they are the contract.'
    echo "  If they exist in your working tree, they are probably untracked --"
    echo "  nix excludes untracked files from a dirty tree, so 'git apply'"
    echo "  leaves new files out of the build. 'git add -A', or use 'git am'."
    return 1
}

offline() { [ -n "${TABULAR_CENTER_OFFLINE:-}" ]; }

TALLY="$(mktemp)"
trap 'rm -f "$TALLY"' EXIT

run() {
    local name="$1"; shift
    printf '\n\033[1m== %s ==\033[0m\n' "$name"
    "$@" 2>&1 | tee -a "$TALLY"
    local rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] && return 0
    echo "FAILED: $name"
    failed_steps+=("$name")
    fail=1
}

SWIFT="${SWIFT:-swift}"
SWIFTC="${SWIFTC:-swiftc}"

swift_available() { command -v "$SWIFT" >/dev/null 2>&1; }

swift_home() {
    local scratch="$1"
    export HOME="${HOME:-$scratch/home}"
    [ -w "$HOME" ] || export HOME="$scratch/home"
    mkdir -p "$HOME"
}

swift_paths() {
    local scratch="$1"
    printf '%s' "--scratch-path $scratch/build --cache-path $scratch/cache \
--config-path $scratch/config --security-path $scratch/security"
}

step_swift_macro_support() {
    if ! command -v "$SWIFT" >/dev/null 2>&1; then
        echo "skip swift-macro-support (\$SWIFT not found)"
        return 0
    fi

    local probe
    probe="$(mktemp -d)"
    mkdir -p "$probe/Sources/probe"
    : > "$probe/Sources/probe/probe.swift"
    cat > "$probe/Package.swift" <<'PROBE'
// swift-tools-version: 5.9
import CompilerPluginSupport
import PackageDescription

let package = Package(
    name: "probe",
    targets: [.target(name: "probe")]
)
PROBE

    local out
    out="$( (cd "$probe" && "$SWIFT" package dump-package 2>&1) )"
    local rc=$?
    rm -rf "$probe"

    local api
    api="$(printf '%s' "$out" | sed -n 's|.*"-I", "\([^"]*ManifestAPI\)".*|\1|p' | head -1)"
    [ -n "$api" ] && echo "note: manifest API: $api"

    if [ "$rc" -eq 0 ]; then
        echo "ok   CompilerPluginSupport is available"
        echo "     The .macro target can be restored: see tabular-center-swift/macros/Package.swift"
        echo "     and pending/Machine.swift. PLAN 0e covers what that unblocks."
        return 0
    fi

    case "$out" in
        *"macros are not supported in this compiler"*)
            echo "skip swift-macros (this swiftc is built without macro support:"
            echo "     'macros are not supported in this compiler'. SwiftPM can"
            echo "     now declare a .macro target -- see"
            echo "     tabular-center-swift/nix/swiftpm-plugin-support.nix -- but the compiler cannot"
            echo "     compile a macro declaration. pending/ holds both files.)"
            return 0
            ;;
        *"no such module 'CompilerPluginSupport'"*)
            case "$api" in
                *plugin-support*)
                    echo "FAIL the augmented SwiftPM is in use and the module is"
                    echo "     still missing: $api"
                    echo "     nix build .#swiftpm-plugin-support, then check"
                    echo "     result/lib/swift/pm/ManifestAPI"
                    return 1
                    ;;
            esac
            echo "skip swift-macro-support (this SwiftPM does not ship"
            echo "     CompilerPluginSupport, so no .macro target can be declared."
            echo "     $("$SWIFT" --version 2>/dev/null | head -1))"
            return 0
            ;;
    esac

    echo "FAIL swift-macro-support -- the probe failed for an unexpected reason"
    printf '%s\n' "$out" | head -5 | sed 's/^/       /'
    return 1
}

step_swift() {
    if ! swift_available; then
        echo "skip swift (\$SWIFT not found; nix develop .#swift provides it)"
        return 0
    fi
    require_dir tabular-center-swift || return 1
    echo "note: $(command -v "$SWIFTC")"
    "$SWIFT" --version 2>&1 | head -1 | sed 's/^/note: /'

    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local out rc
    local info extra
    info="$("$SWIFTC" -print-target-info 2>/dev/null || true)"
    extra="$(printf '%s' "$info" | jq -r '
        [ (.paths.runtimeLibraryPaths // [])[],
          (.paths.runtimeLibraryImportPaths // [])[],
          (.paths.runtimeResourcePath // empty) ] | .[]' 2>/dev/null || true)"
    local d
    while IFS= read -r d; do
        [ -n "$d" ] && [ -d "$d" ] && \
            export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$d"
    done <<< "$extra"

    local found=""
    local dir
    IFS=':' read -ra __dirs <<< "${LD_LIBRARY_PATH:-}"
    for dir in "${__dirs[@]}"; do
        [ -n "$dir" ] && [ -e "$dir/libdispatch.so" ] && { found="$dir"; break; }
    done
    if [ -z "$found" ]; then
        local resource hit
        resource="$(printf '%s' "$info" | jq -r '.paths.runtimeResourcePath // empty' 2>/dev/null || true)"
        for dir in "$resource" "${resource%/*}" "${resource%/*/*}"; do
            [ -n "$dir" ] && [ -d "$dir" ] || continue
            hit="$(find "$dir" -maxdepth 4 -name libdispatch.so -print -quit 2>/dev/null || true)"
            if [ -n "$hit" ]; then
                found="$(dirname "$hit")"
                export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$found"
                break
            fi
        done
    fi

    if [ -n "$found" ]; then
        echo "note: swift runtime at $found"
    else
        echo "note: libdispatch.so is not on LD_LIBRARY_PATH, and was not found"
        echo "      under the toolchain's resource path either. On nixpkgs the"
        echo "      corelibs are separate derivations from the swift wrapper;"
        echo "      see swiftCorelibs in tabular-center-swift/nix/context.nix."
    fi

    # shellcheck disable=SC2046  # word splitting is what swift_paths is for
    out="$( (cd tabular-center-swift && "$SWIFT" run -c release $(swift_paths "$scratch") tabular-center-check) 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    rm -rf "$scratch"

    if grep -q "could not find module .* for target" <<<"$out"; then
        echo
        echo "  This is a target-triple mismatch, not a missing module."
        echo "  See the note on swiftPkgs in tabular-center-swift/nix/context.nix, and ARCHITECTURE"
        echo "  section 13 on nixpkgs' Linux Swift being best-effort."
    fi
    if grep -q "cannot open shared object file" <<<"$out"; then
        echo
        echo "  The build succeeded; only the loader failed. See the note"
        echo "  above: if libdispatch.so was not found, LD_LIBRARY_PATH is the"
        echo "  thing to fix, and inside 'nix develop .#swift' it is set for"
        echo "  you by tabular-center-swift/nix/context.nix."
    fi
    return "$rc"
}

step_swift_macros() {
    if ! swift_available; then
        echo "skip swift-macros (\$SWIFT not found)"
        return 0
    fi
    require_dir tabular-center-swift/macros || return 1

    local args=(build)
    if [ "$(uname -s)" = Darwin ]; then
        args+=(--disable-get-task-allow-entitlement)
    fi
    if [ -n "${TABULAR_CENTER_SWIFT_DEPS:-}" ]; then
        echo "note: resolving offline from $TABULAR_CENTER_SWIFT_DEPS"
        rm -rf tabular-center-swift/macros/.build/checkouts tabular-center-swift/macros/.build/workspace-state.json
        mkdir -p tabular-center-swift/macros/.build
        cp -r "$TABULAR_CENTER_SWIFT_DEPS/checkouts" tabular-center-swift/macros/.build/checkouts
        cp "$TABULAR_CENTER_SWIFT_DEPS/workspace-state.json" tabular-center-swift/macros/.build/
        chmod -R u+w tabular-center-swift/macros/.build
        args+=(--disable-automatic-resolution)
    fi

    local out
    out="$( (cd tabular-center-swift/macros && "$SWIFT" "${args[@]}" 2>&1) )"
    if [ $? -eq 0 ]; then
        printf '%s\n' "$out" | grep -v "skipping cache due to an error" \
            | grep -v "Cloning into bare repository" \
            | grep -v "unable to access 'https://github.com" \
            | grep -v "^tabular-center-check.*Fetching https://" \
            | grep -v "is not accessible or not writable, disabling user-level cache"
        echo "ok   swift macros"
        (cd tabular-center-swift/macros && "$SWIFT" run "${args[@]:1}" TabularCenterMacroSyntaxCheck) || return 1
        return 0
    fi

    case "$out" in
        *"no such module 'CompilerPluginSupport'"*)
            printf '%s\n' "$out"
            echo "FAILED: this SwiftPM does not ship CompilerPluginSupport."
            echo "        The manifest needs it for its .macro target."
            echo "        Which SwiftPM is in use:"
            printf '%s' "$out" | sed -n 's|.*"-I", "\([^"]*ManifestAPI\)".*|          \1|p' | head -1
            echo "        If that is not *-plugin-support-*, the shell predates"
            echo "        it: leave and re-enter 'nix develop'. If it is, run"
            echo "        ./tools/verify swift-macro-support for the detail."
            return 1
            ;;
        *".swift:"*"error:"*)
            printf '%s\n' "$out" | grep -E "\.swift:[0-9]+:[0-9]+: error:" -A2 \
                | head -20
            echo "FAILED: swift-macros -- compile error, see above"
            return 1
            ;;
        *"Network is unreachable"*|*"Could not resolve"*|*"failed to resolve"*|*"fatal: unable to access"*)
            if [ -n "${TABULAR_CENTER_SWIFT_DEPS:-}" ]; then
                printf '%s\n' "$out"
                echo "FAILED: swift-macros reached the network despite a locked"
                echo "        checkout set. Re-lock: nix run .#swift-lock"
                return 1
            fi
            echo "skip swift-macros (swift-syntax is remote, this run is offline,"
            echo "     and no locked checkout set was supplied: run"
            echo "     'nix run .#swift-lock' with network and commit"
            echo "     tabular-center-swift/nix/swift-lock.json)"
            return 0
            ;;
    esac

    printf '%s\n' "$out"
    echo "FAILED: swift-macros"
    return 1
}

step_swift_examples() {
    if ! swift_available; then
        echo "skip swift-examples (\$SWIFT not found)"
        return 0
    fi
    require_dir tabular-center-swift/examples || return 1

    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local out rc=0 one ex failed=() replay=""
    for ex in traffic-light timer retry login observable-counter spec-check; do
        # shellcheck disable=SC2046
        out="$( (cd tabular-center-swift/examples && "$SWIFT" run -c release \
            $(swift_paths "$scratch") "$ex") 2>&1 )"
        one=$?
        printf '%s\n' "$out"
        if [ "$one" -ne 0 ]; then
            rc=1
            failed+=("$ex (exit $one)")
            echo "FAIL swift example $ex exited $one"
            replay+="--- $ex, last lines ---"$'\n'"$(printf '%s\n' "$out" | tail -n 12)"$'\n'

        fi
    done
    rm -rf "$scratch"

    if [ "$rc" -ne 0 ]; then
        printf '%s' "$replay"
        echo "swift-examples: ${#failed[@]} failed: ${failed[*]}"
    fi
    return "$rc"
}

step_swift_codegen() {
    if ! swift_available; then
        echo "skip swift-codegen (\$SWIFT not found)"
        return 0
    fi
    require_dir tabular-center-swift || return 1

    local scratch out rc gen
    scratch="$(mktemp -d)"
    swift_home "$scratch"
    gen="$scratch/emitted"

    # shellcheck disable=SC2046
    out="$( (cd tabular-center-swift && "$SWIFT" run -c release $(swift_paths "$scratch") \
        tabular-center-codegen-check "--emit=$gen") 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    if [ "$rc" -ne 0 ]; then rm -rf "$scratch"; return "$rc"; fi

    local build bin modules
    # shellcheck disable=SC2046
    build="$( (cd tabular-center-swift && "$SWIFT" build -c release $(swift_paths "$scratch")) 2>&1 )" || {
        echo "the package failed to build:"
        printf '%s\n' "$build" | tail -20
        rm -rf "$scratch"
        return 1
    }
    # shellcheck disable=SC2046
    bin="$( (cd tabular-center-swift && "$SWIFT" build -c release $(swift_paths "$scratch") \
        --show-bin-path) 2>/dev/null )"
    modules="$bin/Modules"
    [ -d "$modules" ] || modules="$bin"

    local sup=tabular-center-swift/codegen-support m f exp err bad=0
    local emitted=( "$gen"/*.emitted.swift )
    if [ ! -e "${emitted[0]}" ]; then
        echo "FAIL the check emitted nothing to $gen"
        rm -rf "$scratch"
        return 1
    fi
    if err="$("$SWIFTC" -typecheck -I "$modules" "$sup/Types.swift" "${emitted[@]}" \
        "$sup"/complete/*.swift 2>&1)"; then
        echo "ok   ${#emitted[@]} emitted machines compile in one module, with complete implementations"
    else
        echo "FAIL the emitted machines and complete implementations do not compile together"
        printf '%s\n' "$err" | grep -E "error:" | head -8 | sed 's/^/       /'
        bad=1
    fi

    local extra
    for f in "$sup"/compile_fail/*.swift; do
        m="$(basename "$f" .swift)"
        m="${m%%_*}"
        extra=()
        [ -f "$gen/refused/$m.emitted.swift" ] && extra=("$gen/refused/$m.emitted.swift")
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        err="$("$SWIFTC" -typecheck -I "$modules" "$sup/Types.swift" "${emitted[@]}" \
            ${extra[@]+"${extra[@]}"} "$f" 2>&1)"; rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif grep -qF -- "$exp" <<<"$err"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | grep -E "error:" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$scratch"
    return "$bad"
}

step_swift_conformance() {
    if ! swift_available; then
        echo "skip swift-conformance (\$SWIFT not found)"
        return 0
    fi
    require_fixtures || return 1
    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local out rc
    # shellcheck disable=SC2046
    out="$( (cd tabular-center-swift && "$SWIFT" run -c release $(swift_paths "$scratch") \
        tabular-center-conformance ../spec/conformance) 2>&1 )"
    rc=$?
    printf '%s\n' "$out"
    rm -rf "$scratch"
    return "$rc"
}

step_swift_compile_fail() {
    if ! swift_available; then
        echo "skip swift-compile-fail (\$SWIFT not found)"
        return 0
    fi

    local scratch
    scratch="$(mktemp -d)"
    swift_home "$scratch"

    local build
    # shellcheck disable=SC2046
    build="$( (cd tabular-center-swift && "$SWIFT" build -c release $(swift_paths "$scratch")) 2>&1 )" || {
        echo "the package failed to build:"
        printf '%s\n' "$build" | tail -20
        rm -rf "$scratch"
        return 1
    }

    local bin modules
    # shellcheck disable=SC2046
    bin="$( (cd tabular-center-swift && "$SWIFT" build -c release $(swift_paths "$scratch") \
        --show-bin-path) 2>/dev/null )"
    modules="$bin/Modules"
    [ -d "$modules" ] || modules="$bin"
    if [ ! -d "$modules" ]; then
        echo "could not locate the built module directory (bin path: ${bin:-none})"
        rm -rf "$scratch"
        return 1
    fi

    local bad=0 f exp err rc
    for f in tabular-center-swift/compile_fail/*.swift; do
        exp="$(sed -n 's|^//~ EXPECT: ||p' "$f" | head -1)"
        err="$("$SWIFTC" -typecheck -I "$modules" "$f" 2>&1)"; rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "FAIL $(basename "$f") -- compiled, but was expected to fail"
            bad=1
        elif grep -qF -- "$exp" <<<"$err"; then
            echo "ok   $(basename "$f")"
        else
            echo "FAIL $(basename "$f")"
            echo "     expected: $exp"
            printf '%s\n' "$err" | grep -E "error:" | head -3 | sed 's/^/       /'
            bad=1
        fi
    done

    rm -rf "$scratch"
    return "$bad"
}

step_swift_matrix_stable() {
    if ! command -v swift-format >/dev/null 2>&1; then
        echo "skip swift-matrix-stable (swift-format not found)"
        return 0
    fi

    local scratch f n=0 bad=0
    scratch="$(mktemp -d)"

    printf 'let probe   =    1\n' > "$scratch/probe.swift"
    swift-format format --in-place "$scratch/probe.swift" 2>/dev/null
    if [ "$(cat "$scratch/probe.swift")" = "let probe   =    1" ]; then
        echo "FAIL swift-format left a deliberately misformatted file alone,"
        echo "     so this check cannot tell whether it ran at all. Check the"
        echo "     invocation before trusting any pass below."
        rm -rf "$scratch"
        return 1
    fi

    while IFS= read -r f; do
        [ -n "$f" ] || continue
        n=$((n + 1))
        cp "$f" "$scratch/subject.swift"
        if ! swift-format format --in-place "$scratch/subject.swift" 2>"$scratch/err"; then
            echo "FAIL swift-format could not read $f"
            sed 's/^/       /' "$scratch/err"
            bad=1
            continue
        fi
        if diff -q "$f" "$scratch/subject.swift" >/dev/null; then
            echo "ok   $f"
        else
            echo "FAIL swift-format changed $f"
            diff "$f" "$scratch/subject.swift" | head -8 | sed 's/^/       /'
            echo "     Its rows are a grid. Check that"
            echo "     \`// swift-format-ignore-file\` is still the first line."
            bad=1
        fi
    done < <(find . -name '*.tb.swift' -not -path './.git/*' -not -path '*/.build/*' | sort)

    if [ "$n" -eq 0 ]; then
        echo "FAIL no .tb.swift found; this scan checked nothing"
        bad=1
    elif [ "$bad" -eq 0 ]; then
        echo "ok   $n Swift matrices survive swift-format"
    fi
    rm -rf "$scratch"
    return "$bad"
}

step_swift_format_config() {
    local cfg found=0 bad=0
    while IFS= read -r cfg; do
        found=$((found + 1))
        if grep -q "tb.swift" "$cfg"; then
            echo "ok   $cfg mentions .tb.swift"
        else
            echo "FAIL $cfg does not mention .tb.swift"
            echo "     A swift-format config now exists, so something formats"
            echo "     Swift here. Matrix files are column-aligned on purpose"
            echo "     and must be excluded from its input -- see"
            echo "     spec/matrix-files.md -- and then swift-matrix-stable"
            echo "     needs writing to prove the exclusion holds."
            bad=1
        fi
    done < <(find . \( -name '.swift-format' -o -name '.swift-format.json' \) \
        -not -path './.git/*' -not -path '*/.build/*' | sort)

    if [ "$found" -eq 0 ]; then
        echo "ok   no swift-format config; nothing formats Swift here yet"
    fi

    local f n=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        n=$((n + 1))
        if ! grep -qx "// swift-format-ignore-file" "$f"; then
            echo "FAIL $f has no \`// swift-format-ignore-file\`"
            echo "     Its rows are column-aligned on purpose, and that"
            echo "     directive is swift-format's only per-file exemption."
            echo "     See spec/matrix-files.md."
            bad=1
        fi
    done < <(find . -name '*.tb.swift' -not -path './.git/*' -not -path '*/.build/*' | sort)

    if [ "$n" -eq 0 ]; then
        echo "FAIL no .tb.swift found; this scan checked nothing"
        bad=1
    elif [ "$bad" -eq 0 ]; then
        echo "ok   $n .tb.swift files carry swift-format's ignore directive"
    fi
    return "$bad"
}

step_swift_render() {
    [ -n "${TABULAR_CENTER_RENDER_DIR:-}" ] || {
        echo "swift-render: TABULAR_CENTER_RENDER_DIR is not set; the root's renderings-agree sets it"
        return 2
    }
    require_fixtures || return 1
    if swift_available; then
        local sw
        sw="$(mktemp -d)"
        swift_home "$sw"
        # shellcheck disable=SC2046
        if (cd tabular-center-swift && "$SWIFT" run -c release $(swift_paths "$sw") \
            tabular-center-conformance ../spec/conformance "--emit=$TABULAR_CENTER_RENDER_DIR") >/dev/null 2>&1; then
            rm -rf "$sw"
            return 0
        fi
        rm -rf "$sw"
        return 1
    fi
    echo "skip renderings-agree (swift: \$SWIFT not found)"
}

step_swift_standalone() {
    if ! swift_available; then
        echo "skip swift-standalone (\$SWIFT not found; nix develop .#swift provides it)"
        return 0
    fi
    require_dir tabular-center-swift || return 1

    local scratch alone out rc
    scratch="$(mktemp -d)"
    swift_home "$scratch"
    alone="$scratch/mirror/tabular-center-swift"
    mkdir -p "$scratch/mirror"
    cp -R tabular-center-swift "$alone"
    rm -rf "$alone/.build"

    # shellcheck disable=SC2046
    out="$( (cd "$alone" && "$SWIFT" build -c release $(swift_paths "$scratch")) 2>&1 )"
    rc=$?
    printf '%s\n' "$out" | tail -15
    rm -rf "$scratch"
    if [ "$rc" -ne 0 ]; then
        echo "FAIL swift-standalone -- the package does not build without the rest of"
        echo "     the repository, which is all a mirror clone has"
        return 1
    fi
    echo "ok   tabular-center-swift builds alone, as the mirror will hold it"
}

STEPS_DEFAULT=(swift-format-config swift-macro-support swift-matrix-stable swift swift-compile-fail swift-conformance swift-examples swift-codegen swift-macros swift-standalone)
STEPS_EXTRA=(swift-render)

case "${1:-}" in
    --list) printf '%s\n' "${STEPS_DEFAULT[@]}"; exit 0 ;;
    --list-all) printf '%s\n' "${STEPS_DEFAULT[@]}" "${STEPS_EXTRA[@]}"; exit 0 ;;
esac

steps=("$@")
[ ${#steps[@]} -eq 0 ] && steps=("${STEPS_DEFAULT[@]}")

for s in "${steps[@]}"; do
    case "$s" in
        swift-format-config) run swift-format-config step_swift_format_config ;;
        swift-macro-support) run swift-macro-support step_swift_macro_support ;;
        swift-matrix-stable) run swift-matrix-stable step_swift_matrix_stable ;;
        swift)               run swift               step_swift ;;
        swift-standalone)    run swift-standalone    step_swift_standalone ;;
        swift-compile-fail)  run swift-compile-fail  step_swift_compile_fail ;;
        swift-conformance)   run swift-conformance   step_swift_conformance ;;
        swift-examples)      run swift-examples      step_swift_examples ;;
        swift-codegen)       run swift-codegen       step_swift_codegen ;;
        swift-macros)        run swift-macros        step_swift_macros ;;
        swift-render)        run swift-render        step_swift_render ;;
        *) echo "unknown step: $s (Swift steps only; the root tools/verify knows them all)"; exit 2 ;;
    esac
done

echo

[ -n "${TABULAR_CENTER_NESTED:-}" ] && exit "$fail"

if grep -q '^[[:space:]]*skip ' "$TALLY"; then
    echo "verify: skipped ---------------------------------------------"
    grep '^[[:space:]]*skip ' "$TALLY" | sed 's/^[[:space:]]*/  /'
    echo "------------------------------------------------------------"
    echo
fi

if [ "$fail" -eq 0 ]; then
    echo "verify: all green"
else
    echo "verify: FAILED ----------------------------------------------"
    printf '  %s\n' "${failed_steps[@]}"
    echo "------------------------------------------------------------"
fi
exit "$fail"
