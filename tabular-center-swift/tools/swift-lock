#!/usr/bin/env bash
# Record tabular-center-swift/macros' SwiftPM dependencies, with URLs and hashes.
#
#   nix run .#swift-lock            regenerate nix/swift-lock.json
#   nix run .#swift-lock -- --check verify the committed lock is current
#
# NEEDS NETWORK, and is the second of exactly two commands in the repository
# that do. The first is `tools/gradle-lock`; this is the same idea against a
# different package manager, and deliberately the same shape so that reading
# one teaches you the other.
#
# Why the macro package needs this at all: `tabular-center-swift/macros` is the only thing
# here that links swift-syntax, which is a remote SwiftPM package. Every other
# Swift target builds offline, which is exactly why the macro lives in its own
# package (PLAN, "TabularCenterMacros -- decided: a separate package").
#
# ## Why not let SwiftPM fetch inside the build
#
# Same answer as Maven, arrived at the same way. A fixed-output derivation that
# runs SwiftPM in a sandbox asks a program with its own network stack, its own
# TLS trust, and its own cache layout to be reproducible, and reports every one
# of those failing as a resolution error. `Package.resolved` already pins a
# revision; from a revision the artifact is one URL, and from one URL nix's own
# fetcher does the rest with a hash it can verify.
#
# ## How the URL is recovered
#
# GitHub serves any revision as a tarball at
# `<repo>/archive/<revision>.tar.gz`, so the pin in `Package.resolved` IS the
# URL once the `.git` suffix is dropped. No cache archaeology, unlike the
# Gradle side -- SwiftPM writes the pin down as a matter of course.
#
# The sha256 is taken from the bytes that arrive. A wrong URL cannot record a
# right hash, which is what makes this checkable rather than merely plausible.
#
# It is the hash of the TARBALL, not of the unpacked tree, which constrains the
# other side: `nix/swift-deps.nix` must use `fetchurl` and untar itself.
# `fetchzip` would be the obvious choice and hashes the extracted NAR instead,
# so it reports a mismatch between two hashes that are both correct. The
# tarball hash is the one to record here, because `sha256sum` is available on
# any machine and `nix hash` is not.
set -uo pipefail

cd "$(dirname "$0")/../.." || exit 1

LOCK="tabular-center-swift/nix/swift-lock.json"
PKG="tabular-center-swift/macros"

check=0
[ "${1:-}" = "--check" ] && check=1

for tool in swift swiftc curl sha256sum jq; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "swift-lock: $tool is required and not on PATH"
        exit 2
    }
done

# Name the compiler for SwiftPM rather than letting it search.
#
# SwiftPM finds `swiftc` by its own toolchain discovery, not simply the first
# one on PATH, and `nix develop` ADDS to the host's PATH rather than replacing
# it. GitHub's Ubuntu image ships a Swift of its own. On CI, SwiftPM got an
# empty answer from `swiftc -print-target-info` while ours, asked directly,
# answered correctly -- and the same shell passed on a machine with no second
# Swift. A foreign swiftc running under this shell's LD_LIBRARY_PATH (nix's
# Swift 5.10 runtime) is the likeliest way to print nothing. SWIFT_EXEC is
# SwiftPM's own override for exactly this choice.
SWIFT_EXEC="$(command -v swiftc)"
export SWIFT_EXEC
echo "swiftc $SWIFT_EXEC"

echo "== resolving (this reaches the network) =="
if ! (cd "$PKG" && swift package resolve); then
    echo
    # SwiftPM swallows the compiler's stderr when target-info comes back empty
    # and reports "malformed json" instead. Ask directly, so a broken
    # toolchain environment shows its own error rather than SwiftPM's.
    echo "every swiftc on PATH (SwiftPM was told $SWIFT_EXEC):"
    type -a swiftc 2>/dev/null | sed 's/^/  /'
    echo "swiftc -print-target-info, asked directly:"
    swiftc -print-target-info 2>&1 | sed 's/^/  /' | head -20
    echo
    echo "swift-lock: resolution failed, so there is nothing to lock."
    echo "  This command needs network. Inside a nix build you do not have it;"
    echo "  run it on a machine that does and commit the result."
    exit 1
fi

resolved="$PKG/Package.resolved"
[ -f "$resolved" ] || { echo "swift-lock: no $resolved after resolve"; exit 1; }

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# `pins` in v2, `object.pins` in v1. Both spellings, because the file's
# version follows the toolchain and a lock generator that only understands the
# toolchain it was written on is a lock generator that breaks on upgrade.
pins="$(jq -c '(.pins // .object.pins)[]' "$resolved" 2>/dev/null)"
[ -n "$pins" ] || { echo "swift-lock: could not read pins from $resolved"; exit 1; }

echo
echo "== recovering URLs =="

entries=""
count=0

while IFS= read -r pin; do
    [ -n "$pin" ] || continue
    identity="$(printf '%s' "$pin" | jq -r '.identity')"
    location="$(printf '%s' "$pin" | jq -r '.location // .repositoryURL')"
    revision="$(printf '%s' "$pin" | jq -r '.state.revision')"
    version="$(printf '%s' "$pin" | jq -r '.state.version // ""')"

    repo="${location%.git}"
    url="$repo/archive/$revision.tar.gz"

    if ! curl -fsSL --max-time 120 -o "$scratch/dl" "$url"; then
        echo "swift-lock: could not fetch $url"
        echo "  Only git hosts that serve /archive/<rev>.tar.gz are supported."
        echo "  A dependency somewhere else needs a case added here rather"
        echo "  than a hand-edited lock."
        exit 1
    fi
    sha="$(sha256sum "$scratch/dl" | cut -d' ' -f1)"

    entries="$entries    { \"identity\": \"$identity\", \"location\": \"$location\","$'\n'
    entries="$entries      \"revision\": \"$revision\", \"version\": \"$version\","$'\n'
    entries="$entries      \"url\": \"$url\", \"sha256\": \"$sha\" },"$'\n'
    count=$((count + 1))
    printf '  %s %s\n' "$identity" "${version:-$revision}"
done <<< "$pins"

swift_version="$(swift --version 2>/dev/null | head -1)"

generated="$scratch/lock.json"
{
    echo '{'
    echo '  "comment": "Generated by tools/swift-lock. Do not edit. See nix/swift-deps.nix.",'
    echo '  "schema": 1,'
    echo "  \"swift\": \"$swift_version\","
    echo '  "dependencies": ['
    printf '%s' "$entries" | sed '$ s/,$//'
    echo '  ]'
    echo '}'
} > "$generated"

if [ "$check" -eq 1 ]; then
    if [ ! -f "$LOCK" ]; then
        echo; echo "swift-lock: $LOCK does not exist; run 'nix run .#swift-lock'"
        exit 1
    fi
    if diff -u "$LOCK" "$generated"; then
        echo; echo "ok   $LOCK is current ($count dependencies)"
        exit 0
    fi
    echo; echo "swift-lock: $LOCK is stale; run 'nix run .#swift-lock'"
    exit 1
fi

mkdir -p "$(dirname "$LOCK")"
cp "$generated" "$LOCK"
echo
echo "wrote $LOCK ($count dependencies)"
echo
echo "Next: commit it, together with $resolved -- the lock records what that"
echo "file pins, and the two are only meaningful as a pair."
