# Editor settings for every file, and the one exemption the matrix files
# need: ktlint must not realign or wrap a `*.tb.kt` matrix, whose columns are
# the point (spec/matrix-files.md; ARCHITECTURE.md 16).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,kt,kts,swift,nix,json,md,yml,yaml,toml}]
indent_size = 4

[*.{nix,json,yml,yaml,toml,md}]
indent_size = 2

[*.tb.kt]
max_line_length = off
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_annotation = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_indent = disabled

[*.md]
trim_trailing_whitespace = false
