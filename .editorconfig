root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,kt,kts,swift,nix,json,md,yml,yaml,toml}]
indent_size = 4

[*.{nix,json,yml,yaml,toml,md}]
indent_size = 2

# The matrix declarations are column-aligned on purpose: a hole in the table
# should be visible to a human reviewer before the compiler ever runs.
# Alignment rules must not reformat them.
#
# Scoped to `*.tb.kt` and nothing else. This used to disable the same rules for
# every `.kt` file in the project, which protected the few holding matrices by
# giving up formatting on all the ordinary code -- a wide exemption for a
# narrow problem. See spec/matrix-files.md.
[*.tb.kt]
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_annotation = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_indent = disabled

[*.md]
trim_trailing_whitespace = false
